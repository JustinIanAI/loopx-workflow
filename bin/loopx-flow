#!/usr/bin/env bash
# ==============================================================================
# loopx-flow: LoopX AI-Native 研发与交付流场景化命令编排器 (v2.0)
# 核心场景：Feature 资产胶囊开发、Issue 缺陷自适应修复、断点审批与质量收据融合
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
REGISTRY_FLAG=""
if [[ -f "$PROJECT_ROOT/.loopx/registry.json" ]]; then
    REGISTRY_FLAG="--registry $PROJECT_ROOT/.loopx/registry.json"
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m' # No Color

usage() {
    cat << 'USAGETXT'
===============================================================================
  LoopX AI-Native Flow Orchestrator (loopx-flow v2.0)
===============================================================================

用法:
  loopx-flow <command> [arguments...]

核心场景指令:
  feature <name>          开启新特性管线，生成 specs/features/<name> 资产包与 Goal (阶段 0~4)
  approve contract <name> 【断点 1】方案与契约审批，锁定 SHA256 契约基线并放行 TDD 编码
  check [--with-ocr]      执行四大硬门禁与代码审查，生成并校验 LoopX change-quality 严格收据
  pr <action> [feature]   按 PR #7545 官方标准从胶囊生成 4-Part 描述并提交/预览/更新 PR (create|preview|update|ready)
  review <pr_id>          执行 L2 交付审查并顶置 LoopX 原生五段式评审报告（复用 pr-review review_template）
  respond <pr_id>         复用 LoopX 原生五段式格式提交针对 Review findings 的逐项闭环汇报
  merge <pr_id> [feature] 【断点 2】按 authorization_mode 核验 Mode A/B 授权与 readiness，Squash 合入并原子归档
  release-approve <pr>    【断点 2 / Mode B】single_owner 发布授权：TTY 确认 + principal==accepted_by，写结构化 PR 评论
  issue <issue_id>        GitHub Issue 缺陷智能分流 (LoopX issue-fix feasibility 因果路由: fix_pr | comment_only | triage_only)
  integrate [--execute|--status]  LoopX 集成分支本地预集成 (默认 preview 不落盘)
  context <feature>       生成当前特性的长程上下文胶囊，供开发者与 AI Agent 快速穿透审阅
  archive <feature>       原子归档已合入特性的资产包 (specs/features/ -> specs/archive/)
  gate verify <stage> <f> 阶段流转物理熔断守卫 (decisions | contract)
  doctor                  前置环境与 LoopX 就绪度全维评分 (preflight + loopx doctor)
  init                    初始化项目工作流骨架、依赖及本地 LoopX 连接
  status                  查看当前 Goal 进度、任务看板与注意力队列 (loopx status)
  status --next [feature] 只读投影 + 下一步建议（不写 Goal/Todo/Lease/Gate，不是 resume）
  todo list [goal_id]     列出指定或当前 Goal 下的全部 Agent / User Todos
  todo claim <tid>        申领指定 Todo 的排他租约 (register-agent + task-lease acquire --owner --idempotency-key)
  todo done <tid>         标记任务完成并释放排他租约 (loopx todo --status done + task-lease release --expected-version)
  help, --help, -h        显示本帮助信息

USAGETXT
}

# 控制面一致性 + GitHub API 预算基线检查（环境治理，见 ADR-0007）
# 只做「诊断 + 可执行修复指令」，不在此处硬阻断（doctor 是阶段 0 体检，不是交付门禁）。
cmd_doctor_control_plane() {
    local fail=0
    echo -e "\n${BLUE}==> [2/3] 控制面一致性检查 (runtime route / registry / 运行时工件)...${NC}"

    # 1. runtime root 路由与项目 registry 声明是否一致
    local route_json runtime_root declared_root
    route_json="$(loopx --format json status 2>/dev/null || echo '{}')"
    runtime_root="$(node -e '
const firstJson=(s)=>{let depth=0,inStr=false,esc=false;for(let i=0;i<s.length;i++){const c=s[i];if(inStr){if(esc){esc=false}else if(c==="\\"){esc=true}else if(c==="\""){inStr=false}continue}if(c==="\""){inStr=true;continue}if(c==="{"){depth++}else if(c==="}"){depth--;if(depth===0)return s.slice(0,i+1)}}return null};
let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{let out="";try{out=JSON.parse(d).runtime_root||""}catch(_){const j=firstJson(d);if(j){try{out=JSON.parse(j).runtime_root||""}catch(__){}}}process.stdout.write(out)})' <<< "$route_json")"
    declared_root="$(node -e '
const fs=require("fs");
try{const r=JSON.parse(fs.readFileSync(".loopx/registry.json","utf8"));process.stdout.write(r.common_runtime_root||"")}catch(_){}
' 2>/dev/null)"
    if [[ -n "$runtime_root" && -n "$declared_root" && "$runtime_root" != "$declared_root" ]]; then
        echo -e "${YELLOW}[WARN] runtime root 不一致: 生效=$runtime_root 项目声明=$declared_root${NC}"
        echo -e "       🛠️ 修复: loopx bootstrap --project . --goal-id <goal> 重新同步，或统一 registry 的 common_runtime_root"
        fail=1
    elif [[ -n "$runtime_root" ]]; then
        echo -e "${GREEN}[✓] runtime root 路由一致: $runtime_root${NC}"
    fi

    # 2. 目标路由 ~/.loopx 是否被半迁移残留占用（会阻塞 migrate-local-state）
    if [[ -d "$HOME/.loopx" ]]; then
        local residue_count
        residue_count="$(find "$HOME/.loopx" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')"
        if [[ ! -f "$HOME/.loopx/registry.global.json" && "$residue_count" -gt 0 ]]; then
            echo -e "${YELLOW}[WARN] ~/.loopx 存在半迁移残留（$residue_count 项，无 registry.global.json）→ 会阻塞 loopx migrate-local-state${NC}"
            echo -e "       🛠️ 修复: 先备份后移除残留（示例）: mkdir -p ~/.loopx-backup && mv ~/.loopx/* ~/.loopx-backup/ && rmdir ~/.loopx"
            fail=1
        fi
    fi

    # 3. registry 中缺 state_file 的畸形 goal 记录
    local bad_goals
    bad_goals="$(node -e '
const fs=require("fs"),os=require("os"),path=require("path");
const files=[".loopx/registry.json",path.join(os.homedir(),".loopx","registry.global.json"),path.join(os.homedir(),".codex","loopx","registry.global.json")];
const bad=[];
for(const f of files){try{const d=JSON.parse(fs.readFileSync(f,"utf8"));for(const g of (d.goals||[])){if(g&&g.id&&!g.state_file)bad.push(f+"#"+g.id)}}catch(_){}}
process.stdout.write([...new Set(bad)].join(" "))
' 2>/dev/null)"
    if [[ -n "$bad_goals" ]]; then
        echo -e "${YELLOW}[WARN] registry 存在缺 state_file 的 goal（会阻塞迁移/审批）: $bad_goals${NC}"
        echo -e "       🛠️ 修复: 补 state_file 指向 <project>/.codex/goals/<goal>/ACTIVE_GOAL_STATE.md，或 retire 该 goal"
        fail=1
    else
        echo -e "${GREEN}[✓] registry goal 记录完整（state_file 无缺失）${NC}"
    fi

    # 4. 运行时工件不得进入 Git 跟踪面（会污染 exact scope / 收据证据）
    local tracked_runtime
    tracked_runtime="$(git ls-files 2>/dev/null | grep -E '(\.codex/|\.loopx/[^/]*\.lock$|\.loopx/.*\.lock$)' | head -5 || true)"
    if [[ -n "$tracked_runtime" ]]; then
        echo -e "${YELLOW}[WARN] 运行时工件仍被 Git 跟踪（会进入 exact scope）:${NC}"
        echo "$tracked_runtime" | sed 's/^/         /'
        echo -e "       🛠️ 修复: git rm --cached <path> 并确认 .gitignore 覆盖"
        fail=1
    else
        echo -e "${GREEN}[✓] 运行时工件未被 Git 跟踪${NC}"
    fi

    echo -e "\n${BLUE}==> [3/3] GitHub API 预算基线检查 (官方上限 50% 安全基线)...${NC}"
    if ! command -v gh >/dev/null 2>&1; then
        echo -e "${YELLOW}[WARN] 未检测到 gh CLI，跳过 API 预算检查${NC}"
        return "$fail"
    fi
    local rl core_limit core_remaining content_hint
    rl="$(gh api rate_limit 2>/dev/null || echo '{}')"
    core_limit="$(node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{process.stdout.write(String(JSON.parse(d).resources.core.limit||0))}catch(_){}})' <<< "$rl")"
    core_remaining="$(node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{process.stdout.write(String(JSON.parse(d).resources.core.remaining||0))}catch(_){}})' <<< "$rl")"
    if [[ -z "$core_limit" || "$core_limit" == "0" ]]; then
        echo -e "${YELLOW}[WARN] gh api rate_limit 不可用（令牌失效/网络），无法评估 API 预算${NC}"
        return "$fail"
    fi
    local baseline=$(( core_limit / 2 ))
    echo -e "    core REST: limit=${core_limit}/h  remaining=${core_remaining}  → 50% 安全基线=${baseline}/h"
    echo -e "    secondary: ≤ 900 points/min（GET=1, POST/PATCH=5）、≤ 80 content/min、≤ 500 content/h"
    echo -e "    → 安全基线建议: ${baseline} req/h、450 points/min、40 content/min、250 content/h"
    if (( core_remaining < baseline )); then
        echo -e "${YELLOW}[WARN] 当前剩余额度已低于 50% 基线（remaining=${core_remaining} < ${baseline}），请降低评审频次或等待窗口重置${NC}"
        fail=1
    else
        echo -e "${GREEN}[✓] 当前额度高于 50% 安全基线${NC}"
    fi
    return "$fail"
}

doctor_branch_protection() {
    local mode="$1" script out
    script="$PROJECT_ROOT/scripts/setup-branch-protection.sh"
    if [[ ! -f "$script" ]]; then
        echo -e "${YELLOW}[WARN] 缺少分支保护检查脚本: $script${NC}"
        return 1
    fi
    if out="$(bash "$script" --check --mode "$mode" 2>&1)"; then
        echo -e "${GREEN}[✓] 分支保护与 authorization_mode=$mode 匹配${NC}"
        return 0
    fi
    echo -e "${YELLOW}[WARN] 分支保护未满足 authorization_mode=$mode: ${out:-<no output>}${NC}"
    echo -e "       🛠️ 修复指令: bash scripts/setup-branch-protection.sh --apply --mode $mode"
    return 1
}

doctor_authorization_config() {
    local f mode
    f="$(auth_config_path)"
    echo -e "\n${BLUE}==> [3/3] Gate 授权配置与交付基础设施检查 (ADR-0009 / ADR-0012)...${NC}"
    if [[ ! -f "$f" ]]; then
        echo -e "${YELLOW}[WARN] 未找到 $f：authorization_mode 尚未确认，Gate1/Gate2 授权路径不可用。${NC}"
        echo -e "       🛠️ 修复指令: loopx-flow init（需 TTY 确认 authorization_mode）"
        return 0
    fi
    auth_require_config
    mode="$(auth_mode)"
    echo -e "${GREEN}[✓] 授权配置合法: authorization_mode=$mode${NC}"
    # Gate1 上下文：CI/分支保护只 WARN，不阻断契约审批（ADR-0012 决策 5）
    doctor_branch_protection "$mode" || true
}

init_authorization_config() {
    local f mode choice accepted_by accepted_at confirm
    f="$(auth_config_path)"
    echo -e "\n${BLUE}==> Gate 授权模式确认 (REQ-AUTH-MODE-1，不静默默认)...${NC}"
    if [[ -f "$f" ]]; then
        auth_require_config
        echo -e "${GREEN}[✓] 授权配置已存在: $f (authorization_mode=$(auth_mode))${NC}"
        return 0
    fi
    if [[ ! -t 0 ]]; then
        echo -e "[-] [FAIL-CLOSED] 首次 init 必须在 TTY 下确认 authorization_mode；非 TTY 拒绝静默默认。" >&2
        exit 1
    fi
    echo "  1) independent  多账号：Draft PR 上第二 GitHub 账号 gate=1 评论（账号级分离）"
    echo "  2) single_owner 单人维护：TTY + 风险接受；Gate2 走 release-approve"
    read -r -p "选择 authorization_mode [1/2]: " choice
    case "$choice" in
        1) mode="independent" ;;
        2) mode="single_owner" ;;
        *) echo -e "[-] [FAIL-CLOSED] 无效选择: $choice" >&2; exit 1 ;;
    esac
    if [[ "$mode" == "single_owner" ]]; then
        command -v gh >/dev/null 2>&1 || { echo -e "[-] [FAIL-CLOSED] single_owner 需要 gh 读取 accepted_by login" >&2; exit 1; }
        accepted_by="$(gh_login)"
        [[ -n "$accepted_by" ]] || { echo -e "[-] [FAIL-CLOSED] 无法读取 gh api user login" >&2; exit 1; }
        read -r -p "风险接受：single_owner 不提供自然人分离，确认接受？输入 YES: " confirm
        [[ "$confirm" == "YES" ]] || { echo -e "[-] [FAIL-CLOSED] 未接受 single_owner 风险，配置未写入" >&2; exit 1; }
        accepted_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    fi
    node -e '
const fs = require("fs");
const mode = process.argv[1], file = process.argv[2], by = process.argv[3] || "", at = process.argv[4] || "";
const d = { schema_version: "loopx_workflow_config_v0", authorization_mode: mode };
if (mode === "single_owner") d.single_owner_risk_acceptance = { accepted_by: by, accepted_at: at };
fs.writeFileSync(file, JSON.stringify(d, null, 2) + "\n");
' "$mode" "$f" "$accepted_by" "$accepted_at"
    auth_require_config
    echo -e "${GREEN}[✓] 已写入授权配置: $f (authorization_mode=$mode)${NC}"
}

cmd_doctor() {
    echo -e "${BLUE}==> [1/3] 运行流水线前置哨兵体检 (Preflight Sentinel)...${NC}"
    "$PROJECT_ROOT/scripts/preflight-check.sh"

    echo -e "\n${BLUE}==> [2/3] 运行 LoopX 原生健康自检 (LoopX Doctor)...${NC}"
    if command -v loopx >/dev/null 2>&1; then
        if ! loopx doctor; then
            echo -e "\n${RED}[-] [FAIL-CLOSED] LoopX 原生健康自检失败！${NC}" >&2
            echo -e "💡 为什么阻断？LoopX 控制面存在配置损坏或环境缺失，继续执行可能导致状态丢失。" >&2
            echo -e "🛠️ 修复指令: 查看上方详细自检日志，或运行 python3 -m pip install --upgrade loopx 进行修复。" >&2
            exit 1
        fi
    else
        echo -e "${RED}[-] [FAIL-CLOSED] 未检测到 loopx CLI，流水线控制面不可用。${NC}" >&2
        echo -e "    原因: 本机 PATH 中没有 loopx，无法注册 Goal、锁定契约、核验收据或合入锁。" >&2
        echo -e "    影响: approve/check/merge/issue/integrate/todo 等承重命令将全部阻断。" >&2
        echo -e "🛠️ 修复指令: python3 -m pip install --upgrade loopx && loopx doctor" >&2
        exit 1
    fi

    # 环境治理：路由/registry 一致性 + API 预算基线（WARN 不阻断，但给出可执行修复指令）
    if ! cmd_doctor_control_plane; then
        echo -e "\n${YELLOW}[i] 控制面一致性检查存在告警：不影响本地门禁，但会影响 approve/check/迁移的稳定性。${NC}"
    fi

    # Gate 授权配置 + 交付基础设施（配置非法 fail-closed；分支保护在 Gate1 只 WARN）
    doctor_authorization_config
}

cmd_init() {
    init_authorization_config
    echo -e "${BLUE}==> 正在初始化 LoopX 工作流环境...${NC}"
    "$PROJECT_ROOT/scripts/workflow-init.sh"
    if command -v loopx >/dev/null 2>&1; then
        echo -e "${BLUE}==> 正在连接 LoopX 本地项目状态...${NC}"
        if ! loopx bootstrap --project "$PROJECT_ROOT"; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 本地项目状态初始化失败！${NC}" >&2
            exit 1
        fi
    fi
    echo -e "${GREEN}[✓] 初始化完成！建议随后运行: loopx-flow doctor${NC}"
}

sync_global_required() {
    local goal_id="${1:-}"
    local -a args=(sync-global)
    [[ -n "$goal_id" ]] && args+=(--goal-id "$goal_id")
    local attempt out status
    for attempt in 1 2 3; do
        if out="$(loopx $REGISTRY_FLAG "${args[@]}" 2>&1)"; then
            return 0
        fi
        status=$?
        echo -e "${YELLOW}[!] loopx sync-global 失败（第 ${attempt}/3 次），1 秒后重试...${NC}" >&2
        sleep 1
    done
    echo -e "${RED}[-] [FAIL-CLOSED] loopx sync-global 重试 3 次仍失败，禁止静默放行。${NC}" >&2
    echo -e "    实际输出: ${out}" >&2
    echo -e "🛠️ 修复指令: loopx sync-global${goal_id:+ --goal-id $goal_id}" >&2
    return 1
}

cmd_feature() {
    local feature="${1:-}"
    if [[ -z "$feature" ]]; then
        echo -e "${RED}[-] 错误: 请指定特性名称，例如: loopx-flow feature user-auth${NC}" >&2
        exit 1
    fi

    local branch_name="feature/$feature"
    local goal_id="${feature}-goal"

    echo -e "${BLUE}==> [1/3] 检查并切换特性分支: $branch_name ...${NC}"
    if git rev-parse --verify "$branch_name" >/dev/null 2>&1; then
        if ! git checkout "$branch_name" 2>/dev/null; then
            echo -e "${RED}[-] [FAIL-CLOSED] 切换特性分支 $branch_name 失败，流程已物理熔断！${NC}" >&2
            echo -e "💡 为什么阻断？工作区可能存在脏文件阻碍切换，严禁在当前分支继续执行。" >&2
            echo -e "🛠️ 修复指令: 运行 git status 检查未暂存改动或使用 git stash 暂存后重试。" >&2
            exit 1
        fi
    else
        if ! git checkout -b "$branch_name" 2>/dev/null; then
            echo -e "${RED}[-] [FAIL-CLOSED] 创建特性分支 $branch_name 失败，流程已物理熔断！${NC}" >&2
            echo -e "💡 为什么阻断？严禁在 main 主干或非目标分支直接初始化资产包。" >&2
            echo -e "🛠️ 修复指令: 运行 git status 检查工作区状态或使用 git stash 暂存后重试。" >&2
            exit 1
        fi
    fi

    echo -e "${BLUE}==> [2/3] 初始化 Feature 资产胶囊: specs/features/$feature/ ...${NC}"
    local spec_dir="$PROJECT_ROOT/specs/features/$feature"
    mkdir -p "$spec_dir"

    # 1. 00-INDEX.md
    if [[ ! -f "$spec_dir/00-INDEX.md" ]]; then
        cat << INDEXEOF > "$spec_dir/00-INDEX.md"
# Feature Capsule: $feature

> **特性描述**：$feature 核心功能研发
- **Feature Name**: \`$feature\`
- **Branch**: \`$branch_name\`
- **LoopX Goal**: \`$goal_id\`
- **Current Status**: \`IN_PROGRESS (Stage 1~4 Initialized)\`
- **Contract Status**: \`DRAFT (Pending Approval)\`

## 过程文档索引
1. [01-decisions.md](01-decisions.md) - 阶段 1：架构决策备忘录
2. [02-prd.md](02-prd.md) - 阶段 2：精益 PRD 与承重假设
3. [03-stories.md](03-stories.md) - 阶段 3：Job Stories 拆解
4. [04-contract.md](04-contract.md) - 阶段 4：TypeScript 契约与任务图
5. [05-evidence.md](05-evidence.md) - 阶段 5/6：门禁实测数据与质量收据
INDEXEOF
    fi

    # 2. 01-decisions.md
    if [[ ! -f "$spec_dir/01-decisions.md" ]]; then
        cat << DECEOF > "$spec_dir/01-decisions.md"
# Architecture Decisions: $feature
- **Status**: DRAFT (Pending Human Approval)
- **Feature**: $feature

## 1. 核心技术路线对比与权衡
- **分支 1**: 采用最小侵入性实现，复用既有模块。
DECEOF
    fi

    # 3. 02-prd.md
    if [[ ! -f "$spec_dir/02-prd.md" ]]; then
        cat << PRDEOF > "$spec_dir/02-prd.md"
# Lean PRD: $feature

## 1. 核心目标与用户旅程
实现 $feature 特性。

## 2. 承重假设矩阵
- **假设 1**: 本地四大门禁全绿，无破坏性改动。
PRDEOF
    fi

    # 4. 03-stories.md
    if [[ ! -f "$spec_dir/03-stories.md" ]]; then
        cat << STORYEOF > "$spec_dir/03-stories.md"
# User Stories & Sizing: $feature
- **Story 1**: 完成核心接口契约固化与类型安全定义。
- **Story 2**: TDD 红绿循环实现与单测覆盖。
STORYEOF
    fi

    # 5. 04-contract.md
    local contract_file="$spec_dir/04-contract.md"
    if [[ ! -f "$contract_file" ]]; then
        cat << CONTRACTEOF > "$contract_file"
# Feature Contract & Tasks: $feature

- **Contract-Status**: DRAFT (Pending Approval)
- **Feature Branch**: $branch_name
- **LoopX Goal**: $goal_id

## 1. 契约冻结 (TypeScript Interfaces & Invariants)
\`\`\`typescript
export interface ${feature//-/}Config {
  enabled: boolean;
}
\`\`\`

## 2. 任务清单 (Tasks)
- [ ] 【 】t1: 阶段 1 架构决策落实 (\`01-decisions.md\`)
- [ ] 【 】t2: 阶段 2 精益 PRD 与红队攻击 (\`02-prd.md\`)
- [ ] 【 】t3: 阶段 3 特性故事拆解 (\`03-stories.md\`)
- [ ] 【 】t4: 阶段 5 TDD 核心实现与单测
- [ ] 【 】t5: 阶段 6 代码质量与审查收据
- [ ] 【 】t6: 阶段 7 交付 PR 发起与 L2 报告
CONTRACTEOF
    fi

    # 6. 05-evidence.md
    if [[ ! -f "$spec_dir/05-evidence.md" ]]; then
        cat << EVIEEOF > "$spec_dir/05-evidence.md"
# Quality & Verification Evidence: $feature
- **Status**: PENDING_EXECUTION
EVIEEOF
    fi

    echo -e "    ${GREEN}[✓] 已生成自包含资产包: specs/features/$feature/${NC}"

    echo -e "${BLUE}==> [3/3] 注册 LoopX Goal 实体与持久化状态 (Capsule State Bound)...${NC}"
    local state_file="specs/features/$feature/ACTIVE_STATE.md"

    if command -v loopx >/dev/null 2>&1; then
        # LoopX 2.0 只有在 --state-file 不存在时才会创建 canonical authority；
        # 因此这里严禁在 bootstrap 前预创建 ACTIVE_STATE.md（issue #17）。
        if ! loopx $REGISTRY_FLAG bootstrap --project "$PROJECT_ROOT" --goal-id "$goal_id" --display-name "Feature: $feature" --state-file "specs/features/$feature/ACTIVE_STATE.md"; then
            echo -e "${RED}[-] [FAIL-CLOSED] 注册 LoopX Goal $goal_id 失败，流程已阻断！${NC}" >&2
            echo -e "💡 为什么阻断？目标实体注册失败将导致任务无法被正确追踪与审计。" >&2
            echo -e "🛠️ 修复指令: 运行 loopx doctor 排查本地注册表健康状态。" >&2
            exit 1
        fi
        if [[ ! -f "$PROJECT_ROOT/$state_file" ]]; then
            echo -e "${YELLOW}[!] loopx bootstrap 成功但未生成 state_file: $state_file${NC}" >&2
        fi
        if ! sync_global_required "$goal_id"; then
            echo -e "${RED}[-] [FAIL-CLOSED] Goal 已注册，但全局 registry 同步失败；修复 sync 后重跑 feature。${NC}" >&2
            exit 1
        fi
    else
        if [[ ! -f "$PROJECT_ROOT/$state_file" ]]; then
            cat << STATEEOF > "$PROJECT_ROOT/$state_file"
# Active Goal State: $goal_id
- **Feature**: $feature
- **Created At**: $(date "+%Y-%m-%d %H:%M:%S")
- **Status**: active
STATEEOF
        fi
        echo -e "${YELLOW}[!] 未安装 loopx：已生成本地模板，未注册 LoopX Goal。${NC}"
    fi

    echo -e "\n${BOLD}${GREEN}======================================================================${NC}"
    echo -e "${BOLD}${GREEN}  [✓] 特性 $feature 初始化完毕！${NC}"
    echo -e "${BOLD}${GREEN}======================================================================${NC}"
    echo -e "  请审阅资产包: ${BOLD}specs/features/$feature/00-INDEX.md${NC}"
    echo -e "  完成方案与契约核验后，请执行审批放行指令:"
    echo -e "  ${BOLD}${BLUE}loopx-flow approve contract $feature${NC}\n"
}

auth_config_path() { printf '%s\n' "$PROJECT_ROOT/loopx-workflow.config.json"; }

auth_require_config() {
    local f
    f="$(auth_config_path)"
    if [[ ! -f "$f" ]]; then
        echo "[-] [FAIL-CLOSED] 缺少授权配置: $f" >&2
        exit 1
    fi
    if ! node -e '
const fs = require("fs");
let d;
try { d = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); }
catch (_) { console.error("配置不是合法 JSON"); process.exit(2); }
if (d.schema_version !== "loopx_workflow_config_v0") { console.error("schema_version 非法"); process.exit(2); }
if (!["independent", "single_owner"].includes(d.authorization_mode)) { console.error("authorization_mode 非法"); process.exit(2); }
if (d.authorization_mode === "single_owner") {
  const r = d.single_owner_risk_acceptance;
  if (!r || typeof r.accepted_by !== "string" || !r.accepted_by || typeof r.accepted_at !== "string" || !r.accepted_at) {
    console.error("single_owner 缺 risk acceptance"); process.exit(2);
  }
}
' "$f"; then
        echo "[-] [FAIL-CLOSED] 授权配置校验失败: $f" >&2
        exit 1
    fi
}

auth_mode() {
    node -e 'const fs=require("fs");const d=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));process.stdout.write(d.authorization_mode||"")' "$(auth_config_path)" 2>/dev/null || true
}

auth_accepted_by() {
    node -e 'const fs=require("fs");const d=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));process.stdout.write((d.single_owner_risk_acceptance||{}).accepted_by||"")' "$(auth_config_path)" 2>/dev/null || true
}

auth_accepted_at() {
    node -e 'const fs=require("fs");const d=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));process.stdout.write((d.single_owner_risk_acceptance||{}).accepted_at||"")' "$(auth_config_path)" 2>/dev/null || true
}

gh_login() {
    gh api user --jq .login 2>/dev/null || gh api user -q .login 2>/dev/null || true
}

sha256_file() {
    if command -v node >/dev/null 2>&1; then
        node -e 'const fs=require("fs"),crypto=require("crypto");console.log(crypto.createHash("sha256").update(fs.readFileSync(process.argv[1])).digest("hex"))' "$1"
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        LC_ALL=C shasum -a 256 "$1" | awk '{print $1}'
    fi
}

gate1_decisions_approved() {
    local feature="$1" file="$PROJECT_ROOT/specs/features/$feature/01-decisions.md"
    [[ -f "$file" ]] || file="$PROJECT_ROOT/specs/archive/$feature/01-decisions.md"
    [[ -f "$file" ]] || return 1
    grep -Eq '^(status:[[:space:]]*APPROVED([[:space:]]|$)|[-*][[:space:]]*\*\*(Status|方案状态)\*\*(:|：).*APPROVED)' "$file"
}

gate1_spec_complete() {
    local feature="$1"
    local contract="$PROJECT_ROOT/specs/features/$feature/04-contract.md"
    local stories="$PROJECT_ROOT/specs/features/$feature/03-stories.md"
    [[ -f "$contract" ]] || return 1
    grep -qi 'AC' "$contract" || return 1
    grep -qi 'Scope' "$contract" || return 1
    grep -qi 'Verification' "$contract" || return 1
    grep -Eqi '依赖|Dependency|Order' "$contract" || return 1
    grep -Eq 'REQ-|ADR-' "$contract" || return 1
    if [[ -f "$stories" ]] && grep -qi 'Story' "$stories"; then
        grep -qi 'AC' "$stories" || return 1
    fi
    return 0
}

find_gate1_independent_comment() {
    local feature="$1" pre_sha="$2" executor="$3" branch="feature/$1" repo pr comments
    repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
    [[ -n "$repo" ]] || return 1
    pr="$(gh pr list --head "$branch" --state open --json number,isDraft --jq '.[0] | select(.isDraft == true) | .number' 2>/dev/null || true)"
    [[ -n "$pr" && "$pr" != "null" ]] || return 1
    comments="$(gh api "repos/$repo/issues/$pr/comments" --paginate 2>/dev/null || true)"
    node -e '
const fs = require("fs");
const executor = process.argv[1], feature = process.argv[2], preSha = process.argv[3];
let rows = [];
try { rows = JSON.parse(fs.readFileSync(0, "utf8")); } catch (_) { process.exit(1); }
const marker = "<!-- loopx-flow:gate1-authorization:" + feature + "@" + preSha + " -->";
for (const row of rows) {
  const body = String(row.body || ""), login = String((row.user || {}).login || "");
  if (!body.includes(marker) || !login || login === executor) continue;
  const fields = {};
  for (const part of body.split(/[;\n]/)) { const i = part.indexOf("="); if (i <= 0) continue; const k = part.slice(0, i).trim(); if (/^[A-Za-z0-9_]+$/.test(k)) fields[k] = part.slice(i + 1).trim(); }
  if (fields.gate === "1" && fields.mode === "independent" && fields.contract_sha === preSha && fields.approver === login) { process.stdout.write(login); process.exit(0); }
}
process.exit(1);
' "$executor" "$feature" "$pre_sha" <<< "$comments"
}

gate1_user_gate_evidence() {
    local feature="$1" sha="$2" goal="$1-goal" json
    json="$(loopx --format json $REGISTRY_FLAG todo list --goal-id "$goal" --role user 2>/dev/null || true)"
    [[ -n "$json" ]] || return 1
    node -e '
const fs = require("fs");
const sha = process.argv[1];
let data = {};
try { data = JSON.parse(fs.readFileSync(0, "utf8")); } catch (_) { process.exit(1); }
const rows = (data.todos || []).filter((t) => t.task_class === "user_gate" && t.decision_outcome === "approve" && t.decision_scope && t.decision_scope.scope_key === sha && !t.superseded_by);
if (!rows.length) process.exit(1);
process.stdout.write(String(rows[rows.length - 1].evidence || ""));
' "$sha" <<< "$json"
}

gate1_verify_authorization() {
    # 未采用 Gate1 授权配置的存量仓库仍只做 SHA 双重锚定；采用配置后强制解析 evidence（ADR-0009 决策 7）
    [[ -f "$(auth_config_path)" ]] || return 0
    local feature="$1" sha="$2" mode evidence accepted_by accepted_at risk
    mode="$(auth_mode)"
    evidence="$(gate1_user_gate_evidence "$feature" "$sha" || true)"
    if [[ -z "$evidence" ]]; then
        echo "[-] [FAIL-CLOSED] 缺少当前 SHA 对应的 user_gate approve 授权记录。" >&2
        exit 1
    fi
    accepted_by="$(auth_accepted_by)"
    accepted_at="$(auth_accepted_at)"
    risk="$accepted_by@$accepted_at"
    if ! node -e '
const mode = process.argv[1], sha = process.argv[2], acceptedBy = process.argv[3], risk = process.argv[4];
const text = process.argv[5] || "";
const fields = {};
for (const part of text.split(/[;\n]/)) { const i = part.indexOf("="); if (i <= 0) continue; const k = part.slice(0, i).trim(); if (/^[A-Za-z0-9_]+$/.test(k)) fields[k] = part.slice(i + 1).trim(); }
const base = ["authorization_mode","contract_sha","spec_commit","feature","principal"];
for (const k of base) if (!fields[k]) { console.error("evidence 缺键: " + k); process.exit(1); }
if (fields.authorization_mode !== mode) { console.error("evidence mode 与配置不一致"); process.exit(1); }
if (fields.contract_sha !== sha) { console.error("evidence contract_sha 与当前 SHA 不一致"); process.exit(1); }
if (mode === "single_owner") {
  if (!fields.risk_acceptance) { console.error("single_owner evidence 缺 risk_acceptance"); process.exit(1); }
  if (fields.principal !== acceptedBy) { console.error("principal 与 accepted_by 不一致"); process.exit(1); }
  if (fields.risk_acceptance !== risk) { console.error("risk_acceptance 与配置不一致"); process.exit(1); }
} else if (!fields.principal) { console.error("independent evidence 缺 principal"); process.exit(1); }
' "$mode" "$sha" "$accepted_by" "$risk" "$evidence"; then
        exit 1
    fi
    echo "[✓] Gate1 授权记录核验通过 ($mode)"
}

contract_sha_for() {
    local feature="$1" f="$PROJECT_ROOT/specs/features/$feature/04-contract.md"
    [[ -f "$f" ]] || f="$PROJECT_ROOT/specs/archive/$feature/04-contract.md"
    [[ -f "$f" ]] || return 1
    sha256_file "$f"
}

pr_is_draft() {
    local pr_id="$1" out
    out="$(gh pr view "$pr_id" --json isDraft --jq '.isDraft' 2>/dev/null || true)"
    [[ "$out" == "true" ]]
}

github_repo() {
    gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true
}

# Mode B：当前 head 上必须有 Agent 的 review 记录（ADR-0012 决策 2②）
# 兼容两条现有发布通道：formal review COMMENT（gh api pulls/reviews）或 review issue comment（loopx-flow review 的 upsert 标记）
agent_comment_ok() {
    local pr_id="$1" head_oid="$2" repo reviews comments marker
    repo="$(github_repo)"
    [[ -n "$repo" ]] || return 1
    marker="<!-- loopx-flow:review:${pr_id}@$(printf '%s' "$head_oid" | tr 'A-Z' 'a-z') -->"
    reviews="$(gh api "repos/$repo/pulls/$pr_id/reviews" --paginate 2>/dev/null || true)"
    if node -e '
const fs = require("fs");
const head = process.argv[1];
let rows = [];
try { rows = JSON.parse(fs.readFileSync(0, "utf8")); } catch (_) { process.exit(1); }
if (!Array.isArray(rows)) process.exit(1);
const ok = rows.some((r) => String(r.state || "").toUpperCase() === "COMMENT" && String(r.commit_id || (r.commit || {}).oid || "") === head);
process.exit(ok ? 0 : 1);
' "$head_oid" <<< "$reviews"; then
        return 0
    fi
    comments="$(gh api "repos/$repo/issues/$pr_id/comments" --paginate 2>/dev/null || true)"
    node -e '
const fs = require("fs");
const marker = process.argv[1];
let rows = [];
try { rows = JSON.parse(fs.readFileSync(0, "utf8")); } catch (_) { process.exit(1); }
if (!Array.isArray(rows)) process.exit(1);
process.exit(rows.some((r) => String(r.body || "").includes(marker)) ? 0 : 1);
' "$marker" <<< "$comments"
}

# Mode B：release-authorization 评论必须绑定当前 head、当前契约 SHA 与 accepted_by（ADR-0012 决策 10）
release_authorization_ok() {
    local pr_id="$1" head_oid="$2" contract_sha="$3" repo comments accepted_by accepted_at risk
    [[ "$(auth_mode)" == "single_owner" ]] || return 1
    accepted_by="$(auth_accepted_by)"
    accepted_at="$(auth_accepted_at)"
    [[ -n "$accepted_by" ]] || return 1
    risk="$accepted_by@$accepted_at"
    repo="$(github_repo)"
    [[ -n "$repo" ]] || return 1
    comments="$(gh api "repos/$repo/issues/$pr_id/comments" --paginate 2>/dev/null || true)"
    node -e '
const fs = require("fs");
const pr = process.argv[1], head = process.argv[2], acceptedBy = process.argv[3], contractSha = process.argv[4], risk = process.argv[5];
let rows = [];
try { rows = JSON.parse(fs.readFileSync(0, "utf8")); } catch (_) { process.exit(1); }
const marker = "<!-- loopx-flow:release-authorization:" + pr + "@" + head + " -->";
for (const row of rows) {
  const body = String(row.body || ""), login = String((row.user || {}).login || "");
  if (!body.includes(marker) || login !== acceptedBy) continue;
  const fields = {};
  for (const part of body.split(/[;\n]/)) { const i = part.indexOf("="); if (i <= 0) continue; const k = part.slice(0, i).trim(); if (/^[A-Za-z0-9_]+$/.test(k)) fields[k] = part.slice(i + 1).trim(); }
  const ok = fields.gate === "2" && fields.mode === "single_owner" && fields.head === head && fields.principal === acceptedBy && fields.contract_sha === contractSha && fields.risk_acceptance === risk;
  if (ok) process.exit(0);
}
process.exit(1);
' "$pr_id" "$head_oid" "$accepted_by" "$contract_sha" "$risk" <<< "$comments"
}

# Mode A：非作者 formal review APPROVED 且 review commit == 当前 head，PR 非 Draft（ADR-0012 决策 2②）
mode_a_review_ok() {
    local pr_id="$1" head_oid="$2" json
    json="$(gh pr view "$pr_id" --json reviews,author,reviewDecision,isDraft --jq '[(.author.login // ""), (.reviewDecision // ""), ((.isDraft // false) | tostring), (.reviews // [])] | @json' 2>/dev/null || true)"
    [[ -n "$json" ]] || return 1
    node -e '
const fs = require("fs");
let data;
try { data = JSON.parse(fs.readFileSync(0, "utf8")); } catch (_) { process.exit(1); }
const prAuthor = String(data[0] || ""), decision = String(data[1] || ""), isDraft = String(data[2] || "false"), reviews = Array.isArray(data[3]) ? data[3] : [];
const head = process.argv[1];
if (isDraft === "true") process.exit(1);
if (decision !== "APPROVED") process.exit(1);
const ok = reviews.some((r) => String((r.author || {}).login || "") !== prAuthor && String((r.commit || {}).oid || r.commit_id || "") === head && String(r.state || "").toUpperCase() === "APPROVED");
process.exit(ok ? 0 : 1);
' "$head_oid" <<< "$json"
}

# readiness JSON 提取（容忍前后日志噪声）
readiness_json_field() {
    local raw="$1"
    node -e '
const firstJson = (s) => { let depth = 0, inStr = false, esc = false; for (let i = 0; i < s.length; i++) { const c = s[i]; if (inStr) { if (esc) esc = false; else if (c === "\\") esc = true; else if (c === "\"") inStr = false; continue; } if (c === "\"") { inStr = true; continue; } if (c === "{") { depth++; } else if (c === "}") { depth--; if (depth === 0) return s.slice(0, i + 1); } } return null; };
const raw = process.argv[1];
const json = firstJson(raw);
if (!json) { process.stderr.write("readiness JSON 解析失败\n"); process.exit(1); }
let d;
try { d = JSON.parse(json); } catch (_) { process.stderr.write("readiness JSON 解析失败\n"); process.exit(1); }
process.stdout.write(JSON.stringify(d));
' "$raw"
}

# Mode A readiness：以 JSON ready 字段为准（ADR-0012 决策 2③）
mode_a_readiness_ok() {
    local pr_id="$1" head_oid="$2" goal_id="$3" out parsed
    out="$(loopx $REGISTRY_FLAG pr-review --goal-id "$goal_id" --check-merge-readiness "$pr_id@$head_oid" --format json 2>&1 || true)"
    parsed="$(readiness_json_field "$out")" || return 1
    node -e '
let d = {};
try { d = JSON.parse(process.argv[1]); } catch (_) { process.exit(1); }
process.exit(d.ready === true ? 0 : 1);
' "$parsed"
}

# Mode B readiness：blocking_reasons 三档判定（ADR-0012 决策 2③ 允许/忽略列表）
mode_b_readiness_ok() {
    local pr_id="$1" head_oid="$2" goal_id="$3" out parsed
    out="$(loopx $REGISTRY_FLAG pr-review --goal-id "$goal_id" --check-merge-readiness "$pr_id@$head_oid" --format json 2>&1 || true)"
    parsed="$(readiness_json_field "$out")" || return 1
    node -e '
const allow = new Set(["pull_request_not_open","draft_pull_request","remote_head_mismatch","status_checks_missing","status_checks_failed","status_checks_pending","status_checks_incomplete","review_threads_incomplete","unresolved_review_threads","merge_state_requires_update","merge_state_unverified"]);
const ignore = new Set(["current_head_review_missing_or_invalid","current_head_conclusion_not_approval","github_review_decision_not_approved","repository_merge_state_blocked"]);
let d = {};
try { d = JSON.parse(process.argv[1]); } catch (_) { process.exit(1); }
const obs = (d.readiness_observation && typeof d.readiness_observation === "object") ? d.readiness_observation : {};
const raw = Array.isArray(d.blocking_reasons) ? d.blocking_reasons : (Array.isArray(obs.blocking_reasons) ? obs.blocking_reasons : null);
if (!raw) { process.stderr.write("blocking_reasons 缺失或不可解析\n"); process.exit(1); }
for (const row of raw) {
  const code = typeof row === "string" ? row : String((row && (row.code || row.reason || row.kind)) || "");
  if (!code) { process.stderr.write("blocking_reasons 含无法识别的条目\n"); process.exit(1); }
  if (allow.has(code)) { process.stderr.write("Mode B readiness 命中允许列表阻断项: " + code + "\n"); process.exit(1); }
  if (ignore.has(code)) continue;
  process.stderr.write("Mode B readiness 命中未知阻断项: " + code + "\n"); process.exit(1);
}
process.exit(0);
' "$parsed"
}

# CI/分支保护是 Gate2 前置；缺失时 merge fail-closed（ADR-0012 决策 5）
branch_protection_ok() {
    local mode="$1" script="$PROJECT_ROOT/scripts/setup-branch-protection.sh" out
    if [[ ! -f "$script" ]]; then
        echo "[-] [FAIL-CLOSED] 缺少分支保护检查脚本: $script" >&2
        return 1
    fi
    if out="$(bash "$script" --check --mode "$mode" 2>&1)"; then
        return 0
    fi
    echo "[-] [FAIL-CLOSED] 分支保护未满足 authorization_mode=$mode: ${out:-<no output>}" >&2
    echo "🛠️ 修复指令: bash scripts/setup-branch-protection.sh --apply" >&2
    return 1
}

cmd_approve() {
    local target="${1:-}" feature="${2:-}" yes=false arg
    for arg in "$@"; do
        if [[ "$arg" == "--yes" ]]; then yes=true; fi
    done
    if [[ "$target" != "contract" ]]; then
        echo "[-] 错误: 目前仅支持 approve contract，例如: loopx-flow approve contract user-auth" >&2
        exit 1
    fi
    if [[ -z "$feature" ]]; then
        local branch
        branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
        if [[ "$branch" =~ ^feature/(.+) ]]; then feature="${BASH_REMATCH[1]}"; fi
    fi
    if [[ -z "$feature" ]]; then
        echo "[-] 错误: 请指定特性名称，例如: loopx-flow approve contract user-auth" >&2
        exit 1
    fi

    local contract_file="$PROJECT_ROOT/specs/features/$feature/04-contract.md"
    local decision_file="$PROJECT_ROOT/specs/features/$feature/01-decisions.md"
    local index_file="$PROJECT_ROOT/specs/features/$feature/00-INDEX.md"

    [[ -f "$contract_file" ]] || { echo "[-] 未找到契约文件: $contract_file" >&2; exit 1; }
    command -v loopx >/dev/null 2>&1 || { echo "[-] [FAIL-CLOSED] 未检测到 loopx CLI，禁止写批准标记。" >&2; exit 1; }

    # Gate1 授权强制启用：缺失/非法配置即 fail-closed（ADR-0009 T3/T4）
    auth_require_config
    local mode
    mode="$(auth_mode)"
    [[ -n "$mode" ]] || { echo "[-] [FAIL-CLOSED] 无法读取 authorization_mode" >&2; exit 1; }
    if ! gate1_decisions_approved "$feature"; then
        echo "[-] [FAIL-CLOSED] 01-decisions.md 未标记 APPROVED" >&2; exit 1
    fi
    if ! gate1_spec_complete "$feature"; then
        echo "[-] [FAIL-CLOSED] 规格不完整: 04-contract 需含 AC/Scope/Verification Plan/依赖顺序/REQ或ADR，Story 需有 AC" >&2; exit 1
    fi

    local principal="" executor="" spec_commit=""

    # 先落最终字节：批准标记行固定，不把审批人/时间写进参与哈希的正文。
    local temp_contract="$contract_file.tmp.$$"
    APPROVE_TEMP_CONTRACT="$temp_contract"
    cleanup_approve_temp_contract() { [[ -n "${APPROVE_TEMP_CONTRACT:-}" ]] && rm -f -- "$APPROVE_TEMP_CONTRACT"; }
    trap cleanup_approve_temp_contract EXIT INT TERM
    node -e '
const fs = require("fs");
const src = process.argv[1], dst = process.argv[2];
let text = fs.readFileSync(src, "utf8");
const line = "- **Contract-Status**: FROZEN & APPROVED";
if (/Contract-Status/i.test(text)) text = text.replace(/.*Contract-Status.*$/m, line);
else text = line + "\n" + text;
fs.writeFileSync(dst, text);
' "$contract_file" "$temp_contract"

    # 评论、configure-goal、evidence、最终落盘共用这一份字节的 SHA
    local contract_sha
    contract_sha="$(sha256_file "$temp_contract")"

    if [[ "$mode" == "single_owner" ]]; then
        [[ "$yes" != "true" ]] || { echo "[-] [FAIL-CLOSED] 不支持 --yes：single_owner approve 必须真实 TTY 交互确认" >&2; exit 1; }
        [[ -t 0 ]] || { echo "[-] [FAIL-CLOSED] single_owner approve 必须 TTY 交互确认" >&2; exit 1; }
        command -v gh >/dev/null 2>&1 || { echo "[-] [FAIL-CLOSED] single_owner approve 需要 gh 读取 login" >&2; exit 1; }
        executor="$(gh_login)"
        [[ -n "$executor" ]] || { echo "[-] [FAIL-CLOSED] 无法读取 gh api user login" >&2; exit 1; }
        local accepted_by
        accepted_by="$(auth_accepted_by)"
        [[ "$executor" == "$accepted_by" ]] || { echo "[-] [FAIL-CLOSED] 当前 gh login ($executor) 与 accepted_by ($accepted_by) 不一致" >&2; exit 1; }
        principal="$executor"
    else
        command -v gh >/dev/null 2>&1 || { echo "[-] [FAIL-CLOSED] independent approve 需要 gh" >&2; exit 1; }
        executor="$(gh_login)"
        [[ -n "$executor" ]] || { echo "[-] [FAIL-CLOSED] 无法读取 gh api user login" >&2; exit 1; }
        principal="$(find_gate1_independent_comment "$feature" "$contract_sha" "$executor" || true)"
        [[ -n "$principal" ]] || { echo "[-] [FAIL-CLOSED] independent 缺少有效的第二 GitHub 账号 gate=1 评论（评论 contract_sha 必须等于最终锁定字节的 SHA）" >&2; exit 1; }
    fi

    # spec_commit 只作追溯（不参与 gate verify）；生产路径必须工作区干净。
    local dirty
    dirty="$(git status --porcelain --untracked-files=no 2>/dev/null || true)"
    [[ -z "$dirty" ]] || { echo "[-] [FAIL-CLOSED] 工作区不干净，Spec-Commit 无法确定；请先提交" >&2; exit 1; }
    spec_commit="$(git rev-parse HEAD)"

    local timestamp operator
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    operator="${principal:-${USER:-$(whoami)}}"

    echo "    契约 SHA256 指纹: $contract_sha (mode=$mode, principal=$principal)"
    local goal_id="$feature-goal"
    local configure_out
    if ! configure_out="$(loopx $REGISTRY_FLAG configure-goal --goal-id "$goal_id" --progress-review-contract-revision "$contract_sha" --execute 2>&1)"; then
        rm -f "$temp_contract"
        echo "[-] [FAIL-CLOSED] 契约 SHA256 物理锁定失败: $configure_out" >&2
        exit 1
    fi

    local agent="${LOOPX_AGENT_ID:-loopx-flow-agent}"
    loopx $REGISTRY_FLAG register-agent --goal-id "$goal_id" --agent-id "$agent" --execute >/dev/null 2>&1 || true
    local evidence
    if [[ "$mode" == "single_owner" ]]; then
        evidence="authorization_mode=single_owner;contract_sha=$contract_sha;spec_commit=$spec_commit;feature=$feature;principal=$principal;risk_acceptance=$(auth_accepted_by)@$(auth_accepted_at)"
    else
        evidence="authorization_mode=independent;contract_sha=$contract_sha;spec_commit=$spec_commit;feature=$feature;principal=$principal"
    fi
    local add_out todo_id
    if ! add_out="$(loopx --format json $REGISTRY_FLAG todo add --goal-id "$goal_id" --role user --task-class user_gate --text "Gate1 specification authorization: $feature" --decision-scope "other:goal:$contract_sha" --global-gate 2>&1)"; then
        rm -f "$temp_contract"; echo "[-] [FAIL-CLOSED] 写 user_gate 授权记录失败: $add_out" >&2; exit 1
    fi
    todo_id="$(node -e 'const fs=require("fs");let d={};try{d=JSON.parse(fs.readFileSync(0,"utf8"))}catch(_){};process.stdout.write(String(d.todo_id||""))' <<< "$add_out")"
    [[ -n "$todo_id" ]] || { rm -f "$temp_contract"; echo "[-] [FAIL-CLOSED] user_gate 未返回 todo_id" >&2; exit 1; }
    local complete_out
    if ! complete_out="$(loopx --format json $REGISTRY_FLAG todo complete --goal-id "$goal_id" --todo-id "$todo_id" --agent-id "$agent" --decision-outcome approve --evidence "$evidence" 2>&1)"; then
        rm -f "$temp_contract"; echo "[-] [FAIL-CLOSED] 完成 user_gate 授权记录失败: $complete_out" >&2; exit 1
    fi

    mv "$temp_contract" "$contract_file"
    APPROVE_TEMP_CONTRACT=""
    trap - EXIT INT TERM

    if [[ -f "$decision_file" ]]; then
        node -e '
const fs=require("fs");const file=process.argv[1],op=process.argv[2],ts=process.argv[3];
let text=fs.readFileSync(file,"utf8");const line="- **Status**: APPROVED BY HUMAN ("+op+"@"+ts+")";
if (/^- \*\*Status\*\*: .*$/m.test(text)) text=text.replace(/^- \*\*Status\*\*: .*$/m,line); else text=line+"\n"+text;
fs.writeFileSync(file,text);
' "$decision_file" "$principal" "$timestamp"
    fi
    if [[ -f "$index_file" ]]; then
        node -e '
const fs=require("fs");const file=process.argv[1];let text=fs.readFileSync(file,"utf8");
if (/Contract Status:/.test(text)) text=text.replace(/.*Contract Status:.*$/m,"- **Contract Status**: FROZEN & APPROVED");
if (/Current Status:/.test(text)) text=text.replace(/.*Current Status:.*$/m,"- **Current Status**: APPROVED (Stage 5 TDD Ready)");
fs.writeFileSync(file,text);
' "$index_file"
    fi

    if ! sync_global_required "$goal_id"; then
        echo "[-] [FAIL-CLOSED] 契约已锁定成功，但 sync-global 失败（已锁定、未同步）" >&2
        exit 1
    fi
    echo "[✓] 断点 1 方案与规格审批通过；契约已锁定。"
}

cmd_check() {
    local with_ocr=false feature="" goal_id=""
    local -a args=("$@")
    local i arg
    for ((i=0; i<${#args[@]}; i++)); do
        arg="${args[$i]}"
        case "$arg" in
            --with-ocr) with_ocr=true ;;
            --goal-id)
                goal_id="${args[$((i+1))]:-}"
                i=$((i+1))
                ;;
            -*) ;;
            *)
                if [[ -z "$feature" ]]; then feature="$arg"; fi
                ;;
        esac
    done

    if [[ -z "$feature" ]]; then
        local branch
        branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
        if [[ "$branch" =~ ^feature/(.+) ]]; then
            feature="${BASH_REMATCH[1]}"
        fi
    fi

    if [[ -z "$feature" && -z "$goal_id" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] check 无法解析 Goal 身份：既不在 feature/<name> 分支，也没有显式 feature 或 --goal-id。${NC}" >&2
        echo -e "💡 为什么阻断？没有 Goal 就无法核验 change-quality 严格收据，不能进入交付。${NC}" >&2
        echo -e "🛠️ 修复指令: 检出 feature/<name> 分支，或执行: loopx-flow check --goal-id <goal-id>${NC}" >&2
        exit 1
    fi
    local resolved_goal="${goal_id:-${feature}-goal}"

    echo -e "${BLUE}======================================================================${NC}"
    echo -e "${BLUE}        执行本地四大硬门禁与代码质量一体化自检                          ${NC}"
    echo -e "${BLUE}======================================================================${NC}"

    if [[ -n "$feature" ]]; then
        local contract_file="$PROJECT_ROOT/specs/features/$feature/04-contract.md"
        local archive_contract="$PROJECT_ROOT/specs/archive/$feature/04-contract.md"
        if [[ -f "$contract_file" || -f "$archive_contract" ]]; then
            echo -e "${BOLD}[0/3] 先验证冻结节契约 (gate verify contract)...${NC}"
            if ! "$PROJECT_ROOT/bin/loopx-flow" gate verify contract "$feature"; then
                echo -e "${RED}[-] [FAIL-CLOSED] 契约门禁未通过，禁止进入 check。${NC}" >&2
                exit 1
            fi
        fi
    fi

    echo -e "${BOLD}[1/3] 正在运行本地四大硬门禁 (Typecheck, Lint, Build, Test)...${NC}"
    gate_results_file="$(mktemp "${TMPDIR:-/tmp}/loopx-flow-gate-results.XXXXXX")"
    trap 'rm -f -- "$gate_results_file"' EXIT
    node -e '
const fs = require("fs");
fs.writeFileSync(process.argv[1], JSON.stringify({ schema_version: "loopx_flow_gate_results_v0", gates: [] }, null, 2));
' "$gate_results_file"
    local gate_failed=0 gate_name gate_out gate_code gate_status
    for gate_name in typecheck lint build test; do
        if [[ "$gate_failed" -ne 0 ]]; then
            node -e '
const fs = require("fs");
const file = process.argv[1], name = process.argv[2];
const d = JSON.parse(fs.readFileSync(file, "utf8"));
d.gates = d.gates.filter((g) => g.name !== name);
d.gates.push({ name, command: "npm run " + name, exit_code: null, status: "not_run" });
fs.writeFileSync(file, JSON.stringify(d, null, 2));
' "$gate_results_file" "$gate_name"
            continue
        fi
        if gate_out="$(npm run "$gate_name" 2>&1)"; then
            gate_code=0; gate_status="passed"
        else
            gate_code=$?; gate_status="failed"
        fi
        echo "$gate_out"
        node -e '
const fs = require("fs");
const file = process.argv[1], name = process.argv[2], code = process.argv[3], status = process.argv[4];
const d = JSON.parse(fs.readFileSync(file, "utf8"));
d.gates = d.gates.filter((g) => g.name !== name);
d.gates.push({ name, command: "npm run " + name, exit_code: Number(code), status });
fs.writeFileSync(file, JSON.stringify(d, null, 2));
' "$gate_results_file" "$gate_name" "$gate_code" "$gate_status"
        if [[ "$gate_code" -ne 0 ]]; then gate_failed=1; fi
    done
    if [[ "$gate_failed" -ne 0 ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 四大硬门禁未全绿；仍会写 05-evidence 的 failed/not_run 实测，但禁止进入交付。${NC}" >&2
        echo -e "    四门禁实测结果文件: $gate_results_file" >&2
    else
        echo -e "    ${GREEN}[✓] 四大硬门禁 100% 全绿通过！${NC}"
    fi

    echo -e "\n${BOLD}[2/3] 正在执行代码级审查与质量适配映射...${NC}"
    if [[ "$with_ocr" == "true" && "$gate_failed" -eq 0 ]]; then
        if [[ -z "$feature" ]]; then
            echo -e "${RED}[-] [FAIL-CLOSED] --with-ocr 需要 feature 胶囊。${NC}" >&2
            exit 1
        fi
        echo -e "    检测到启用阿里 OCR 选配项，调用技能内自闭环脚本..."
        "$PROJECT_ROOT/skills/open-code-review/run-ocr.sh" origin/main "$feature"
    else
        echo -e "    调用默认语义契约审查并送入 LoopX Quality 适配器..."
        node "$PROJECT_ROOT/skills/code-review/scripts/ingest-to-loopx-quality.js" ${feature:+--feature "$feature"} --goal-id "$resolved_goal" --gate-results "$gate_results_file"
    fi
    if [[ "$gate_failed" -ne 0 ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 四门禁未全绿；已写 05-evidence 实测状态，交付阻断。${NC}" >&2
        exit 1
    fi

    echo -e "\n${BOLD}[3/3] 正在核验 LoopX change-quality 严格收据凭据 (Fail-Closed)...${NC}"
    if ! command -v loopx >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] 严格收据核验失败: 未检测到 loopx CLI，禁止进入交付阶段。${NC}" >&2
        echo -e "💡 为什么阻断？质量门禁收据核验是强阻断项，必须依赖 LoopX 校验不可篡改凭据。" >&2
        echo -e "🛠️ 修复指令: 安装 loopx (python3 -m pip install --upgrade loopx) 后重试。" >&2
        exit 1
    fi
    local cq_json cq_ok
    cq_json="$(loopx $REGISTRY_FLAG change-quality verify --goal-id "$resolved_goal" --repo-path . --format json 2>&1 || echo '{}')"
    cq_ok="$(node -e '
const fs = require("fs");
let d = {};
try { d = JSON.parse(fs.readFileSync(0, "utf8")); } catch (e) {}
process.stdout.write(d.ok === true ? "true" : "false");
' <<< "$cq_json")"
    if [[ "$cq_ok" != "true" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] LoopX change-quality 收据核验未通过 (ok=false)，禁止进入交付阶段。${NC}" >&2
        echo -e "${RED}    请先运行 prepare/review 并记录与当前 exact-scope 对齐的通过收据。${NC}" >&2
        exit 1
    fi
    echo -e "    ${GREEN}[✓] 严格收据核验通过 (ok=true)。${NC}"

    echo -e "${GREEN}======================================================================${NC}"
    echo -e "${GREEN}[✓] 本地门禁、代码审查与质量收据 100% 通过！${NC}"
    if [[ -n "$feature" && -d "$PROJECT_ROOT/specs/features/$feature" ]]; then
        echo -e "${GREEN}    凭据已同步写入: specs/features/$feature/05-evidence.md${NC}"
    else
        echo -e "${GREEN}    严格收据已记录到 Goal: $resolved_goal (无 feature 胶囊，未写 05-evidence)${NC}"
    fi
    echo -e "${GREEN}======================================================================${NC}"
}
cmd_review() {
    local pr_id="${1:-}"
    shift || true
    if [[ -z "$pr_id" ]]; then
        echo -e "${RED}[-] 错误: 请指定 PR 编号，例如: loopx-flow review 12${NC}" >&2
        exit 1
    fi

    if ! command -v gh >/dev/null 2>&1; then
        echo -e "${RED}[-] 错误: 未安装 gh CLI，无法执行交付审查。${NC}" >&2
        exit 1
    fi

    echo -e "${BLUE}==> [交付审查 L2] 正在执行真实模型审查管线 (codex exec 默认模型 + LoopX check-result 核验)...${NC}"
    local repo
    repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || echo '')"
    if [[ -z "$repo" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 无法解析 owner/repo，拒绝执行无锚定审查。${NC}" >&2
        exit 1
    fi

    local review_draft
    review_draft="$(gh pr view "$pr_id" --json isDraft --jq '.isDraft' 2>/dev/null || true)"
    if [[ "$review_draft" == "true" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] PR #$pr_id 仍是 Draft：先 loopx-flow pr ready，再发布 formal review。${NC}" >&2
        exit 1
    fi

    # Infer target feature from current branch (feature/<name>) for capsule evidence
    local feature=""
    local cur_branch
    cur_branch="$(git branch --show-current 2>/dev/null || echo "")"
    if [[ "$cur_branch" =~ ^feature/(.+) ]]; then
        feature="${BASH_REMATCH[1]}"
    fi

    local args=(--pr "$pr_id" --repo "$repo")
    [[ -n "$feature" ]] && args+=(--feature "$feature")
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --cross-validate|--rebuild-body|--force-recheck)
                args+=("$1")
                shift
                ;;
            --agent-bin)
                args+=("$1" "$2")
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    # 编排器场景显式开启降载三件套（head-oid 幂等短路 + 节流 + comment upsert），
    # 避免同一 head 在 CI/自动化会话中反复打爆 GitHub 限流阈值。
    # 人工本地裸跑 node authentic-review.js 时不注入这些 env，行为与改造前一致。
    export REVIEW_SHORTCIRCUIT="${REVIEW_SHORTCIRCUIT:-1}"
    export REVIEW_DEBOUNCE_SECONDS="${REVIEW_DEBOUNCE_SECONDS:-60}"
    export REVIEW_UPSERT_PUBLISH="${REVIEW_UPSERT_PUBLISH:-1}"

    if ! node "$PROJECT_ROOT/skills/code-review/scripts/authentic-review.js" "${args[@]}"; then
        echo -e "${RED}[-] [FAIL-CLOSED] 真实审查管线未通过 (NOT_VERIFIED / HEAD 漂移 / 门禁失败 / check-result 拒绝)。${NC}" >&2
        exit 1
    fi
    echo -e "${GREEN}[✓] Authentic 审查管线完成：真实 findings 已核验并发布至 PR ${pr_id}。${NC}"
}


cmd_respond() {
    local pr_id="${1:-}"
    shift || true
    local result_file=""
    local resolutions_file=""
    local dry_run="false"

    if [[ "$pr_id" == "--help" || "$pr_id" == "-h" || -z "$pr_id" ]]; then
        cat << 'HELPTXT'
用法: loopx-flow respond <pr_id> [--result-file <path>] [--resolutions-file <path>] [--dry-run]
说明: 复用 LoopX `pr-review` 的 `review_template` 五段式格式（动机/改动思路/具体改动/对主干的风险/我的整体评价），
      基于原生评审产物 (.loopx/reviews/<pr>@<head>.json) 逐项闭环 Review findings，并附带实测验证矩阵。
      失败一票熔断：找不到原生评审产物或门禁不通过时拒绝发布。
HELPTXT
        exit 0
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --result-file) result_file="${2:-}"; shift 2 ;;
            --resolutions-file) resolutions_file="${2:-}"; shift 2 ;;
            --dry-run) dry_run="true"; shift ;;
            *) shift ;;
        esac
    done

    local repo
    repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || echo "")"
    if [[ -z "$repo" ]]; then
        echo -e "${RED}[-] 错误: 无法获取 GitHub repo 标识。${NC}" >&2
        exit 1
    fi

    local head_oid
    head_oid="$(gh pr view "$pr_id" --json headRefOid --jq .headRefOid 2>/dev/null || echo "")"
    if [[ -z "$head_oid" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 无法获取 PR #$pr_id 的 HEAD commit，PR 不存在或无访问权限！${NC}" >&2
        exit 1
    fi
    local short_sha="${head_oid:0:9}"

    echo -e "${BLUE}==> [Review 回复] 复用 LoopX 原生五段式格式，执行门禁实测并生成逐项闭环汇报 (Commit $short_sha)...${NC}"

    # 真实执行验证，失败一票熔断 (Fail-Closed)
    echo -e "    [1/5] 执行 Typecheck..."
    if ! npm run typecheck >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] Typecheck 失败，阻断回复发布！${NC}" >&2
        exit 1
    fi

    echo -e "    [2/5] 执行 Lint..."
    if ! npm run lint >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] Lint 失败，阻断回复发布！${NC}" >&2
        exit 1
    fi

    echo -e "    [3/5] 执行 Build..."
    if ! npm run build >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] Build 失败，阻断回复发布！${NC}" >&2
        exit 1
    fi

    echo -e "    [4/5] 执行 Test..."
    if ! npm test >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] Test 失败，阻断回复发布！${NC}" >&2
        exit 1
    fi

    echo -e "    [5/5] 执行 LoopX Status..."
    local loopx_status="PASSED"
    if command -v loopx >/dev/null 2>&1; then
        if ! loopx $REGISTRY_FLAG status >/dev/null 2>&1; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX status 检查失败，阻断回复发布！${NC}" >&2
            exit 1
        fi
    else
        loopx_status="SKIPPED"
    fi

    local gates_json
    gates_json="$(printf '{"typecheck":"PASSED","lint":"PASSED","build":"PASSED","test":"PASSED","loopx_status":"%s"}' "$loopx_status")"

    local helper_args=(--pr "$pr_id" --head "$head_oid" --review-dir "$PROJECT_ROOT/.loopx/reviews" --gates-json "$gates_json")
    [[ -n "$result_file" ]] && helper_args+=(--result-file "$result_file")
    [[ -n "$resolutions_file" ]] && helper_args+=(--resolutions-file "$resolutions_file")

    if [[ "$dry_run" == "true" ]]; then
        if ! node "$PROJECT_ROOT/skills/code-review/scripts/respond-report.js" "${helper_args[@]}" --print; then
            echo -e "${RED}[-] [FAIL-CLOSED] 原生格式回复生成失败（dry-run），未发布。${NC}" >&2
            exit 1
        fi
        echo -e "${GREEN}[✓] dry-run 完成：未向 PR 发布评论。${NC}"
        exit 0
    fi

    local report_file
    if ! report_file="$(node "$PROJECT_ROOT/skills/code-review/scripts/respond-report.js" "${helper_args[@]}")"; then
        echo -e "${RED}[-] [FAIL-CLOSED] 原生格式回复生成失败（缺少评审产物或格式不符），未发布。${NC}" >&2
        exit 1
    fi

    if [[ ! -f "$report_file" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 回复报告文件不存在: $report_file${NC}" >&2
        exit 1
    fi

    # T2 comment upsert: 编排器场景检索既有 respond 标记 comment；命中 → PATCH，未命中 → POST
    # 标记行置于正文尾部（HTML 注释，页面不可见），与 review 侧 upsert 保持一致，不破坏首行结构
    local marker="<!-- loopx-flow:respond:${pr_id}@${short_sha} -->"
    local posted_body
    posted_body="$(cat "$report_file")

${marker}"
    local posted_file
    posted_file="$(mktemp)"
    printf '%s' "$posted_body" > "$posted_file"
    local existing_comment_id=""
    if [[ "${REVIEW_UPSERT_PUBLISH:-1}" == "1" ]]; then
        if existing_comment_id="$(gh api "repos/${repo}/issues/${pr_id}/comments?per_page=100" 2>/dev/null \
            | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{try{const a=JSON.parse(d);const m=a.find(c=>c.body&&c.body.includes(process.argv[1]));process.stdout.write(m?String(m.id):'')}catch(_){process.stdout.write('')}}") "$marker" 2>/dev/null || true)"; then
            if [[ -n "$existing_comment_id" ]]; then
                echo -e "${YELLOW}[THROTTLE-UPSERT] 复用既有 respond comment id=${existing_comment_id}（PATCH 更新，不再新增）${NC}"
                if gh api -X PATCH "repos/${repo}/issues/comments/${existing_comment_id}" -F body=@"$posted_file" >/dev/null 2>&1; then
                    rm -f "$posted_file" "$report_file"
                    echo -e "${GREEN}[✓] 已更新既有 respond 汇报（comment ${existing_comment_id}，head $short_sha）！${NC}"
                    exit 0
                fi
                echo -e "${YELLOW}[i] PATCH 失败，回退 POST 新建${NC}"
            fi
        fi
    fi
    if ! gh pr comment "$pr_id" --repo "$repo" --body-file "$posted_file"; then
        rm -f "$posted_file"
        echo -e "${RED}[-] [FAIL-CLOSED] gh pr comment 失败，回复未发布。${NC}" >&2
        exit 1
    fi
    rm -f "$posted_file" "$report_file"
    echo -e "${GREEN}[✓] 已发布 LoopX 原生五段式更新汇报至 PR #${pr_id}（head $short_sha）！${NC}"
}

cmd_pr() {
    local sub="${1:-}"
    shift || true

    if [[ "$sub" == "--help" || "$sub" == "-h" || -z "$sub" ]]; then
        cat << 'HELPTXT'
用法:
  loopx-flow pr create [feature] [--title "feat(...)"] [--base "main"] [--draft]
  loopx-flow pr preview [feature]
  loopx-flow pr update <pr_id> [feature]
  loopx-flow pr ready <pr_id>

说明:
  按照 LoopX PR #7545 官方标准，从特性胶囊与真实 Git Diff 自动生成双语 4-Part 结构的 PR 描述（包含动机剖析、架构思路、关键代码逐文件讲解、主干风险及四大门禁实测矩阵），并直接发起或更新 GitHub PR。
HELPTXT
        exit 0
    fi

    local current_branch
    current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
    if [[ "$current_branch" == "main" || "$current_branch" == "master" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 严禁在主干分支直接操作 PR。请检出特性分支 (feature/<name>)。${NC}" >&2
        exit 1
    fi

    local feature=""
    local title=""
    local pr_id=""

    case "$sub" in
        preview)
            feature="${1:-}"
            if [[ -z "$feature" ]]; then
                if [[ "$current_branch" =~ ^feature/(.+) ]]; then
                    feature="${BASH_REMATCH[1]}"
                elif [[ "$current_branch" =~ ^fix/(.+) ]]; then
                    feature="${BASH_REMATCH[1]}"
                fi
            fi
            if [[ -z "$feature" ]]; then
                echo -e "${RED}[-] 错误: 请指定特性名称或检出 feature/<name> 分支。${NC}" >&2
                exit 1
            fi
            node "$PROJECT_ROOT/skills/code-review/scripts/authentic-review.js" --generate-pr-body --feature "$feature"
            ;;
        create)
            local base="main"
            local draft="false"
            local passthru_args=()
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --title)
                        title="$2"
                        shift 2
                        ;;
                    --base)
                        base="$2"
                        shift 2
                        ;;
                    --draft)
                        draft="true"; shift ;;
                    --no-draft)
                        draft="false"; shift ;;
                    *)
                        if [[ -z "$feature" ]]; then
                            feature="$1"
                            shift
                        else
                            passthru_args+=("$1")
                            shift
                        fi
                        ;;
                esac
            done

            if [[ -z "$feature" ]]; then
                if [[ "$current_branch" =~ ^feature/(.+) ]]; then
                    feature="${BASH_REMATCH[1]}"
                elif [[ "$current_branch" =~ ^fix/(.+) ]]; then
                    feature="${BASH_REMATCH[1]}"
                fi
            fi
            if [[ -z "$feature" ]]; then
                echo -e "${RED}[-] 错误: 请指定特性名称或检出 feature/<name> 分支。${NC}" >&2
                exit 1
            fi

            if ! command -v gh >/dev/null 2>&1; then
                echo -e "${RED}[-] 错误: 未安装 gh CLI，无法自动创建 PR。${NC}" >&2
                exit 1
            fi

            if [[ -z "$title" ]]; then
                title="feat(${feature}): implement ${feature} aligned with PR #7545 protocol"
            fi

            local tmp_body
            tmp_body="$(mktemp "${TMPDIR:-/tmp}/pr-body-${feature}-XXXXXX.md")"
            node "$PROJECT_ROOT/skills/code-review/scripts/authentic-review.js" --generate-pr-body --feature "$feature" --output-file "$tmp_body"

            echo -e "${BLUE}==> [PR 提交] 正在通过 GitHub CLI 创建 PR (对齐 PR #7545 双语 4-Part 体系)...${NC}"
            local pr_url
            local -a draft_args=()
            [[ "$draft" == "true" ]] && draft_args=(--draft)
            if pr_url="$(gh pr create --title "$title" --body-file "$tmp_body" "${draft_args[@]}" "$@")"; then
                rm -f "$tmp_body"
                echo -e "${GREEN}[✓] PR 创建成功: ${pr_url}${NC}"
            else
                rm -f "$tmp_body"
                echo -e "${RED}[-] PR 创建失败。${NC}" >&2
                exit 1
            fi
            ;;
        update)
            pr_id="${1:-}"
            shift || true
            feature="${1:-}"
            if [[ -z "$pr_id" ]]; then
                echo -e "${RED}[-] 错误: 请指定待更新的 PR 编号，例如: loopx-flow pr update 13${NC}" >&2
                exit 1
            fi
            if [[ -z "$feature" ]]; then
                if [[ "$current_branch" =~ ^feature/(.+) ]]; then
                    feature="${BASH_REMATCH[1]}"
                elif [[ "$current_branch" =~ ^fix/(.+) ]]; then
                    feature="${BASH_REMATCH[1]}"
                fi
            fi
            if [[ -z "$feature" ]]; then
                echo -e "${RED}[-] 错误: 请指定特性名称或检出 feature/<name> 分支。${NC}" >&2
                exit 1
            fi

            local tmp_body
            tmp_body="$(mktemp "${TMPDIR:-/tmp}/pr-body-${feature}-XXXXXX.md")"
            node "$PROJECT_ROOT/skills/code-review/scripts/authentic-review.js" --generate-pr-body --feature "$feature" --output-file "$tmp_body"

            echo -e "${BLUE}==> [PR 更新] 正在更新 PR #${pr_id} 描述 (对齐 PR #7545 双语 4-Part 体系)...${NC}"
            if gh pr edit "$pr_id" --body-file "$tmp_body"; then
                rm -f "$tmp_body"
                echo -e "${GREEN}[✓] PR #${pr_id} 描述已成功更新！${NC}"
            else
                rm -f "$tmp_body"
                echo -e "${RED}[-] PR 更新失败。${NC}" >&2
                exit 1
            fi
            ;;
        ready)
            pr_id="${1:-}"
            shift || true
            if [[ -z "$pr_id" ]]; then
                echo -e "${RED}[-] 错误: 请指定 PR 编号，例如: loopx-flow pr ready 13${NC}" >&2
                exit 1
            fi
            if ! command -v gh >/dev/null 2>&1; then
                echo -e "${RED}[-] 错误: 未安装 gh CLI，无法转换 PR 状态。${NC}" >&2
                exit 1
            fi
            local is_draft
            is_draft="$(gh pr view "$pr_id" --json isDraft --jq '.isDraft' 2>/dev/null || true)"
            if [[ "$is_draft" != "true" ]]; then
                echo -e "${YELLOW}[i] PR #$pr_id 已非 Draft，无需转换。${NC}"
                exit 0
            fi
            if ! gh pr ready "$pr_id"; then
                echo -e "${RED}[-] [FAIL-CLOSED] PR #$pr_id 转 Ready 失败。${NC}" >&2
                exit 1
            fi
            echo -e "${GREEN}[✓] PR #$pr_id 已转为 Ready（不代表合并授权；Gate2 仍须 Mode A/B 授权）。${NC}"
            ;;
        *)
            echo -e "${RED}[-] 未知操作: $sub。可用操作: create, preview, update, ready${NC}" >&2
            exit 1
            ;;
    esac
}

cmd_release_approve() {
    local pr_id="$1" yes="false" arg
    shift || true
    for arg in "$@"; do [[ "$arg" == "--yes" ]] && yes="true"; done
    if [[ -z "$pr_id" ]]; then
        echo "[-] 错误: 请指定 PR 编号，例如: loopx-flow release-approve 12" >&2
        exit 1
    fi
    command -v gh >/dev/null 2>&1 || { echo "[-] [FAIL-CLOSED] release-approve 需要 gh" >&2; exit 1; }
    auth_require_config
    local mode
    mode="$(auth_mode)"
    [[ "$mode" == "single_owner" ]] || { echo "[-] [FAIL-CLOSED] release-approve 只用于 single_owner" >&2; exit 1; }
    [[ "$yes" != "true" ]] || { echo "[-] [FAIL-CLOSED] 不支持 --yes：release-approve 必须真实 TTY 交互确认" >&2; exit 1; }
    local principal accepted_by
    principal="$(gh_login)"
    accepted_by="$(auth_accepted_by)"
    [[ -n "$principal" ]] || { echo "[-] [FAIL-CLOSED] 无法读取 gh api user login" >&2; exit 1; }
    [[ "$principal" == "$accepted_by" ]] || { echo "[-] [FAIL-CLOSED] principal ($principal) != accepted_by ($accepted_by)" >&2; exit 1; }
    [[ -t 0 ]] || { echo "[-] [FAIL-CLOSED] release-approve 必须 TTY 交互确认" >&2; exit 1; }

    local pr_view head_oid head_ref is_draft
    pr_view="$(gh pr view "$pr_id" --json headRefOid,headRefName,isDraft --jq '[.headRefOid, .headRefName, ((.isDraft // false) | tostring)] | join("%")' 2>/dev/null || true)"
    [[ -n "$pr_view" ]] || { echo "[-] [FAIL-CLOSED] 无法读取 PR #$pr_id" >&2; exit 1; }
    IFS="%" read -r head_oid head_ref is_draft <<< "$pr_view"
    [[ "$is_draft" != "true" ]] || { echo "[-] [FAIL-CLOSED] PR #$pr_id 仍为 Draft：先 pr ready，再签发 release-approve。" >&2; exit 1; }
    local feature=""
    if [[ "$head_ref" =~ ^feature/(.+) ]]; then feature="${BASH_REMATCH[1]}"; fi
    [[ -n "$feature" ]] || { echo "[-] [FAIL-CLOSED] PR 分支不是 feature/<name>" >&2; exit 1; }
    local contract_sha
    contract_sha="$(contract_sha_for "$feature" || true)"
    [[ -n "$contract_sha" ]] || { echo "[-] [FAIL-CLOSED] 缺少 feature $feature 的 04-contract.md" >&2; exit 1; }
    local timestamp
    timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    local body
    body="<!-- loopx-flow:release-authorization:$pr_id@$head_oid -->
gate=2;mode=single_owner;head=$head_oid;contract_sha=$contract_sha;principal=$principal;approved_at=$timestamp;risk_acceptance=$(auth_accepted_by)@$(auth_accepted_at)"
    if ! gh pr comment "$pr_id" --body "$body" >/dev/null 2>&1; then
        echo "[-] [FAIL-CLOSED] 写入 release-authorization 评论失败" >&2
        exit 1
    fi
    echo "[✓] Mode B 发布授权已记录到 PR #$pr_id @ $head_oid (principal=$principal)"
}

cmd_status_next() {
    local feature="$1"
    if [[ -z "$feature" ]]; then
        local branch
        branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
        if [[ "$branch" =~ ^feature/(.+) ]]; then feature="${BASH_REMATCH[1]}"; fi
    fi
    [[ -n "$feature" ]] || { echo "[-] 无法解析 feature；请指定 status --next <feature>" >&2; exit 1; }
    echo "Feature: $feature"
    echo "Read-only projection; no state mutation."
    local contract="$PROJECT_ROOT/specs/features/$feature/04-contract.md"
    if [[ ! -f "$contract" ]] || ! grep -q 'FROZEN & APPROVED' "$contract" 2>/dev/null; then
        echo "Next: loopx-flow approve contract $feature"
        echo "Reason: 规格包尚未授权。"
        return 0
    fi
    local evidence="$PROJECT_ROOT/specs/features/$feature/05-evidence.md"
    if [[ ! -f "$evidence" ]] || ! grep -qi 'PASSING' "$evidence" 2>/dev/null; then
        echo "Next: loopx-flow check"
        echo "Reason: 尚未形成有效质量证据。"
        return 0
    fi
    echo "Next: loopx-flow pr ready <pr> && loopx-flow review <pr>"
    echo "Reason: 契约已批准、证据存在；进入交付审查（Gate2 未授权）。"
}

cmd_merge() {
    local pr_id="${1:-}"
    local feature="${2:-}"

    if [[ -z "$pr_id" ]]; then
        echo -e "${RED}[-] 错误: 请指定 PR 编号，例如: loopx-flow merge 12${NC}" >&2
        exit 1
    fi

    local pr_view state merged_at decision head_oid head_ref base_ref
    pr_view="$(gh pr view "$pr_id" --json state,mergedAt,reviewDecision,headRefOid,headRefName,baseRefName --jq '[.state, (.mergedAt // ""), (.reviewDecision // ""), .headRefOid, .headRefName, .baseRefName] | join("%")' 2>/dev/null || echo "")"
    if [[ -z "$pr_view" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 无法读取 PR #$pr_id 状态，禁止合入。${NC}" >&2
        exit 1
    fi
    IFS="%" read -r state merged_at decision head_oid head_ref base_ref <<< "$pr_view"

    if [[ -z "$feature" && "$head_ref" =~ ^feature/(.+) ]]; then
        feature="${BASH_REMATCH[1]}"
    fi
    local auth_mode_val=""
    if [[ -f "$(auth_config_path)" ]]; then auth_mode_val="$(auth_mode)"; fi
    local original_branch
    original_branch="$(git -C "$PROJECT_ROOT" branch --show-current 2>/dev/null || true)"

    echo -e "${BLUE}======================================================================${NC}"
    echo -e "${BLUE}        LoopX 原子 Squash 合并与目标归档核销 (Fail-Closed)            ${NC}"
    echo -e "${BLUE}======================================================================${NC}"

    local already_merged="false"
    if [[ "$state" == "MERGED" || -n "$merged_at" ]]; then
        already_merged="true"
        echo -e "${YELLOW}[i] PR #$pr_id 已处于 MERGED，跳过重复合并与 readiness，进入补偿模式。${NC}"
        # ADR-0012 T9：网页/管理员绕过 loopx-flow merge 时无法阻止，但必须留审计告警
        if [[ -n "$auth_mode_val" ]]; then
            if [[ "$auth_mode_val" == "single_owner" ]]; then
                local merged_contract_sha
                merged_contract_sha="$(contract_sha_for "$feature" 2>/dev/null || true)"
                if [[ -z "$feature" || -z "$merged_contract_sha" ]] || ! release_authorization_ok "$pr_id" "$head_oid" "$merged_contract_sha"; then
                    echo -e "${YELLOW}[WARN] 审计告警：PR #$pr_id 已 MERGED，但缺少绑定当前 head 的 release-authorization；可能为网页/管理员绕过 loopx-flow merge（Mode B 挡不住该路径，仅记录告警）。${NC}" >&2
                fi
            elif [[ "$auth_mode_val" == "independent" ]] && ! mode_a_review_ok "$pr_id" "$head_oid"; then
                echo -e "${YELLOW}[WARN] 审计告警：PR #$pr_id 已 MERGED，但未找到绑定当前 head 的非作者 APPROVED formal review；可能为管理员绕过 ruleset（仅记录告警）。${NC}" >&2
            fi
        fi
        if [[ -z "$head_oid" ]]; then
            head_oid="$(gh pr view "$pr_id" --json headRefOid --jq .headRefOid 2>/dev/null || echo "")"
        fi
    else
        echo -e "${BOLD}[1/4] 正在校验 GitHub PR 决议与 HEAD SHA...${NC}"
        if [[ -n "$auth_mode_val" ]]; then
            if [[ -z "$feature" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 已配置 authorization_mode，但无法从 PR 分支解析 feature/<name>，Gate2 缺少绑定对象。${NC}" >&2
                exit 1
            fi
            if pr_is_draft "$pr_id"; then
                echo -e "${RED}[-] [FAIL-CLOSED] PR #$pr_id 仍为 Draft：先 loopx-flow pr ready，再走 Gate2。${NC}" >&2
                exit 1
            fi
        fi
        if [[ "$auth_mode_val" == "single_owner" ]]; then
            local current_contract_sha
            current_contract_sha="$(contract_sha_for "$feature" || true)"
            if [[ -z "$current_contract_sha" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 缺少 specs/features/$feature/04-contract.md，无法核验 release-authorization 的 contract_sha。${NC}" >&2
                exit 1
            fi
            if ! release_authorization_ok "$pr_id" "$head_oid" "$current_contract_sha"; then
                echo -e "${RED}[-] [FAIL-CLOSED] Mode B 缺少 release-authorization 评论，或 head/contract_sha/principal/risk_acceptance 与当前 PR 不一致${NC}" >&2
                exit 1
            fi
            if ! agent_comment_ok "$pr_id" "$head_oid"; then
                echo -e "${RED}[-] [FAIL-CLOSED] Mode B 当前 head 上缺少 Agent 的 COMMENT review（先 loopx-flow review <pr>）。${NC}" >&2
                exit 1
            fi
            echo -e "    ${GREEN}[✓] Mode B release-authorization 已绑定当前 head/contract，Agent COMMENT 在位${NC}"
        elif [[ "$auth_mode_val" == "independent" ]]; then
            if ! mode_a_review_ok "$pr_id" "$head_oid"; then
                echo -e "${RED}[-] [FAIL-CLOSED] 阻断: PR #$pr_id 未获得绑定当前 head 的非作者 APPROVED formal review（或仍为 Draft）${NC}" >&2
                exit 1
            fi
            echo -e "    ${GREEN}[✓] Mode A formal review 已绑定当前 head${NC}"
        else
            if [[ "$decision" != "APPROVED" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 阻断: PR #$pr_id 尚未在 GitHub 获得人类 APPROVED 审批！(当前状态: ${decision:-<empty>})${NC}" >&2
                echo -e "${RED}    请人类决策者在 GitHub PR 页面核验 8 项事实后点击 Approve，方可执行合并。${NC}" >&2
                exit 1
            fi
            echo -e "    ${GREEN}[✓] GitHub 审查决议确认: APPROVED${NC}"
        fi
        echo -e "    当前 PR 最新 HEAD SHA: ${BOLD}$head_oid${NC}"

        echo -e "\n${BOLD}[2/4] 调用 LoopX 原生合入就绪度物理锁核验 (Fail-Closed)...${NC}"
        if ! command -v loopx >/dev/null 2>&1; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 合入就绪度核验失败: 未检测到 loopx CLI，物理防偷跑锁无法核验，禁止合并。${NC}" >&2
            exit 1
        fi
        if [[ -n "$auth_mode_val" ]]; then
            if ! branch_protection_ok "$auth_mode_val"; then
                exit 1
            fi
            echo -e "    ${GREEN}[✓] 分支保护满足 ${auth_mode_val}（必须走 PR + Four Gates）${NC}"
        fi
        local goal_flag=()
        if [[ -n "$feature" ]]; then
            goal_flag=(--goal-id "${feature}-goal")
        fi
        if [[ "$auth_mode_val" == "single_owner" ]]; then
            if ! mode_b_readiness_ok "$pr_id" "$head_oid" "${feature}-goal"; then
                echo -e "${RED}[-] [FAIL-CLOSED] Mode B readiness 三档判定失败（blocking_reasons 命中允许列表/未知项/缺失）${NC}" >&2
                exit 1
            fi
            echo -e "    ${GREEN}[✓] Mode B readiness 通过${NC}"
        elif [[ "$auth_mode_val" == "independent" ]]; then
            if ! mode_a_readiness_ok "$pr_id" "$head_oid" "${feature}-goal"; then
                echo -e "${RED}[-] [FAIL-CLOSED] Mode A readiness 未 ready=true: PR #$pr_id @ $head_oid${NC}" >&2
                exit 1
            fi
            echo -e "    ${GREEN}[✓] Mode A readiness ready=true${NC}"
        else
            if ! loopx pr-review "${goal_flag[@]}" --check-merge-readiness "${pr_id}@${head_oid}"; then
                echo -e "${RED}[-] [FAIL-CLOSED] LoopX 合入就绪度核验失败: PR #$pr_id @ ${head_oid:-<unknown>} 未通过物理防偷跑锁核验。${NC}" >&2
                exit 1
            fi
            echo -e "    ${GREEN}[✓] 物理防偷跑核验通过${NC}"
        fi
        local head_oid_now
        head_oid_now="$(gh pr view "$pr_id" --json headRefOid --jq .headRefOid 2>/dev/null || echo "$head_oid")"
        if [[ "$head_oid_now" != "$head_oid" ]]; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 合入就绪度核验失败: HEAD SHA 发生漂移 ($head_oid -> $head_oid_now)，禁止合并。${NC}" >&2
            exit 1
        fi
        echo -e "    ${GREEN}[✓] 物理防偷跑核验通过 (Lock: UNLOCKED @ $head_oid)。${NC}"
        echo -e "\n${BOLD}[3/4] 执行原子 Squash 合并并删除特性分支...${NC}"
        if ! gh pr merge "$pr_id" --squash --delete-branch; then
            echo -e "${RED}[-] [FAIL-CLOSED] gh pr merge 失败，禁止继续补偿。${NC}" >&2
            exit 1
        fi
        echo -e "    ${GREEN}[✓] GitHub PR 已成功 Squash 合入主干！${NC}"
    fi

    echo -e "\n${BOLD}[4/4] 特性资产胶囊归档与 Goal 生命周期补偿...${NC}"
    local -a step_names=() step_states=() step_details=()
    local failed=0
    local goal_id=""
    [[ -n "$feature" ]] && goal_id="${feature}-goal"

    if [[ -n "$feature" ]]; then
        if ! command -v loopx >/dev/null 2>&1; then
            echo -e "${RED}[-] [FAIL-CLOSED] 未检测到 loopx CLI，无法完成 Goal 停机/退役/同步补偿。${NC}" >&2
            exit 1
        fi

        local out status
        if out="$(loopx $REGISTRY_FLAG goal-lifecycle --goal-id "$goal_id" --operation stop --actor-kind controller --reason "Feature delivered and archived" --execute 2>&1)"; then
            step_names+=("stop"); step_states+=("done"); step_details+=("")
            echo -e "    ${GREEN}[✓] Goal $goal_id 已停机。${NC}"
        else
            status=$?
            if grep -Eiq "not found in (the )?registry|already stopped|already inactive|no .*transition|unchanged" <<< "$out"; then
                step_names+=("stop"); step_states+=("skipped"); step_details+=("already stopped")
                echo -e "    ${YELLOW}[i] Goal $goal_id 已停机，跳过。${NC}"
            else
                failed=1
                step_names+=("stop"); step_states+=("failed"); step_details+=("$out")
                echo -e "${RED}[-] Goal $goal_id 停机失败: $out${NC}" >&2
            fi
        fi

        if out="$(loopx $REGISTRY_FLAG retire-global-goal --goal-id "$goal_id" --execute 2>&1)"; then
            step_names+=("retire"); step_states+=("done"); step_details+=("")
            echo -e "    ${GREEN}[✓] 全局 Goal $goal_id 已退役。${NC}"
        else
            status=$?
            if grep -Eiq "not found in global registry|already retired|live source_registry|refusing to retire" <<< "$out"; then
                step_names+=("retire"); step_states+=("skipped"); step_details+=("live source registry / already retired")
                echo -e "    ${YELLOW}[i] 全局退役跳过（source registry 仍存活或已退役）。${NC}"
            else
                failed=1
                step_names+=("retire"); step_states+=("failed"); step_details+=("$out")
                echo -e "${RED}[-] 全局 Goal 退役失败: $out${NC}" >&2
            fi
        fi

        if out="$(loopx $REGISTRY_FLAG sync-global --goal-id "$goal_id" 2>&1)"; then
            step_names+=("sync"); step_states+=("done"); step_details+=("")
            echo -e "    ${GREEN}[✓] 全局 registry 已同步 ${goal_id}。${NC}"
        else
            status=$?
            failed=1
            step_names+=("sync"); step_states+=("failed"); step_details+=("$out")
            echo -e "${RED}[-] sync-global 失败: $out${NC}" >&2
        fi
    fi

    if [[ "$failed" -eq 0 && -n "$feature" ]]; then
        if [[ -d "$PROJECT_ROOT/specs/features/$feature" ]]; then
            mkdir -p "$PROJECT_ROOT/specs/archive"
            if mv "$PROJECT_ROOT/specs/features/$feature" "$PROJECT_ROOT/specs/archive/$feature"; then
                step_names+=("archive"); step_states+=("done"); step_details+=("")
                echo -e "    ${GREEN}[✓] 资产包已原子迁移至归档区: specs/archive/$feature/${NC}"
            else
                failed=1
                step_names+=("archive"); step_states+=("failed"); step_details+=("mv failed")
            fi
        elif [[ -d "$PROJECT_ROOT/specs/archive/$feature" ]]; then
            step_names+=("archive"); step_states+=("skipped"); step_details+=("already archived")
            echo -e "    ${YELLOW}[i] 资产包已在归档区，跳过。${NC}"
        else
            step_names+=("archive"); step_states+=("skipped"); step_details+=("no capsule")
        fi
    fi

    if [[ "$failed" -eq 0 && -n "$feature" && "${LOOPX_FLOW_MERGE_SKIP_GIT_SYNC:-0}" != "1" ]]; then
        local base_branch="${base_ref:-main}"
        local dirty
        dirty="$(git -C "$PROJECT_ROOT" status --porcelain --untracked-files=no 2>/dev/null | grep -vE "^(..) (specs/archive/$feature/|specs/features/$feature/|\.loopx/)" || true)"
        if [[ -n "$dirty" ]]; then
            failed=1
            step_names+=("push"); step_states+=("failed"); step_details+=("dirty worktree; base checkout skipped")
            echo -e "${RED}[-] 工作区存在 unrelated 未提交文件，跳过 base 切换（不冒险覆盖）:${NC}" >&2
            echo "$dirty" | sed 's/^/    /' >&2
        elif (cd "$PROJECT_ROOT" && git fetch origin "$base_branch" && git checkout "$base_branch" && git pull --ff-only origin "$base_branch") >/dev/null 2>&1; then
            if (cd "$PROJECT_ROOT" && git add -A --ignore-unmatch -- "specs/archive/$feature" "specs/features/$feature" >/dev/null 2>&1 && ! git diff --cached --quiet); then
                if (cd "$PROJECT_ROOT" && git commit -m "chore($feature): archive capsule after merge" >/dev/null 2>&1 && git push origin "$base_branch" >/dev/null 2>&1); then
                    step_names+=("push"); step_states+=("done"); step_details+=("")
                    echo -e "    ${GREEN}[✓] 本地 $base_branch 已同步并推送 archive 移动。${NC}"
                else
                    failed=1
                    step_names+=("push"); step_states+=("failed"); step_details+=("commit/push failed")
                fi
            else
                step_names+=("push"); step_states+=("skipped"); step_details+=("no archive diff")
            fi
            if [[ -n "$original_branch" && "$original_branch" != "$base_branch" ]] && git -C "$PROJECT_ROOT" rev-parse --verify "$original_branch" >/dev/null 2>&1; then
                git -C "$PROJECT_ROOT" checkout "$original_branch" >/dev/null 2>&1 || true
            fi
        else
            failed=1
            step_names+=("push"); step_states+=("failed"); step_details+=("base refresh failed")
        fi
    fi

    echo -e "\n${BOLD}补偿步骤汇总:${NC}"
    local i
    for i in "${!step_names[@]}"; do
        echo -e "    - ${step_names[$i]}: ${step_states[$i]}${step_details[$i]:+ (${step_details[$i]})}"
    done

    if [[ "$failed" -ne 0 ]]; then
        echo -e "\n${RED}[-] [FAIL-CLOSED] PR #$pr_id 已合入，但 archive/stop/retire/sync 未闭环。${NC}" >&2
        echo -e "🛠️ 修复后重跑: loopx-flow merge $pr_id${feature:+ $feature}" >&2
        exit 1
    fi

    echo -e "\n${GREEN}[✓] PR #$pr_id 交付全流程闭环完成！${NC}"
}
cmd_gate() {
    local subaction="${1:-}"
    local stage="${2:-}"
    local feature="${3:-}"

    if [[ "$subaction" != "verify" ]]; then
        echo -e "${RED}[-] 错误: 目前仅支持 gate verify <stage> <feature>${NC}" >&2
        exit 1
    fi

    if [[ -z "$stage" || -z "$feature" ]]; then
        echo -e "${RED}[-] 错误: 请指定阶段与特性名称，例如: loopx-flow gate verify contract user-auth${NC}" >&2
        exit 1
    fi

    case "$stage" in
        decisions)
            local decision_file="$PROJECT_ROOT/specs/features/$feature/01-decisions.md"
            if [[ ! -f "$decision_file" && -f "$PROJECT_ROOT/specs/archive/$feature/01-decisions.md" ]]; then
                decision_file="$PROJECT_ROOT/specs/archive/$feature/01-decisions.md"
            fi
            if [[ ! -f "$decision_file" ]]; then
                echo -e "${RED}[-] [GATE FAIL] 未找到决策文件: $decision_file${NC}" >&2
                exit 1
            fi
            if ! grep -Eq '^(status:[[:space:]]*APPROVED([[:space:]]|$)|[-*][[:space:]]*\*\*(Status|方案状态)\*\*(:|：).*APPROVED)' "$decision_file"; then
                echo -e "${RED}[-] [GATE FAIL] 阶段 1 架构决策未标记 APPROVED: $decision_file${NC}" >&2
                echo -e "💡 修复指令: 由人类决策者在 decisions frontmatter 落款 'status: APPROVED'（或 '- **Status**: APPROVED'）。" >&2
                exit 1
            fi
            echo -e "${GREEN}[✓] [GATE PASS] 阶段 1 架构决策签名通过: $decision_file${NC}"
            ;;
        contract)
            local contract_file="$PROJECT_ROOT/specs/features/$feature/04-contract.md"
            if [[ ! -f "$contract_file" && -f "$PROJECT_ROOT/specs/archive/$feature/04-contract.md" ]]; then
                contract_file="$PROJECT_ROOT/specs/archive/$feature/04-contract.md"
            fi
            if [[ ! -f "$contract_file" ]]; then
                echo -e "${RED}[-] [GATE FAIL] 未找到契约文件: $contract_file${NC}" >&2
                exit 1
            fi
            if ! grep -q -E "Contract-Status.*FROZEN & APPROVED" "$contract_file"; then
                echo -e "${RED}[-] [GATE FAIL] 阶段 4 契约未冻结或未批准: $contract_file${NC}" >&2
                exit 1
            fi

            # Double-anchor SHA256 physical verification against LoopX locked contract revision
            local current_sha
            if command -v node >/dev/null 2>&1; then
                current_sha="$(node -e 'const fs=require("fs"),crypto=require("crypto");console.log(crypto.createHash("sha256").update(fs.readFileSync(process.argv[1])).digest("hex"))' "$contract_file")"
            elif command -v sha256sum >/dev/null 2>&1; then
                current_sha="$(sha256sum "$contract_file" | awk '{print $1}')"
            else
                current_sha="$(LC_ALL=C shasum -a 256 "$contract_file" | awk '{print $1}')"
            fi

            local goal_id="${feature}-goal"
            local locked_sha=""
            local goal_found="false"
            # 允许测试/CI 用独立 registry 隔离（避免污染真实项目控制面状态，见 ADR-0007 INV-ENV-6）
            local reg_file="${LOOPX_REGISTRY:-$PROJECT_ROOT/.loopx/registry.json}"
            if [[ ! -f "$reg_file" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 本地注册表缺失 ($reg_file)，无法核验控制面契约锁定状态！${NC}" >&2
                echo -e "💡 为什么阻断？契约标记为已冻结，但本地注册表未就绪，禁止绕过物理指纹核验。" >&2
                echo -e "🛠️ 修复指令: 运行 loopx bootstrap 初始化或运行 loopx-flow approve contract $feature 重新锁定。" >&2
                exit 1
            fi

            local check_info
            check_info="$(node -e '
                const fs = require("fs");
                try {
                    const reg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
                    const g = reg.goals?.find(item => item.id === process.argv[2] || item.goal_id === process.argv[2] || item.id === process.argv[3] || item.goal_id === process.argv[3]);
                    if (!g) {
                        process.stdout.write("NOT_FOUND:");
                    } else {
                        const rev = g?.control_plane?.progress_review?.contract_revision || g?.progress_review?.contract_revision || "";
                        process.stdout.write("FOUND:" + rev);
                    }
                } catch (e) {
                    process.stdout.write("NOT_FOUND:");
                }
            ' "$reg_file" "$goal_id" "${feature}-feature" 2>/dev/null || echo "NOT_FOUND:")"

            if [[ "$check_info" =~ ^FOUND:(.*) ]]; then
                goal_found="true"
                locked_sha="${BASH_REMATCH[1]}"
            fi

            if [[ "$goal_found" != "true" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 目标实体未在 LoopX 注册 (GOAL_NOT_FOUND: $goal_id)！${NC}" >&2
                echo -e "💡 为什么阻断？契约标记为 FROZEN & APPROVED，但注册表中未登记对应 Goal，存在虚假审批或状态脱管风险。" >&2
                echo -e "🛠️ 修复指令: 由决策者执行审批以锁定指纹: loopx-flow approve contract $feature" >&2
                exit 1
            fi

            if [[ -z "$locked_sha" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 契约尚未在 LoopX 控制面锁定指纹 (MISSING_LOCKED_CONTRACT_REVISION)！${NC}" >&2
                echo -e "    Goal: $goal_id 存在于 .loopx/registry.json 但未设置 progress_review.contract_revision" >&2
                echo -e "💡 为什么阻断？双重锚定要求契约必须具备控制面物理指纹锁定，缺失物理锁定视为未完成审批。" >&2
                echo -e "🛠️ 修复指令: 由决策者执行审批以锁定指纹: loopx-flow approve contract $feature" >&2
                exit 1
            fi

            if [[ "$locked_sha" != "$current_sha" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 契约已被篡改 (CONTRACT_TAMPERED)! 契约指纹不一致，门禁物理熔断！${NC}" >&2
                echo -e "    文件当前 SHA256: ${BOLD}$current_sha${NC}" >&2
                echo -e "    已锁定基线指纹: ${BOLD}$locked_sha${NC}" >&2
                echo -e "💡 为什么阻断？契约在批准后发生非授权变更，严禁在未重新审批的情况下私自变更接口与断言不变量。" >&2
                echo -e "🛠️ 修复指令: 还原契约文件修改，或由决策者重新执行: loopx-flow approve contract $feature" >&2
                exit 1
            fi
            gate1_verify_authorization "$feature" "$current_sha"
            echo -e "${GREEN}[✓] [GATE PASS] 阶段 4 契约双重锚定核验通过 (SHA256: $current_sha)${NC}"
            ;;
        *)
            echo -e "${RED}[-] 未知守卫阶段: $stage (可选: decisions, contract)${NC}" >&2
            exit 1
            ;;
    esac
}

cmd_context() {
    local feature="${1:-}"
    if [[ -z "$feature" ]]; then
        echo -e "${RED}[-] 错误: 请指定特性名称，例如: loopx-flow context hard-guard${NC}" >&2
        exit 1
    fi

    local index_file="$PROJECT_ROOT/specs/features/$feature/00-INDEX.md"
    if [[ -f "$index_file" ]]; then
        cat "$index_file"
    else
        echo -e "${YELLOW}未找到特性胶囊: $index_file${NC}"
    fi
}

cmd_archive() {
    local feature="${1:-}"
    if [[ -z "$feature" ]]; then
        echo -e "${RED}[-] 错误: 请指定特性名称，例如: loopx-flow archive hard-guard${NC}" >&2
        exit 1
    fi

    local source_dir="$PROJECT_ROOT/specs/features/$feature"
    local archive_dir="$PROJECT_ROOT/specs/archive/$feature"

    if [[ -d "$source_dir" ]]; then
        mkdir -p "$PROJECT_ROOT/specs/archive"
        mv "$source_dir" "$archive_dir"
        echo -e "${GREEN}[✓] 特性 $feature 已成功归档至: specs/archive/$feature/${NC}"
    else
        echo -e "${YELLOW}未找到特性目录: $source_dir${NC}"
    fi
}

cmd_issue() {
    local issue_id="${1:-}"
    shift || true

    if [[ -z "$issue_id" ]]; then
        echo -e "${RED}[-] 错误: 请指定 Issue 编号，例如: loopx-flow issue 123${NC}" >&2
        exit 1
    fi

    if ! command -v loopx >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] 未检测到 loopx CLI，无法执行 LoopX 原生缺陷可行性裁决。${NC}" >&2
        exit 1
    fi
    if ! command -v gh >/dev/null 2>&1; then
        echo -e "${RED}[-] 错误: 未安装 gh CLI，无法提取 Issue 真实元数据。${NC}" >&2
        exit 1
    fi

    # 解析 Agent 观察量 (reproduction / scope)
    local repro="missing" scope="uncertain"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --reproduction)
                repro="$2"; shift 2 ;;
            --scope)
                scope="$2"; shift 2 ;;
            *)
                shift ;;
        esac
    done

    echo -e "${BLUE}==> 正在提取 GitHub Issue #$issue_id 真实元数据...${NC}"
    local issue_json repo_label
    issue_json="$(gh issue view "$issue_id" --json number,title,state 2>/dev/null || echo '{}')"
    repo_label="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || echo '')"

    local issue_title
    issue_title="$(node -e '
const fs = require("fs");
let d = {};
try { d = JSON.parse(fs.readFileSync(0, "utf8")); } catch (e) {}
process.stdout.write(String(d.title ?? ""));
' <<< "$issue_json")"

    echo -e "    Issue 标题: ${BOLD}${issue_title:-<unknown>}${NC} | Repo: ${BOLD}${repo_label:-unknown}${NC}"
    echo -e "    观察量: reproduction=$repro | scope=$scope"
    echo -e "${BLUE}==> 调用 LoopX issue-fix feasibility 执行因果路由裁决...${NC}"

    local feasibility_json
    if ! feasibility_json="$(loopx $REGISTRY_FLAG issue-fix feasibility \
        --repo "$repo_label" \
        --issue-ref "$issue_id" \
        --reproduction-status "$repro" \
        --scope-class "$scope" \
        --format json)"; then
        echo -e "${RED}[-] [FAIL-CLOSED] LoopX 缺陷可行性裁决失败: Issue #$issue_id 无法获取因果路由，操作已阻断。${NC}" >&2
        exit 1
    fi

    local route rationale
    # 路由事实在 decision.route（LoopX issue-fix schema），不在顶层 route（ADR-0012 决策 7）
    route="$(node -e '
const fs = require("fs");
let d = {};
try { d = JSON.parse(fs.readFileSync(0, "utf8")); } catch (e) {}
const decision = (d && typeof d.decision === "object" && d.decision) ? d.decision : {};
process.stdout.write(String(decision.route ?? ""));
' <<< "$feasibility_json")"
    rationale="$(node -e '
const fs = require("fs");
let d = {};
try { d = JSON.parse(fs.readFileSync(0, "utf8")); } catch (e) {}
const decision = (d && typeof d.decision === "object" && d.decision) ? d.decision : {};
process.stdout.write(String(decision.rationale ?? ""));
' <<< "$feasibility_json")"

    if [[ -z "$route" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] LoopX issue-fix feasibility 未输出 decision.route (fix_pr|comment_only|triage_only)，操作已阻断。${NC}" >&2
        exit 1
    fi

    echo -e "    ${GREEN}[✓] LoopX 因果路由裁决: ${BOLD}$route${NC}${GREEN}${rationale:+ ($rationale)}${NC}"
    case "$route" in
        fix_pr)
            echo -e "  - 裁决为 ${BOLD}标准 PR 修复管线${NC}: 建立 tests/unit/issues/issue-$issue_id.test.ts 先红后绿，随后走 feature 胶囊管线与 PR 审查。"
            ;;
        comment_only)
            echo -e "  - 裁决为 ${BOLD}仅评论响应${NC}: 在 GitHub Issue #$issue_id 补充澄清/诊断评论，不启动代码修复。"
            ;;
        triage_only)
            echo -e "  - 裁决为 ${BOLD}仅分诊处理${NC}: 记录分诊结论并更新 Issue 标签，等待更多信息后再评估。"
            ;;
        *)
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 输出未知路由: $route，请人工核查。${NC}" >&2
            exit 1
            ;;
    esac
}

cmd_integrate() {
    local mode="sync"
    local execute=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --execute)
                execute=true; shift ;;
            --status)
                mode="status"; shift ;;
            *)
                shift ;;
        esac
    done

    if ! command -v loopx >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] 未检测到 loopx CLI，无法执行 LoopX 原生集成分支预演。${NC}" >&2
        exit 1
    fi

    if [[ "$mode" == "status" ]]; then
        echo -e "${BLUE}==> 正在查询 LoopX 集成分支状态 (base/source/integration heads)...${NC}"
        if ! loopx $REGISTRY_FLAG integration-branch status --repo-path "$PROJECT_ROOT"; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 集成分支状态查询失败，请核查 integration-branch configure。${NC}" >&2
            exit 1
        fi
        return 0
    fi

    if [[ "$execute" == "true" ]]; then
        echo -e "${BLUE}==> 正在执行 LoopX 本地集成合入 (temporary worktree, --execute)...${NC}"
        if ! loopx $REGISTRY_FLAG integration-branch sync --repo-path "$PROJECT_ROOT" --execute; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 本地集成合入失败: 源头未按序合入，操作已阻断。${NC}" >&2
            exit 1
        fi
        echo -e "${GREEN}[✓] 本地预集成已落盘完成。${NC}"
    else
        echo -e "${BLUE}==> 正在预演 LoopX 本地集成 (preview, 不落盘)...${NC}"
        if ! loopx $REGISTRY_FLAG integration-branch sync --repo-path "$PROJECT_ROOT"; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 本地集成预演失败，操作已阻断。${NC}" >&2
            exit 1
        fi
        echo -e "${YELLOW}[i] 预演模式未落盘；确认无误后执行: loopx-flow integrate --execute${NC}"
    fi
}

cmd_status() {
    if command -v loopx >/dev/null 2>&1; then
        loopx $REGISTRY_FLAG status || true
    else
        echo -e "${YELLOW}[!] 未安装 loopx CLI。正在显示本地 specs/features/ 状态:${NC}"
        ls -la "$PROJECT_ROOT/specs/features" || true
    fi
}

# 从显式参数或当前 feature 分支推导 LoopX Goal ID
resolve_goal_id() {
    local explicit_goal="${1:-}"
    if [[ -n "$explicit_goal" ]]; then
        echo "$explicit_goal"
        return 0
    fi
    local branch
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
    if [[ "$branch" =~ ^feature/(.+) ]]; then
        echo "${BASH_REMATCH[1]}-goal"
        return 0
    fi
    return 1
}

cmd_todo() {
    local subaction="${1:-list}"
    shift || true

    if ! command -v loopx >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] 未检测到 loopx CLI，无法调度 LoopX 原生控制面命令。${NC}" >&2
        exit 1
    fi

    case "$subaction" in
        list)
            loopx $REGISTRY_FLAG todo list "$@"
            ;;
        claim|done)
            cmd_todo_lease "$subaction" "$@"
            ;;
        *)
            loopx $REGISTRY_FLAG todo "$subaction" "$@"
            ;;
    esac
}

cmd_todo_lease() {
    local mode="$1"
    shift

    local todo_id="" goal_id="" agent_id="" identity_key=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --goal-id)
                goal_id="$2"; shift 2 ;;
            --owner|--agent-id)
                agent_id="$2"; shift 2 ;;
            --idempotency-key)
                identity_key="$2"; shift 2 ;;
            *)
                if [[ -z "$todo_id" ]]; then todo_id="$1"; fi; shift ;;
        esac
    done

    if [[ -z "$todo_id" ]]; then
        echo -e "${RED}[-] 错误: 请指定 Todo ID，例如: loopx-flow todo claim todo_ab12cd34ef56${NC}" >&2
        exit 1
    fi

    if [[ -z "$goal_id" ]]; then
        goal_id="$(resolve_goal_id)" || {
            echo -e "${RED}[-] [FAIL-CLOSED] 无法推导 Goal ID: 当前分支非 feature/* 且未显式传入 --goal-id。${NC}" >&2
            exit 1
        }
    fi

    # LoopX 硬约束：lease owner 必须是已注册 Agent；idempotency-key 支撑幂等重试（issue #12）
    agent_id="${agent_id:-${LOOPX_AGENT_ID:-loopx-flow-agent}}"
    identity_key="${identity_key:-loopx-flow:${mode}:${goal_id}:${todo_id}:${agent_id}}"
    if ! loopx $REGISTRY_FLAG register-agent --goal-id "$goal_id" --agent-id "$agent_id" --execute >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] register-agent 失败: agent=$agent_id goal=$goal_id${NC}" >&2
        exit 1
    fi

    if [[ "$mode" == "claim" ]]; then
        echo -e "${BLUE}==> [租约流转] 正在申领排他租约: $todo_id @ $goal_id (owner=$agent_id)...${NC}"
        if ! loopx $REGISTRY_FLAG task-lease acquire --goal-id "$goal_id" --todo-id "$todo_id" --owner "$agent_id" --idempotency-key "$identity_key"; then
            echo -e "${RED}[-] [FAIL-CLOSED] 租约申领失败: Todo $todo_id 可能已被其他 Agent 持有，操作已阻断。${NC}" >&2
            exit 1
        fi
        echo -e "    idempotency-key: $identity_key"
        echo -e "${GREEN}[✓] 排他租约已获取 (ACQUIRED): $todo_id${NC}"
    else
        echo -e "${BLUE}==> [租约流转] 正在完成 Todo 并释放租约: $todo_id @ $goal_id (owner=$agent_id)...${NC}"
        if ! loopx $REGISTRY_FLAG todo --goal-id "$goal_id" --todo-id "$todo_id" --status done; then
            echo -e "${RED}[-] [FAIL-CLOSED] Todo 完成回写失败: $todo_id，租约保留以便重试。${NC}" >&2
            exit 1
        fi
        local inspect_json lease_version
        inspect_json="$(loopx --format json $REGISTRY_FLAG task-lease inspect --goal-id "$goal_id" --todo-id "$todo_id" 2>/dev/null || true)"
        lease_version="$(node -e '
let d = {};
try { d = JSON.parse(process.argv[1]); } catch (_) { process.exit(0); }
const v = d.version ?? (d.lease && d.lease.version) ?? d.lease_version ?? (d.lease_state && d.lease_state.version) ?? "";
process.stdout.write(v === null || v === undefined ? "" : String(v));
' "$inspect_json" 2>/dev/null || true)"
        if [[ -z "$lease_version" ]]; then
            echo -e "${RED}[-] [FAIL-CLOSED] 无法从 task-lease inspect 读取租约版本，拒绝盲释放。${NC}" >&2
            exit 1
        fi
        if ! loopx $REGISTRY_FLAG task-lease release --goal-id "$goal_id" --todo-id "$todo_id" --owner "$agent_id" --idempotency-key "$identity_key" --expected-version "$lease_version"; then
            echo -e "${RED}[-] [FAIL-CLOSED] 租约释放失败: $todo_id，请通过 task-lease inspect 人工核查。${NC}" >&2
            exit 1
        fi
        echo -e "${GREEN}[✓] Todo 已完成且排他租约已释放 (RELEASED): $todo_id${NC}"
    fi
}

# 命令路由
ACTION="${1:-help}"
shift || true

case "$ACTION" in
    feature|start) cmd_feature "$@" ;;
    approve) cmd_approve "$@" ;;
    check) cmd_check "$@" ;;
    pr) cmd_pr "$@" ;;
    review) cmd_review "$@" ;;
    respond) cmd_respond "$@" ;;
    merge) cmd_merge "$@" ;;
    release-approve) cmd_release_approve "$@" ;;
    gate) cmd_gate "$@" ;;
    context) cmd_context "$@" ;;
    archive) cmd_archive "$@" ;;
    issue) cmd_issue "$@" ;;
    integrate) cmd_integrate "$@" ;;
    doctor) cmd_doctor "$@" ;;
    init) cmd_init "$@" ;;
    status)
        if [[ "$1" == "--next" ]]; then shift; cmd_status_next "$@"; else cmd_status "$@"; fi ;;
    todo) cmd_todo "$@" ;;
    help|--help|-h) usage ;;
    *)
        echo -e "${RED}[-] 未知命令: $ACTION${NC}\n" >&2
        usage
        exit 1
        ;;
esac
