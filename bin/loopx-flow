#!/usr/bin/env bash
# ==============================================================================
# loopx-flow: LoopX AI-Native 研发与交付流场景化命令编排器 (v2.0)
# 核心场景：Feature 资产胶囊开发、Issue 缺陷自适应修复、断点审批与质量收据融合
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKFLOW_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
# shellcheck source=../lib/paths.sh
source "$WORKFLOW_ROOT/lib/paths.sh"
# 集中式三层能力探针（ADR-0010 决策 4 / ADR-0015 决策 4）：doctor 与各 L0 命令共用同一矩阵。
CAPABILITY_PROBE_LIB="$WORKFLOW_ROOT/lib/capability-probe.js"

# 路由前解析全局选项：支持 `loopx-flow --registry <path> <command> ...`（D1 / R15）
CLI_REGISTRY=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --registry)
            if [[ $# -lt 2 || -z "${2:-}" ]]; then
                echo "[-] [FAIL-CLOSED] --registry 需要指定文件路径" >&2
                exit 2
            fi
            CLI_REGISTRY="$2"
            shift 2
            ;;
        --registry=*)
            CLI_REGISTRY="${1#--registry=}"
            if [[ -z "$CLI_REGISTRY" ]]; then
                echo "[-] [FAIL-CLOSED] --registry= 需要指定文件路径" >&2
                exit 2
            fi
            shift
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

wf_init_paths "$CLI_REGISTRY"
# 兼容别名：PROJECT_ROOT 统一指向目标仓库根（EFFECTIVE_ROOT），静态脚本/技能资产统一走 WORKFLOW_ROOT。
PROJECT_ROOT="$EFFECTIVE_ROOT"
REGISTRY_FLAG="$(wf_registry_display_flag)"
export LOOPX_TMP_DIR

# 安全数组调用 loopx，完整保留含空格的 registry 路径（R15）。
run_loopx() {
    if [[ "${#REGISTRY_ARGS[@]}" -gt 0 ]]; then
        loopx "${REGISTRY_ARGS[@]}" "$@"
    else
        loopx "$@"
    fi
}

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# 集中式三层能力探针（ADR-0010 决策 4 / ADR-0015 决策 4）。
# 第 1 层：真实子命令 --help 的必填 Flag / 子命令签名；第 2 层：schema_version 白名单；
# 第 3 层：loopx --version 软提示。全部逻辑集中在 lib/capability-probe.js，避免口径漂移。
# 用法: probe_loopx_capabilities [--scope doctor|issue|integrate|todo|...] [--format text|json|quiet]
probe_loopx_capabilities() {
    local scope="doctor" format="text"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --scope|--command)
                scope="${2:-doctor}"; shift 2 ;;
            --format)
                format="${2:-text}"; shift 2 ;;
            *)
                shift ;;
        esac
    done
    node "$CAPABILITY_PROBE_LIB" matrix --scope "$scope" --format "$format"
}

# L0 命令的 Fail-Closed 能力门：BLOCK 能力缺失或探测 UNKNOWN → 非 0 阻断并输出升级差异诊断卡。
# 用法: require_loopx_capabilities <issue|integrate|todo|check|merge|review|...>
# 成功路径只验能力、不污染 stdout（`--format quiet` 抑制成功矩阵，防脚本管道受污染）；失败时诊断卡经 stderr 呈现。
require_loopx_capabilities() {
    local scope="${1:-doctor}"
    node "$CAPABILITY_PROBE_LIB" require --scope "$scope" --format quiet
}

# 第 2 层：消费任何 LoopX --format json 载荷前校验 schema_version 白名单。
# 用法: assert_loopx_schema_version <consumer> <raw-output>；不在白名单时非 0 并输出诊断卡。
assert_loopx_schema_version() {
    local consumer="$1" raw="${2:-}"
    printf '%s' "$raw" | node "$CAPABILITY_PROBE_LIB" assert-schema --consumer "$consumer" >/dev/null
}

# 唯一的 LoopX JSON 读取入口：所有消费 `--format json` 载荷的位置都必须经过这里，
# 第 2 层 schema_version 白名单校验只在这一个 wrapper 里执行（不得在调用点各抄一份）。
# 用法: read_loopx_json <consumer> <loopx 参数...>
# 语义：命令本身非 0 → stdout 原样返回、状态码原样透出（由调用方决定是否 fail-closed）；
#       命令成功但载荷 schema 不在白名单 → **不输出载荷**到 stdout（防止上层把旧契约当成功解析），
#       诊断卡与载荷都写 stderr，并返回 1。
read_loopx_json() {
    local consumer="$1"; shift
    local raw rc=0
    raw="$(run_loopx "$@")" || rc=$?
    if [[ "$rc" -ne 0 ]]; then
        printf '%s' "$raw"
        return "$rc"
    fi
    if ! assert_loopx_schema_version "$consumer" "$raw"; then
        printf '%s\n' "$raw" >&2
        echo -e "${RED}[-] [FAIL-CLOSED] LoopX ${consumer} 载荷 schema_version 不在白名单，禁止按成功解析。${NC}" >&2
        return 1
    fi
    printf '%s' "$raw"
}

# L0 命令 → 能力 scope 的单一映射：能力门只在 dispatch 边界按这里声明的 scope 执行一次，
# 命令实现内不再各抄一份手工门（review #73 P0）。
dispatch_capability_scope() {
    case "${1:-}" in
        feature|start) printf 'feature' ;;
        check) printf 'check' ;;
        pr) printf 'pr' ;;
        review) printf 'review' ;;
        merge) printf 'merge' ;;
        release-approve) printf 'release-approve' ;;
        *) return 1 ;;
    esac
}

# 按仓库真实存在的远程默认基线解析：origin/HEAD → origin/main → origin/master（GitHub Issue #13）。
# 单一事实源在 ingest-to-loopx-quality.js#discoverBaseRef；shell 侧只做委托与降级，避免两处逻辑漂移。
resolve_change_quality_base_ref() {
    local ref
    ref="$(wf_discover_base_ref "$PROJECT_ROOT" || true)"
    [[ -n "$ref" ]] && { printf '%s' "$ref"; return 0; }
    return 1
}

# Goal 未启用 change-quality 资格时，fail-closed 输出诊断卡（原因 + 可执行修复命令）。
# 用法: preflight_change_quality_qualification <goal-id> [check|doctor]
#   check  → 资格未启用直接 exit 1（前置阻断，不等四大门禁跑完）
#   doctor → 返回 1 供体检汇总为 WARN（doctor 是阶段 0 体检，不作为交付门禁）
preflight_change_quality_qualification() {
    local goal_id="${1:-}" mode="${2:-check}" base_ref payload verdict prepare_rc
    [[ -n "$goal_id" ]] || return 0
    command -v loopx >/dev/null 2>&1 || return 0
    base_ref="$(resolve_change_quality_base_ref || true)"
    [[ -n "$base_ref" ]] || base_ref="origin/main"
    # 分离捕获退出码与 JSON 输出：严禁用 `|| echo '{}'` 拼接，否则 prepare 失败时双 JSON
    # 会让 JSON.parse 失败并回落空对象，UNKNOWN 被误判为 OK，跳过前置阻断空跑四大门禁。
    prepare_rc=0
    payload="$(read_loopx_json change-quality.prepare change-quality prepare --goal-id "$goal_id" --repo-path "$PROJECT_ROOT" --base-ref "$base_ref" --format json)" || prepare_rc=$?
    verdict="$(node -e '
let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
let p={};try{p=JSON.parse(d)}catch(_){}
if(p.ok===false)process.stdout.write("UNKNOWN");
else if(p.status==="disabled"||(p.policy&&p.policy.enabled===false))process.stdout.write("DISABLED");
else process.stdout.write("OK");
})' <<< "$payload")"
    if [[ "$prepare_rc" -ne 0 ]]; then
        verdict="UNKNOWN"
    fi
    if [[ "$verdict" == "DISABLED" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] Goal '$goal_id' 未启用 change-quality 资格，无法生成质量收据。${NC}" >&2
        echo -e "[-] 为什么阻断？资格未启用时 loopx change-quality record 会以 \"qualification is disabled for this goal\" 拒绝。" >&2
        echo -e "💡 原因：Goal 的 control_plane.change_quality_qualification.enabled 未打开，收据无法写入。" >&2
        echo -e "🛠️ 修复指令: loopx configure-goal --goal-id $goal_id --change-quality-enabled --execute" >&2
        [[ "$mode" == "check" ]] && exit 1
        return 1
    fi
    if [[ "$verdict" == "UNKNOWN" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 无法判定 Goal '$goal_id' 的 change-quality 资格（prepare 非零退出或返回 ok=false），禁止放行。${NC}" >&2
        echo -e "[-] 为什么阻断？资格状态 UNKNOWN 时生成的质量收据不可信；check 不得空跑四大门禁后进入交付。" >&2
        echo -e "    prepare 退出码: ${prepare_rc}；prepare 输出: ${payload:0:400}" >&2
        echo -e "💡 原因：Goal 未注册 / 控制面异常 / 基线不可解析，导致 loopx change-quality prepare 失败。" >&2
        echo -e "🛠️ 修复指令: 确认 Goal 已注册并启用资格: loopx configure-goal --goal-id $goal_id --change-quality-enabled --execute" >&2
        echo -e "🛠️ 诊断指令: loopx change-quality prepare --goal-id $goal_id --base-ref $base_ref --format json" >&2
        [[ "$mode" == "check" ]] && exit 1
        return 1
    fi
    return 0
}

usage() {
    cat << 'USAGETXT'
===============================================================================
  LoopX AI-Native Flow Orchestrator (loopx-flow v2.0)
===============================================================================

用法:
  loopx-flow [--registry <path>] <command> [arguments...]

核心场景指令:
  feature <name>          开启新特性管线，生成 specs/features/<name> 资产包与 Goal (阶段 0~4)
  approve contract <name> [--prepare|--interactive]
                          【断点 1】规格授权：默认校验 accepted_by 的 GitHub gate=1 评论；
                          --prepare 打印评论模板；--interactive 走本机 TTY
  check [--with-ocr] [--goal-id <gid>]
                          执行四大硬门禁与代码审查，生成并校验 LoopX change-quality 严格收据
                          （fix/issue-<id> 分支自动绑定 issue-<id>-goal；Issue 路径不写 05-evidence）
  pr <action> [feature]   按 PR #7545 官方标准从胶囊生成 4-Part 描述并提交/预览/更新 PR (create|preview|update|ready)
                          pr create|update --issue <id> 用 Issue 正文生成 body 并写 loopx-meta / loopx-impact 标记
                          pr update <pr> [--title <t>] 同时修正标题，避免标题宣称未交付范围
  review <pr_id> [--model <id>] [--reasoning-effort <level>]
                          执行 L2 交付审查并顶置 LoopX 原生五段式评审报告（复用 pr-review review_template）
                          可选透传模型与推理强度（CLI > REVIEW_MODEL / REVIEW_REASONING_EFFORT > runtime 默认）。
                          未传且未设置环境变量时不附加参数。详见 review --help。
  respond <pr_id>         复用 LoopX 原生五段式格式提交针对 Review findings 的逐项闭环汇报
  merge <pr_id> [feature] [--goal-id <gid>]
                          【断点 2】按 authorization_mode 核验 Mode A/B 授权与 readiness，Squash 合入并原子归档
                          fix/issue-<id> 自动绑定 issue-<id>-goal 并核验 loopx-impact 分级
  release-approve <pr> [--prepare|--interactive]
                          【断点 2 / Mode B】默认校验 accepted_by 的 GitHub gate=2 评论；
                          --prepare 打印评论模板；--interactive 走 TTY 并写评论
  issue <issue_id> [--goal-id <gid>] [--impact R0|R1|R2] [--init-goal] [--execute]
                          Issue 修复管线：feasibility 因果路由 + workflow-plan；--execute 才建/领 fix/issue-<id>
                          （默认 dry-run 不写 domain state；--execute 必须绑定每 Issue Goal）
        [--reproduction confirmed|planned|missing|blocked] [--scope bounded|uncertain|oversized]
        [--reproduction-label <l>] [--validation-label <l>] [--comment-value none|clarification|diagnosis]
        [--repository-context-json <path|->]   观察量决定 fix_pr 路由；label 缺失时用公开安全默认值
  integrate [--execute|--status]  LoopX 集成分支本地预集成 (默认 preview 不落盘)
  context <feature>       生成当前特性的长程上下文胶囊，供开发者与 AI Agent 快速穿透审阅
  archive <feature>       原子归档已合入特性的资产包 (specs/features/ -> specs/archive/)
  gate verify <stage> <f> 阶段流转物理熔断守卫 (decisions | contract)
  doctor                  前置环境与 LoopX 就绪度全维评分 (preflight + loopx doctor + 能力矩阵)
  capabilities [--scope s] [--format text|json]
                          三层能力探针：--help 签名 / schema_version 白名单 / 版本软提示（doctor 视图不阻断）
  gc [--days N] [--force] 并发安全清理 .loopx/cache/reviews/ 与 .loopx/tmp/ 过期工件（默认 14 天，1h 活跃保护）
  init                    初始化项目工作流骨架、依赖及本地 LoopX 连接
  status                  查看当前 Goal 进度、任务看板与注意力队列 (loopx status)
  status --next [feature] 只读投影 + 下一步建议（不写 Goal/Todo/Lease/Gate，不是 resume）
  todo list [goal_id]     列出指定或当前 Goal 下的全部 Agent / User Todos
  todo claim <tid>        受管认领 Todo (loopx todo claim)，缓存 claim_operation_id 五元组凭证
                          先读完 agent-directory 分页解析已注册 owner；多个身份时设置 LOOPX_AGENT_ID。
                          未注册则 Fail-Closed，并打印 loopx register-agent ... --execute
  todo done <tid>         受管完成 Todo (loopx todo complete)，优先复用 --claim-operation-id 或缓存凭证
                          缓存缺失/失效时仅在有效且同 Owner 时自动补领；过期/释放/转让/deferred 一律停机
  help, --help, -h        显示本帮助信息

USAGETXT
}

# 控制面一致性 + GitHub API 预算基线检查（环境治理，见 ADR-0007）
# 只做「诊断 + 可执行修复指令」，不在此处硬阻断（doctor 是阶段 0 体检，不是交付门禁）。
cmd_doctor_control_plane() {
    local fail=0
    echo -e "\n${BLUE}==> [2/3] 控制面一致性检查 (runtime route / registry / 运行时工件)...${NC}"

    # 1. runtime root 路由与项目 registry 声明是否一致
    # 统一 JSON wrapper：schema_version 白名单校验在此生效；doctor 属诊断视图，
    # 校验失败时降级为 WARN（下方 runtime_root 为空即告警），不硬阻断体检。
    local route_json runtime_root declared_root
    route_json="$(read_loopx_json status --format json status || echo '{}')"
    runtime_root="$(node -e '
const firstJson=(s)=>{let depth=0,inStr=false,esc=false;for(let i=0;i<s.length;i++){const c=s[i];if(inStr){if(esc){esc=false}else if(c==="\\"){esc=true}else if(c==="\""){inStr=false}continue}if(c==="\""){inStr=true;continue}if(c==="{"){depth++}else if(c==="}"){depth--;if(depth===0)return s.slice(0,i+1)}}return null};
let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{let out="";try{out=JSON.parse(d).runtime_root||""}catch(_){const j=firstJson(d);if(j){try{out=JSON.parse(j).runtime_root||""}catch(__){}}}process.stdout.write(out)})' <<< "$route_json")"
    declared_root="$(node -e '
const fs=require("fs");
try{const r=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));process.stdout.write(r.common_runtime_root||"")}catch(_){}
' "$LOOPX_REGISTRY_PATH" 2>/dev/null)"
    if [[ ! -f "$LOOPX_REGISTRY_PATH" ]]; then
        if [[ "$LOOPX_REGISTRY_EXPLICIT" -eq 0 ]] && wf_is_linked_worktree "$PROJECT_ROOT"; then
            local hint=""
            hint="$(wf_main_checkout_registry_hint "$PROJECT_ROOT" || true)"
            echo -e "${YELLOW}[WARN] 当前附属 worktree 缺少 LoopX registry: $LOOPX_REGISTRY_PATH${NC}"
            echo -e "       🛠️ 修复: loopx bootstrap --project \"$PROJECT_ROOT\" 或显式指定 --registry \"${hint:-<主 checkout>/.loopx/registry.json}\""
            fail=1
        else
            echo -e "${YELLOW}[WARN] 本地 LoopX registry 缺失: $LOOPX_REGISTRY_PATH${NC}"
            fail=1
        fi
    fi
    if [[ -n "$runtime_root" && -n "$declared_root" && "$runtime_root" != "$declared_root" ]]; then
        echo -e "${YELLOW}[WARN] runtime root 不一致: 生效=$runtime_root 项目声明=$declared_root${NC}"
        echo -e "       🛠️ 修复: loopx bootstrap --project . --goal-id <goal> 重新同步，或统一 registry 的 common_runtime_root"
        fail=1
    elif [[ -n "$runtime_root" ]]; then
        echo -e "${GREEN}[✓] runtime root 路由一致: $runtime_root${NC}"
    fi

    # 2. 目标路由 ~/.loopx 是否被半迁移残留占用（会阻塞 migrate-local-state）
    if [[ -d "$HOME/.loopx" ]]; then
        local residue_count
        residue_count="$(find "$HOME/.loopx" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')"
        if [[ ! -f "$HOME/.loopx/registry.global.json" && "$residue_count" -gt 0 ]]; then
            echo -e "${YELLOW}[WARN] ~/.loopx 存在半迁移残留（$residue_count 项，无 registry.global.json）→ 会阻塞 loopx migrate-local-state${NC}"
            echo -e "       🛠️ 修复: 先备份后移除残留（示例）: mkdir -p ~/.loopx-backup && mv ~/.loopx/* ~/.loopx-backup/ && rmdir ~/.loopx"
            fail=1
        fi
    fi

    # 3. registry 中缺 state_file 的畸形 goal 记录
    local bad_goals
    bad_goals="$(node -e '
const fs=require("fs"),os=require("os"),path=require("path");
const files=[process.argv[1],path.join(os.homedir(),".loopx","registry.global.json"),path.join(process.argv[2],"loopx","registry.global.json")];
const bad=[];
for(const f of files){try{const d=JSON.parse(fs.readFileSync(f,"utf8"));for(const g of (d.goals||[])){if(g&&g.id&&!g.state_file)bad.push(f+"#"+g.id)}}catch(_){}}
process.stdout.write([...new Set(bad)].join(" "))
' "$LOOPX_REGISTRY_PATH" "$(wf_codex_home)" 2>/dev/null)"
    if [[ -n "$bad_goals" ]]; then
        echo -e "${YELLOW}[WARN] registry 存在缺 state_file 的 goal（会阻塞迁移/审批）: $bad_goals${NC}"
        echo -e "       🛠️ 修复: 补 state_file 指向 <project>/.codex/goals/<goal>/ACTIVE_GOAL_STATE.md，或 retire 该 goal"
        fail=1
    else
        echo -e "${GREEN}[✓] registry goal 记录完整（state_file 无缺失）${NC}"
    fi

    # 4. 运行时工件不得进入 Git 跟踪面（会污染 exact scope / 收据证据）
    local tracked_runtime
    tracked_runtime="$(git -C "$PROJECT_ROOT" ls-files 2>/dev/null | grep -E '^(\.codex/|\.loopx/|qa-acceptance/)' | head -5 || true)"
    if [[ -n "$tracked_runtime" ]]; then
        echo -e "${YELLOW}[WARN] 运行时工件仍被 Git 跟踪（会进入 exact scope）:${NC}"
        echo "$tracked_runtime" | sed 's/^/         /'
        echo -e "       🛠️ 修复: git rm --cached <path> 并确认 .gitignore 覆盖"
        fail=1
    else
        echo -e "${GREEN}[✓] 运行时工件未被 Git 跟踪${NC}"
    fi

    echo -e "\n${BLUE}==> [3/3] GitHub API 预算基线检查 (官方上限 50% 安全基线)...${NC}"
    if ! command -v gh >/dev/null 2>&1; then
        echo -e "${YELLOW}[WARN] 未检测到 gh CLI，跳过 API 预算检查${NC}"
        return "$fail"
    fi
    local rl core_limit core_remaining content_hint
    rl="$(gh api rate_limit 2>/dev/null || echo '{}')"
    core_limit="$(node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{process.stdout.write(String(JSON.parse(d).resources.core.limit||0))}catch(_){}})' <<< "$rl")"
    core_remaining="$(node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{process.stdout.write(String(JSON.parse(d).resources.core.remaining||0))}catch(_){}})' <<< "$rl")"
    if [[ -z "$core_limit" || "$core_limit" == "0" ]]; then
        echo -e "${YELLOW}[WARN] gh api rate_limit 不可用（令牌失效/网络），无法评估 API 预算${NC}"
        return "$fail"
    fi
    local baseline=$(( core_limit / 2 ))
    echo -e "    core REST: limit=${core_limit}/h  remaining=${core_remaining}  → 50% 安全基线=${baseline}/h"
    echo -e "    secondary: ≤ 900 points/min（GET=1, POST/PATCH=5）、≤ 80 content/min、≤ 500 content/h"
    echo -e "    → 安全基线建议: ${baseline} req/h、450 points/min、40 content/min、250 content/h"
    if (( core_remaining < baseline )); then
        echo -e "${YELLOW}[WARN] 当前剩余额度已低于 50% 基线（remaining=${core_remaining} < ${baseline}），请降低评审频次或等待窗口重置${NC}"
        fail=1
    else
        echo -e "${GREEN}[✓] 当前额度高于 50% 安全基线${NC}"
    fi
    return "$fail"
}

# change-quality 资格与默认基线诊断（GitHub Issue #13）：阶段 0 体检，WARN 不硬阻断。
cmd_doctor_change_quality() {
    local fail=0 goal="" branch base_ref
    echo -e "\n${BLUE}==> change-quality 资格与远程默认基线诊断 (GitHub Issue #13)...${NC}"
    if base_ref="$(resolve_change_quality_base_ref)"; then
        echo -e "${GREEN}[✓] 远程默认基线解析: $base_ref${NC}"
    else
        echo -e "${YELLOW}[WARN] 无法解析远程默认基线（origin/HEAD / origin/main / origin/master 均不存在）${NC}"
        echo -e "       🛠️ 修复: git fetch origin && git remote set-head origin -a"
        fail=1
    fi
    if ! command -v loopx >/dev/null 2>&1; then
        echo -e "${YELLOW}[WARN] 未检测到 loopx，跳过 Goal 资格诊断${NC}"
        return "$fail"
    fi
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
    if [[ "$branch" =~ ^feature/(.+) ]]; then
        goal="${BASH_REMATCH[1]}-goal"
    fi
    if [[ -z "$goal" ]]; then
        echo -e "${YELLOW}[i] 当前非 feature/<name> 分支，跳过 Goal 资格诊断（可用: loopx-flow check --goal-id <id> 触发）${NC}"
        return "$fail"
    fi
    if preflight_change_quality_qualification "$goal" doctor; then
        echo -e "${GREEN}[✓] Goal '$goal' 已启用 change-quality 资格${NC}"
    else
        echo -e "${YELLOW}[WARN] Goal '$goal' 资格未启用或未注册（详见上方诊断卡）${NC}"
        fail=1
    fi
    return "$fail"
}

doctor_branch_protection() {
    local mode="$1" script out
    script="$WORKFLOW_ROOT/scripts/setup-branch-protection.sh"
    if [[ ! -f "$script" ]]; then
        echo -e "${YELLOW}[WARN] 缺少分支保护检查脚本: $script${NC}"
        return 1
    fi
    if out="$(bash "$script" --check --mode "$mode" 2>&1)"; then
        echo -e "${GREEN}[✓] 分支保护与 authorization_mode=$mode 匹配${NC}"
        return 0
    fi
    echo -e "${YELLOW}[WARN] 分支保护未满足 authorization_mode=$mode: ${out:-<no output>}${NC}"
    echo -e "       🛠️ 修复指令: bash scripts/setup-branch-protection.sh --apply --mode $mode"
    return 1
}

doctor_authorization_config() {
    local f mode
    f="$(auth_config_path)"
    echo -e "\n${BLUE}==> [3/3] Gate 授权配置与交付基础设施检查 (ADR-0009 / ADR-0012)...${NC}"
    if [[ ! -f "$f" ]]; then
        echo -e "${YELLOW}[WARN] 未找到 ${f}：authorization_mode 尚未确认，Gate1/Gate2 授权路径不可用。${NC}"
        echo -e "       🛠️ 修复指令: loopx-flow init（需 TTY 确认 authorization_mode）"
        return 0
    fi
    auth_require_config
    mode="$(auth_mode)"
    echo -e "${GREEN}[✓] 授权配置合法: authorization_mode=$mode${NC}"
    # Gate1 上下文：CI/分支保护只 WARN，不阻断契约审批（ADR-0012 决策 5）
    doctor_branch_protection "$mode" || true
}

init_authorization_config() {
    local f mode choice accepted_by accepted_at confirm
    f="$(auth_config_path)"
    echo -e "\n${BLUE}==> Gate 授权模式确认 (REQ-AUTH-MODE-1，不静默默认)...${NC}"
    if [[ -f "$f" ]]; then
        auth_require_config
        echo -e "${GREEN}[✓] 授权配置已存在: $f (authorization_mode=$(auth_mode))${NC}"
        return 0
    fi
    if [[ ! -t 0 ]]; then
        echo -e "[-] [FAIL-CLOSED] 首次 init 必须在 TTY 下确认 authorization_mode；非 TTY 拒绝静默默认。" >&2
        exit 1
    fi
    echo "  1) independent  多账号：Draft PR 上第二 GitHub 账号 gate=1 评论（账号级分离）"
    echo "  2) single_owner 单人维护：TTY + 风险接受；Gate2 走 release-approve"
    read -r -p "选择 authorization_mode [1/2]: " choice
    case "$choice" in
        1) mode="independent" ;;
        2) mode="single_owner" ;;
        *) echo -e "[-] [FAIL-CLOSED] 无效选择: $choice" >&2; exit 1 ;;
    esac
    if [[ "$mode" == "single_owner" ]]; then
        command -v gh >/dev/null 2>&1 || { echo -e "[-] [FAIL-CLOSED] single_owner 需要 gh 读取 accepted_by login" >&2; exit 1; }
        accepted_by="$(gh_login)"
        [[ -n "$accepted_by" ]] || { echo -e "[-] [FAIL-CLOSED] 无法读取 gh api user login" >&2; exit 1; }
        read -r -p "风险接受：single_owner 不提供自然人分离，确认接受？输入 YES: " confirm
        [[ "$confirm" == "YES" ]] || { echo -e "[-] [FAIL-CLOSED] 未接受 single_owner 风险，配置未写入" >&2; exit 1; }
        accepted_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    fi
    node -e '
const fs = require("fs");
const mode = process.argv[1], file = process.argv[2], by = process.argv[3] || "", at = process.argv[4] || "";
const d = { schema_version: "loopx_workflow_config_v0", authorization_mode: mode };
if (mode === "single_owner") d.single_owner_risk_acceptance = { accepted_by: by, accepted_at: at };
fs.writeFileSync(file, JSON.stringify(d, null, 2) + "\n");
' "$mode" "$f" "$accepted_by" "$accepted_at"
    auth_require_config
    echo -e "${GREEN}[✓] 已写入授权配置: $f (authorization_mode=$mode)${NC}"
}

cmd_doctor() {
    echo -e "${BLUE}==> [1/3] 运行流水线前置哨兵体检 (Preflight Sentinel)...${NC}"
    "$WORKFLOW_ROOT/scripts/preflight-check.sh"

    echo -e "\n${BLUE}==> [2/3] 运行 LoopX 原生健康自检 (LoopX Doctor)...${NC}"
    if command -v loopx >/dev/null 2>&1; then
        if ! loopx doctor; then
            echo -e "\n${RED}[-] [FAIL-CLOSED] LoopX 原生健康自检失败！${NC}" >&2
            echo -e "💡 为什么阻断？LoopX 控制面存在配置损坏或环境缺失，继续执行可能导致状态丢失。" >&2
            echo -e "🛠️ 修复指令: 查看上方详细自检日志，或运行 python3 -m pip install --upgrade loopx 进行修复。" >&2 # loopx-allow: install hint text
            exit 1
        fi
    else
        echo -e "${RED}[-] [FAIL-CLOSED] 未检测到 loopx CLI，流水线控制面不可用。${NC}" >&2
        echo -e "    原因: 本机 PATH 中没有 loopx，无法注册 Goal、锁定契约、核验收据或合入锁。" >&2
        echo -e "    影响: approve/check/merge/issue/integrate/todo 等承重命令将全部阻断。" >&2
        echo -e "🛠️ 修复指令: python3 -m pip install --upgrade loopx && loopx doctor" >&2 # loopx-allow: install hint text
        exit 1
    fi

    # 环境治理：路由/registry 一致性 + API 预算基线（WARN 不阻断，但给出可执行修复指令）
    if ! cmd_doctor_control_plane; then
        echo -e "\n${YELLOW}[i] 控制面一致性检查存在告警：不影响本地门禁，但会影响 approve/check/迁移的稳定性。${NC}"
    fi

    # 环境治理：change-quality 资格与远程默认基线（GitHub Issue #13）
    if ! cmd_doctor_change_quality; then
        echo -e "\n${YELLOW}[i] change-quality 诊断存在告警：check 会在前置阶段 fail-closed，请按诊断卡修复。${NC}"
    fi

    # Required Capability Set 能力矩阵（ADR-0010 决策 4 / ADR-0015 决策 4）：
    # 三层探针共用同一矩阵，doctor 是诊断视图，始终 exit 0（不阻断体检汇总）。
    echo -e "\n${BLUE}==> LoopX 能力矩阵 (Required Capability Set · PASS / WARN / BLOCK / UNKNOWN)${NC}"
    probe_loopx_capabilities --scope doctor || true
    echo -e "${YELLOW}[i] 缺失 BLOCK 能力或探测 UNKNOWN 的 L0 命令会 fail-closed 阻断；版本号变化仅软提示不阻断。${NC}"

    # Gate 授权配置 + 交付基础设施（配置非法 fail-closed；分支保护在 Gate1 只 WARN）
    doctor_authorization_config
}

ensure_loopx_tmp_dir() {
    mkdir -p "$LOOPX_TMP_DIR"
}

cmd_gc() {
    local days="14" force="false" as_json="false"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --days) days="${2:-}"; shift 2 ;;
            --force) force="true"; shift ;;
            --json) as_json="true"; shift ;;
            -h|--help)
                echo "用法: loopx-flow gc [--days N] [--force] [--json]"
                return 0
                ;;
            *)
                echo -e "${RED}[-] 未知参数: $1${NC}" >&2
                exit 2
                ;;
        esac
    done
    local -a gc_args=(--gc --repo-root "$PROJECT_ROOT" --tmp-dir "$LOOPX_TMP_DIR" --days "$days")
    [[ "$force" == "true" ]] && gc_args+=(--force)
    [[ "$as_json" == "true" ]] && gc_args+=(--json)
    node "$WORKFLOW_ROOT/lib/paths.js" "${gc_args[@]}"
}

cmd_init() {
    init_authorization_config
    echo -e "${BLUE}==> 正在初始化 LoopX 工作流环境...${NC}"
    "$WORKFLOW_ROOT/scripts/workflow-init.sh"
    mkdir -p "$PROJECT_ROOT/.loopx/tmp"
    echo -e "${GREEN}[✓] 项目本地临时沙箱已就绪: .loopx/tmp (已 gitignore，可用 LOOPX_TMP_DIR 覆盖)${NC}"
    if command -v loopx >/dev/null 2>&1; then
        echo -e "${BLUE}==> 正在连接 LoopX 本地项目状态...${NC}"
        if ! loopx bootstrap --project "$PROJECT_ROOT"; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 本地项目状态初始化失败！${NC}" >&2
            exit 1
        fi
    fi
    echo -e "${GREEN}[✓] 初始化完成！建议随后运行: loopx-flow doctor${NC}"
}

sync_global_required() {
    local goal_id="${1:-}"
    local -a args=(sync-global)
    [[ -n "$goal_id" ]] && args+=(--goal-id "$goal_id")
    local attempt out status
    for attempt in 1 2 3; do
        if out="$(run_loopx "${args[@]}" 2>&1)"; then
            return 0
        fi
        status=$?
        echo -e "${YELLOW}[!] loopx sync-global 失败（第 ${attempt}/3 次），1 秒后重试...${NC}" >&2
        sleep 1
    done
    echo -e "${RED}[-] [FAIL-CLOSED] loopx sync-global 重试 3 次仍失败，禁止静默放行。${NC}" >&2
    echo -e "    实际输出: ${out}" >&2
    echo -e "🛠️ 修复指令: loopx sync-global${goal_id:+ --goal-id $goal_id}" >&2
    return 1
}

cmd_feature() {
    local feature="${1:-}"
    if [[ -z "$feature" ]]; then
        echo -e "${RED}[-] 错误: 请指定特性名称，例如: loopx-flow feature user-auth${NC}" >&2
        exit 1
    fi

    local branch_name="feature/$feature"
    local goal_id="${feature}-goal"

    echo -e "${BLUE}==> [1/3] 检查并切换特性分支: $branch_name ...${NC}"
    if git rev-parse --verify "$branch_name" >/dev/null 2>&1; then
        if ! git checkout "$branch_name" 2>/dev/null; then
            echo -e "${RED}[-] [FAIL-CLOSED] 切换特性分支 $branch_name 失败，流程已物理熔断！${NC}" >&2
            echo -e "💡 为什么阻断？工作区可能存在脏文件阻碍切换，严禁在当前分支继续执行。" >&2
            echo -e "🛠️ 修复指令: 运行 git status 检查未暂存改动或使用 git stash 暂存后重试。" >&2
            exit 1
        fi
    else
        if ! git checkout -b "$branch_name" 2>/dev/null; then
            echo -e "${RED}[-] [FAIL-CLOSED] 创建特性分支 $branch_name 失败，流程已物理熔断！${NC}" >&2
            echo -e "💡 为什么阻断？严禁在 main 主干或非目标分支直接初始化资产包。" >&2
            echo -e "🛠️ 修复指令: 运行 git status 检查工作区状态或使用 git stash 暂存后重试。" >&2
            exit 1
        fi
    fi

    echo -e "${BLUE}==> [2/3] 初始化 Feature 资产胶囊: specs/features/$feature/ ...${NC}"
    local spec_dir="$PROJECT_ROOT/specs/features/$feature"
    mkdir -p "$spec_dir"

    # 1. 00-INDEX.md
    if [[ ! -f "$spec_dir/00-INDEX.md" ]]; then
        cat << INDEXEOF > "$spec_dir/00-INDEX.md"
# Feature Capsule: $feature

> **特性描述**：$feature 核心功能研发
- **Feature Name**: \`$feature\`
- **Branch**: \`$branch_name\`
- **LoopX Goal**: \`$goal_id\`
- **Current Status**: \`IN_PROGRESS (Stage 1~4 Initialized)\`
- **Contract Status**: \`DRAFT (Pending Approval)\`

## 过程文档索引
1. [01-decisions.md](01-decisions.md) - 阶段 1：架构决策备忘录
2. [02-prd.md](02-prd.md) - 阶段 2：精益 PRD 与承重假设
3. [03-stories.md](03-stories.md) - 阶段 3：Job Stories 拆解
4. [04-contract.md](04-contract.md) - 阶段 4：TypeScript 契约与任务图
5. [05-evidence.md](05-evidence.md) - 阶段 5/6：门禁实测数据与质量收据
INDEXEOF
    fi

    # 2. 01-decisions.md
    if [[ ! -f "$spec_dir/01-decisions.md" ]]; then
        cat << DECEOF > "$spec_dir/01-decisions.md"
# Architecture Decisions: $feature
- **Status**: DRAFT (Pending Human Approval)
- **Feature**: $feature

## 1. 核心技术路线对比与权衡
- **分支 1**: 采用最小侵入性实现，复用既有模块。
DECEOF
    fi

    # 3. 02-prd.md
    if [[ ! -f "$spec_dir/02-prd.md" ]]; then
        cat << PRDEOF > "$spec_dir/02-prd.md"
# Lean PRD: $feature

## 1. 核心目标与用户旅程
实现 $feature 特性。

## 2. 承重假设矩阵
- **假设 1**: 本地四大门禁全绿，无破坏性改动。
PRDEOF
    fi

    # 4. 03-stories.md
    if [[ ! -f "$spec_dir/03-stories.md" ]]; then
        cat << STORYEOF > "$spec_dir/03-stories.md"
# User Stories & Sizing: $feature
- **Story 1**: 完成核心接口契约固化与类型安全定义。
- **Story 2**: TDD 红绿循环实现与单测覆盖。
STORYEOF
    fi

    # 5. 04-contract.md
    local contract_file="$spec_dir/04-contract.md"
    if [[ ! -f "$contract_file" ]]; then
        cat << CONTRACTEOF > "$contract_file"
# Feature Contract & Tasks: $feature

- **Contract-Status**: DRAFT (Pending Approval)
- **Feature Branch**: $branch_name
- **LoopX Goal**: $goal_id

## 1. 契约冻结 (TypeScript Interfaces & Invariants)
\`\`\`typescript
export interface ${feature//-/}Config {
  enabled: boolean;
}
\`\`\`

## 2. 任务清单 (Tasks)
- [ ] 【 】t1: 阶段 1 架构决策落实 (\`01-decisions.md\`)
- [ ] 【 】t2: 阶段 2 精益 PRD 与红队攻击 (\`02-prd.md\`)
- [ ] 【 】t3: 阶段 3 特性故事拆解 (\`03-stories.md\`)
- [ ] 【 】t4: 阶段 5 TDD 核心实现与单测
- [ ] 【 】t5: 阶段 6 代码质量与审查收据
- [ ] 【 】t6: 阶段 7 交付 PR 发起与 L2 报告
CONTRACTEOF
    fi

    # 6. 05-evidence.md
    if [[ ! -f "$spec_dir/05-evidence.md" ]]; then
        cat << EVIEEOF > "$spec_dir/05-evidence.md"
# Quality & Verification Evidence: $feature
- **Status**: PENDING_EXECUTION
EVIEEOF
    fi

    echo -e "    ${GREEN}[✓] 已生成自包含资产包: specs/features/$feature/${NC}"

    echo -e "${BLUE}==> [3/3] 注册 LoopX Goal 实体与持久化状态 (Capsule State Bound)...${NC}"
    local state_file=".loopx/goals/${goal_id}/ACTIVE_GOAL_STATE.md" # loopx-allow: repo-relative path passed to --project "$PROJECT_ROOT"

    if command -v loopx >/dev/null 2>&1; then
        # LoopX 2.0 只有在 --state-file 不存在时才会创建 canonical authority；
        # 因此这里严禁在 bootstrap 前预创建 state_file（issue #17 / ADR-0008 归 LoopX runtime）。
        if ! run_loopx bootstrap --project "$PROJECT_ROOT" --goal-id "$goal_id" --display-name "Feature: $feature" --state-file "$state_file"; then
            echo -e "${RED}[-] [FAIL-CLOSED] 注册 LoopX Goal $goal_id 失败，流程已阻断！${NC}" >&2
            echo -e "💡 为什么阻断？目标实体注册失败将导致任务无法被正确追踪与审计。" >&2
            echo -e "🛠️ 修复指令: 运行 loopx doctor 排查本地注册表健康状态。" >&2
            exit 1
        fi
        if [[ ! -f "$PROJECT_ROOT/$state_file" ]]; then
            echo -e "${YELLOW}[!] loopx bootstrap 成功但未生成 state_file: $state_file${NC}" >&2
        fi
        if ! sync_global_required "$goal_id"; then
            echo -e "${RED}[-] [FAIL-CLOSED] Goal 已注册，但全局 registry 同步失败；修复 sync 后重跑 feature。${NC}" >&2
            exit 1
        fi
    else
        if [[ ! -f "$PROJECT_ROOT/$state_file" ]]; then
            mkdir -p "$(dirname "$PROJECT_ROOT/$state_file")"
            cat << STATEEOF > "$PROJECT_ROOT/$state_file"
# Active Goal State: $goal_id
- **Feature**: $feature
- **Created At**: $(date "+%Y-%m-%d %H:%M:%S")
- **Status**: active
STATEEOF
        fi
        echo -e "${YELLOW}[!] 未安装 loopx：已生成本地模板，未注册 LoopX Goal。${NC}"
    fi

    echo -e "\n${BOLD}${GREEN}======================================================================${NC}"
    echo -e "${BOLD}${GREEN}  [✓] 特性 $feature 初始化完毕！${NC}"
    echo -e "${BOLD}${GREEN}======================================================================${NC}"
    echo -e "  请审阅资产包: ${BOLD}specs/features/$feature/00-INDEX.md${NC}"
    echo -e "  完成方案与契约核验后，请执行审批放行指令:"
    echo -e "  ${BOLD}${BLUE}loopx-flow approve contract $feature${NC}\n"
}

auth_config_path() { printf '%s\n' "$PROJECT_ROOT/loopx-workflow.config.json"; }

auth_require_config() {
    local f
    f="$(auth_config_path)"
    if [[ ! -f "$f" ]]; then
        echo "[-] [FAIL-CLOSED] 缺少授权配置: $f" >&2
        exit 1
    fi
    if ! node -e '
const fs = require("fs");
let d;
try { d = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); }
catch (_) { console.error("配置不是合法 JSON"); process.exit(2); }
if (d.schema_version !== "loopx_workflow_config_v0") { console.error("schema_version 非法"); process.exit(2); }
if (!["independent", "single_owner"].includes(d.authorization_mode)) { console.error("authorization_mode 非法"); process.exit(2); }
if (d.authorization_mode === "single_owner") {
  const r = d.single_owner_risk_acceptance;
  if (!r || typeof r.accepted_by !== "string" || !r.accepted_by || typeof r.accepted_at !== "string" || !r.accepted_at) {
    console.error("single_owner 缺 risk acceptance"); process.exit(2);
  }
}
' "$f"; then
        echo "[-] [FAIL-CLOSED] 授权配置校验失败: $f" >&2
        exit 1
    fi
}

auth_mode() {
    node -e 'const fs=require("fs");const d=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));process.stdout.write(d.authorization_mode||"")' "$(auth_config_path)" 2>/dev/null || true
}

auth_accepted_by() {
    node -e 'const fs=require("fs");const d=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));process.stdout.write((d.single_owner_risk_acceptance||{}).accepted_by||"")' "$(auth_config_path)" 2>/dev/null || true
}

auth_accepted_at() {
    node -e 'const fs=require("fs");const d=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));process.stdout.write((d.single_owner_risk_acceptance||{}).accepted_at||"")' "$(auth_config_path)" 2>/dev/null || true
}

gh_login() {
    gh api user --jq .login 2>/dev/null || gh api user -q .login 2>/dev/null || true
}

sha256_file() {
    if command -v node >/dev/null 2>&1; then
        node -e 'const fs=require("fs"),crypto=require("crypto");console.log(crypto.createHash("sha256").update(fs.readFileSync(process.argv[1])).digest("hex"))' "$1"
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        LC_ALL=C shasum -a 256 "$1" | awk '{print $1}'
    fi
}

gate1_decisions_approved() {
    local feature="$1" file="$PROJECT_ROOT/specs/features/$feature/01-decisions.md"
    [[ -f "$file" ]] || file="$PROJECT_ROOT/specs/archive/$feature/01-decisions.md"
    [[ -f "$file" ]] || return 1
    grep -Eq '^(status:[[:space:]]*APPROVED([[:space:]]|$)|[-*][[:space:]]*\*\*(Status|方案状态)\*\*(:|：).*APPROVED)' "$file"
}

gate1_spec_complete() {
    local feature="$1"
    local contract="$PROJECT_ROOT/specs/features/$feature/04-contract.md"
    local stories="$PROJECT_ROOT/specs/features/$feature/03-stories.md"
    [[ -f "$contract" ]] || return 1
    grep -Eqi '(^|[^A-Za-z])AC([^A-Za-z]|$)|AC[[:space:]]*矩阵|Acceptance Criteria' "$contract" || return 1
    grep -Eqi '(^|[^A-Za-z])Scope([^A-Za-z]|$)' "$contract" || return 1
    grep -Eqi '(^|[^A-Za-z])Verification([^A-Za-z]|$)' "$contract" || return 1
    grep -Eqi '依赖|Dependency|Order' "$contract" || return 1
    grep -Eq 'REQ-|ADR-' "$contract" || return 1
    if [[ -f "$stories" ]] && grep -qi 'Story' "$stories"; then
        grep -Eqi '(^|[^A-Za-z])AC([^A-Za-z]|$)|Acceptance Criteria' "$stories" || return 1
        # ADR-0009 决策 5③：每个 story id 必须在契约 AC 矩阵里占一行，不能只在故事文件里搜到 AC。
        node -e '
const fs = require("fs");
const stories = fs.readFileSync(process.argv[1], "utf8");
const contract = fs.readFileSync(process.argv[2], "utf8");
const ids = [...new Set([...stories.matchAll(/\bStory-[A-Za-z0-9_-]+\b/g)].map((m) => m[0]))];
if (!ids.length) process.exit(0);
let matrix = "";
const heading = contract.search(/^#{1,6}[^\n]*(?:AC\s*矩阵|Acceptance Criteria)/im);
if (heading >= 0) {
  const rest = contract.slice(heading);
  const next = rest.slice(1).search(/\n#{1,6} /);
  matrix = next >= 0 ? rest.slice(0, next + 1) : rest;
} else {
  const acHeading = contract.search(/^#{1,6}[^\n]*\bAC\b/im);
  if (acHeading >= 0) {
    const rest = contract.slice(acHeading);
    const next = rest.slice(1).search(/\n#{1,6} /);
    matrix = next >= 0 ? rest.slice(0, next + 1) : rest;
  } else {
    matrix = contract.split(/\n/).filter((line) => /\*\*AC\*\*|\bAC-\d+/i.test(line)).join("\n");
  }
}
const missing = ids.filter((id) => !new RegExp("\\b" + id + "\\b").test(matrix));
if (missing.length) {
  console.error("AC 矩阵缺少 story: " + missing.join(","));
  process.exit(1);
}
' "$stories" "$contract" || return 1
    fi
    return 0
}

# presentation 状态文件（阶段 4 pr create --draft 的持久投影，位于不入 Git 的 .loopx/）
presentation_state_file() {
    printf '%s/presentation/%s.json' "$PROJECT_ROOT/.loopx" "$1"
}

# Gate1 发布前置（REQ-PR-LIFECYCLE-1 / ADR-0012 决策 3）：规格包必须已提交、已推送，
# 且存在可读 PR。任何一项不满足即 fail-closed，禁止审批人在无法从远端审阅规格包时盲签。
gate1_publication_preflight() {
    local feature="$1"
    local spec_dir="specs/features/$feature"
    local f missing=()

    command -v gh >/dev/null 2>&1 || {
        echo "[-] [FAIL-CLOSED] Gate1 发布前置失败: 未检测到 gh CLI，无法核验远端 PR。" >&2
        return 1
    }

    for f in 01-decisions.md 03-stories.md 04-contract.md; do
        if ! git -C "$PROJECT_ROOT" ls-files --error-unmatch "$spec_dir/$f" >/dev/null 2>&1; then
            missing+=("$spec_dir/$f")
        fi
    done
    if [[ "${#missing[@]}" -gt 0 ]]; then
        echo "[-] [FAIL-CLOSED] Gate1 发布前置失败: 规格包未被 Git 跟踪: ${missing[*]}" >&2
        echo "💡 为什么阻断？审批人不在执行 Agent 的机器上，只有被跟踪并推送的规格包才能进入 PR 被审阅。" >&2
        echo "🛠️ 修复指令: git add $spec_dir && git commit -m \"docs($feature): publish spec package\" && git push" >&2
        return 1
    fi

    local marker
    marker="$(presentation_state_file "$feature")"
    if [[ -f "$marker" ]]; then
        echo "[-] [FAIL-CLOSED] Gate1 发布前置失败: 存在 presentation=pending 标记 ($marker)。" >&2
        echo "💡 为什么阻断？阶段 4 的 pr create --draft 失败后没有恢复，PR 不是可读的审阅载体（旧语义只 WARN，现已 BLOCK）。" >&2
        echo "🛠️ 修复指令: 修复 gh 认证/网络后重跑 loopx-flow pr create $feature --draft，成功后再 approve。" >&2
        return 1
    fi

    local pending
    pending="$(git -C "$PROJECT_ROOT" status --porcelain --untracked-files=all -- "$spec_dir" 2>/dev/null || true)"
    if [[ -n "$pending" ]]; then
        echo "[-] [FAIL-CLOSED] Gate1 发布前置失败: 规格包存在未提交或未跟踪文件:" >&2
        printf '%s\n' "$pending" | sed 's/^/    /' >&2
        echo "🛠️ 修复指令: git add $spec_dir && git commit && git push" >&2
        return 1
    fi

    local branch head_sha remote_sha
    branch="$(git -C "$PROJECT_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [[ -z "$branch" || "$branch" == "HEAD" ]]; then
        echo "[-] [FAIL-CLOSED] Gate1 发布前置失败: 当前处于 detached HEAD，无法绑定远端分支。" >&2
        return 1
    fi
    head_sha="$(git -C "$PROJECT_ROOT" rev-parse HEAD 2>/dev/null || true)"
    remote_sha="$(git -C "$PROJECT_ROOT" ls-remote --heads origin "refs/heads/$branch" 2>/dev/null | awk 'NR==1 {print $1}' || true)"
    if [[ -z "$remote_sha" ]]; then
        echo "[-] [FAIL-CLOSED] Gate1 发布前置失败: 分支 $branch 尚未推送到 origin。" >&2
        echo "🛠️ 修复指令: git push -u origin $branch" >&2
        return 1
    fi
    if [[ "$remote_sha" != "$head_sha" ]]; then
        echo "[-] [FAIL-CLOSED] Gate1 发布前置失败: 本地 HEAD ($head_sha) 与 origin/$branch ($remote_sha) 不一致。" >&2
        echo "💡 为什么阻断？审批人审阅的远端提交必须就是被锁定的 spec_commit；本地领先或落后都禁止签署。" >&2
        echo "🛠️ 修复指令: git pull --rebase origin $branch 或 git push origin $branch 对齐后再 approve" >&2
        return 1
    fi

    local pr_json pr_meta pr_number pr_head
    if ! pr_json="$(cd "$PROJECT_ROOT" && gh pr view "$branch" --json number,state,isDraft,url,headRefOid 2>/dev/null)"; then
        echo "[-] [FAIL-CLOSED] Gate1 发布前置失败: 分支 $branch 没有可读的 PR。" >&2
        echo "🛠️ 修复指令: loopx-flow pr create $feature --draft" >&2
        return 1
    fi
    if ! pr_meta="$(printf '%s' "$pr_json" | node -e '
let d = {};
try { d = JSON.parse(require("fs").readFileSync(0, "utf8")); } catch (_) { process.exit(1); }
const number = Number(d.number || 0);
if (!number || !d.url) process.exit(1);
if (String(d.state || "").toUpperCase() !== "OPEN") process.exit(1);
process.stdout.write(number + " " + String(d.headRefOid || ""));
')"; then
        echo "[-] [FAIL-CLOSED] Gate1 发布前置失败: 分支 $branch 的 PR 不可读或不是 OPEN 状态。" >&2
        echo "🛠️ 修复指令: loopx-flow pr create $feature --draft" >&2
        return 1
    fi
    pr_number="${pr_meta%% *}"
    pr_head="${pr_meta#* }"
    if [[ -n "$pr_head" && "$pr_head" != "$head_sha" ]]; then
        echo "[-] [FAIL-CLOSED] Gate1 发布前置失败: PR #$pr_number head ($pr_head) 与本地 HEAD ($head_sha) 不一致。" >&2
        echo "🛠️ 修复指令: git push origin $branch 让 PR head 对齐后再 approve" >&2
        return 1
    fi
    echo "[✓] Gate1 发布前置通过: PR #$pr_number ($branch@${head_sha:0:12}) 可读，规格包已跟踪并推送。" >&2
}

# 统一解析 Gate 授权评论（Gate1 independent / Gate1 single_owner / Gate2 Mode B）。
#
#   gate_comment_author <comments-json> <marker> <eq|neq> <login> <self-key|-> <key=value>...
#
# 输出匹配评论的作者 login；无匹配返回 1；分页载荷不可读返回 2。
#   <eq|neq>    身份条件：评论作者 == login / != login
#   <self-key>  要求该字段值等于评论作者（approver / principal），"-" 表示不校验
#   <key=value> 其余必须逐字相等的字段
#
# 三处调用点只传 marker、身份条件与必需字段，分页拆段、字段解析与自洽校验只有这一份。
gate_comment_author() {
    local comments="$1"
    shift
    node -e '
const fs = require("fs");
const [marker, idMode, idLogin, selfKey, ...required] = process.argv.slice(1);
const need = Object.fromEntries(required.map((pair) => {
  const i = pair.indexOf("=");
  return [pair.slice(0, i), pair.slice(i + 1)];
}));
const raw = fs.readFileSync(0, "utf8").trim();
const rows = [];
try {
  let i = 0;
  while (i < raw.length) {
    while (i < raw.length && /\s/.test(raw[i])) i++;
    if (i >= raw.length) break;
    if (raw[i] !== "[") process.exit(2);
    let depth = 0, inStr = false, esc = false, start = i;
    for (; i < raw.length; i++) {
      const c = raw[i];
      if (inStr) { if (esc) esc = false; else if (c === "\\") esc = true; else if (c === "\"") inStr = false; continue; }
      if (c === "\"") { inStr = true; continue; }
      if (c === "[") depth++;
      else if (c === "]") { depth--; if (depth === 0) { i++; break; } }
    }
    if (depth !== 0) process.exit(2);
    rows.push(...JSON.parse(raw.slice(start, i)));
  }
} catch (_) { process.exit(2); }
for (const row of rows) {
  const body = String(row.body || ""), login = String((row.user || {}).login || "");
  if (!login || !body.includes(marker)) continue;
  if (idMode === "eq" ? login !== idLogin : login === idLogin) continue;
  const fields = {};
  for (const part of body.split(/[;\n]/)) {
    const i = part.indexOf("=");
    if (i <= 0) continue;
    const k = part.slice(0, i).trim();
    if (/^[A-Za-z0-9_]+$/.test(k)) fields[k] = part.slice(i + 1).trim();
  }
  if (selfKey !== "-" && fields[selfKey] !== login) continue;
  if (!Object.entries(need).every(([k, v]) => fields[k] === v)) continue;
  process.stdout.write(login);
  process.exit(0);
}
process.exit(1);
' "$@" <<< "$comments"
}

find_gate1_independent_comment() {
    local feature="$1" pre_sha="$2" executor="$3" spec_commit="$4" branch="feature/$1" repo pr comments
    repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
    [[ -n "$repo" ]] || return 1
    pr="$(gh pr list --head "$branch" --state open --json number,isDraft --jq '.[0] | select(.isDraft == true) | .number' 2>/dev/null || true)"
    [[ -n "$pr" && "$pr" != "null" ]] || return 1
    comments="$(gh api "repos/$repo/issues/$pr/comments" --paginate 2>/dev/null || true)"
    gate_comment_author "$comments" "<!-- loopx-flow:gate1-authorization:$feature@$pre_sha -->" \
        neq "$executor" approver \
        gate=1 mode=independent contract_sha="$pre_sha" spec_commit="$spec_commit"
}

# ADR-0019：当前分支对应的 open PR（Gate1/Gate2 GitHub 签名路径使用）。
# 兼容 feat/* 与 feature/* 分支名，不要求 Draft——授权事实来自评论本身，而不是 PR 展示状态。
current_branch_pr() {
    local branch
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
    [[ -n "$branch" && "$branch" != "HEAD" ]] || return 1
    gh pr list --head "$branch" --state open --json number --jq '.[0].number // empty' 2>/dev/null | head -n1
}

# ADR-0019：解析 PR 对应 feature。优先 feature/<name> 分支，其次 PR body 的 loopx-meta goal_id（<feature>-goal）。
resolve_pr_feature() {
    local pr_id="$1" head_ref="$2" feature="" goal=""
    # Issue 修复不接受 Feature 胶囊：fix/issue-<id> 与 issue-<id>-goal 一律返回空 feature，
    # 否则 issue-<id> 会被误读成特性名并去找不存在的 specs/features/issue-<id>/。
    if [[ "$head_ref" =~ ^fix/issue-[0-9]+ ]]; then printf ''; return 0; fi
    if [[ "$head_ref" =~ ^feature/(.+) ]]; then feature="${BASH_REMATCH[1]}"; fi
    if [[ -z "$feature" ]]; then
        goal="$(resolve_pr_goal_id "$pr_id")"
        if [[ "$goal" =~ ^issue-[0-9]+-goal$ ]]; then printf ''; return 0; fi
        if [[ "$goal" == *-goal ]]; then feature="${goal%-goal}"; fi
    fi
    printf '%s' "$feature"
}

# 从 PR body 的 loopx-meta 读取 Goal id（Issue/Feature 共用同一机器标记）。
resolve_pr_goal_id() {
    local pr_id="$1"
    gh pr view "$pr_id" --json body --jq '.body' 2>/dev/null \
        | sed -n 's/.*"goal_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1
}

# ADR-0019：single_owner 的 Gate1 由 accepted_by 本人在 PR 上的 gate=1 评论签发。
# 与 independent 的唯一差别是身份条件：评论作者 == accepted_by（而非 != executor）。
find_gate1_single_owner_comment() {
    local feature="$1" pre_sha="$2" spec_commit="$3" accepted_by="$4" repo pr comments
    repo="$(github_repo)" || return 1
    [[ -n "$repo" ]] || return 1
    pr="$(current_branch_pr)" || return 1
    [[ -n "$pr" && "$pr" != "null" ]] || return 1
    comments="$(gh api "repos/$repo/issues/$pr/comments" --paginate 2>/dev/null || true)"
    gate_comment_author "$comments" "<!-- loopx-flow:gate1-authorization:$feature@$pre_sha -->" \
        eq "$accepted_by" approver \
        gate=1 mode=single_owner contract_sha="$pre_sha" spec_commit="$spec_commit"
}

gate1_user_gate_evidence() {
    # 返回码约定：0=取到 evidence；1=载荷可读但没有匹配的 user_gate approve 记录；
    # 2=载荷不可读（命令失败或 schema_version 漂移）。调用方据此给出不同诊断。
    local feature="$1" sha="$2" goal="$1-goal" json err_file
    wf_run_dir gate1
    err_file="$WF_RUN_DIR/gate1-todo-list.err"
    # stderr 单独落文件：不能与 stdout 合并，否则 loopx 镜像里的无害 warning
    # 会让合法载荷 JSON.parse 失败（review #73 P0 复审 finding）。
    if ! json="$(read_loopx_json todo.list --format json todo list --goal-id "$goal" --role user 2>"$err_file")"; then
        # 本函数在 $(...) 子 shell 中执行，全局变量传不出去，诊断直接写 stderr（外层继承）。
        echo "[-] 诊断: $(sed $'s/\033\\[[0-9;]*m//g' "$err_file" 2>/dev/null | tr '\n' ' ')" >&2
        return 2
    fi
    [[ -n "$json" ]] || return 2
    node -e '
const fs = require("fs");
const sha = process.argv[1];
let data = {};
try { data = JSON.parse(fs.readFileSync(0, "utf8")); } catch (_) { process.exit(2); }
const rows = (data.todos || []).filter((t) => t.task_class === "user_gate" && t.decision_outcome === "approve" && t.decision_scope && t.decision_scope.scope_key === sha && !t.superseded_by);
if (!rows.length) process.exit(1);
process.stdout.write(String(rows[rows.length - 1].evidence || ""));
' "$sha" <<< "$json"
}

gate1_verify_authorization() {
    # Gate1 强制启用授权配置校验：缺失或非法配置即 fail-closed（P1-1 / ADR-0009）
    auth_require_config
    local feature="$1" sha="$2" mode evidence accepted_by accepted_at risk evidence_rc=0
    mode="$(auth_mode)"
    evidence="$(gate1_user_gate_evidence "$feature" "$sha")" || evidence_rc=$?
    if [[ "$evidence_rc" -eq 2 ]]; then
        echo "[-] [FAIL-CLOSED] 读取 user_gate 授权记录失败（LoopX todo list 载荷不可用或 schema_version 漂移），见上方诊断。" >&2
        exit 1
    fi
    if [[ -z "$evidence" ]]; then
        echo "[-] [FAIL-CLOSED] 缺少当前 SHA 对应的 user_gate approve 授权记录。" >&2
        exit 1
    fi
    accepted_by="$(auth_accepted_by)"
    accepted_at="$(auth_accepted_at)"
    risk="$accepted_by@$accepted_at"
    if ! node -e '
const mode = process.argv[1], sha = process.argv[2], acceptedBy = process.argv[3], risk = process.argv[4];
const text = process.argv[5] || "";
const fields = {};
for (const part of text.split(/[;\n]/)) { const i = part.indexOf("="); if (i <= 0) continue; const k = part.slice(0, i).trim(); if (/^[A-Za-z0-9_]+$/.test(k)) fields[k] = part.slice(i + 1).trim(); }
const base = ["authorization_mode","contract_sha","spec_commit","feature","principal"];
for (const k of base) if (!fields[k]) { console.error("evidence 缺键: " + k); process.exit(1); }
if (fields.authorization_mode !== mode) { console.error("evidence mode 与配置不一致"); process.exit(1); }
if (fields.contract_sha !== sha) { console.error("evidence contract_sha 与当前 SHA 不一致"); process.exit(1); }
if (mode === "single_owner") {
  if (!fields.risk_acceptance) { console.error("single_owner evidence 缺 risk_acceptance"); process.exit(1); }
  if (fields.principal !== acceptedBy) { console.error("principal 与 accepted_by 不一致"); process.exit(1); }
  if (fields.risk_acceptance !== risk) { console.error("risk_acceptance 与配置不一致"); process.exit(1); }
} else if (!fields.principal) { console.error("independent evidence 缺 principal"); process.exit(1); }
' "$mode" "$sha" "$accepted_by" "$risk" "$evidence"; then
        exit 1
    fi
    echo "[✓] Gate1 授权记录核验通过 ($mode)"
}

contract_sha_for() {
    local feature="$1" f="$PROJECT_ROOT/specs/features/$feature/04-contract.md"
    [[ -f "$f" ]] || f="$PROJECT_ROOT/specs/archive/$feature/04-contract.md"
    [[ -f "$f" ]] || return 1
    sha256_file "$f"
}

pr_is_draft() {
    local pr_id="$1" out
    out="$(gh pr view "$pr_id" --json isDraft --jq '.isDraft' 2>/dev/null || true)"
    [[ "$out" == "true" ]]
}

github_repo() {
    gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true
}

# Mode B：当前 head 上必须有 Agent 的 review 记录（ADR-0012 决策 2②）
# 兼容两条现有发布通道：formal review COMMENT（gh api pulls/reviews）或 review issue comment（loopx-flow review 的 upsert 标记）
agent_comment_ok() {
    local pr_id="$1" head_oid="$2" repo reviews comments marker
    repo="$(github_repo)"
    [[ -n "$repo" ]] || return 1
    marker="<!-- loopx-flow:review:${pr_id}@$(printf '%s' "$head_oid" | tr 'A-Z' 'a-z') -->"
    reviews="$(gh api "repos/$repo/pulls/$pr_id/reviews" --paginate 2>/dev/null || true)"
    if node -e '
const fs = require("fs");
const head = process.argv[1];
const raw = fs.readFileSync(0, "utf8").trim();
const rows = [];
try {
  let i = 0;
  while (i < raw.length) {
    while (i < raw.length && /\s/.test(raw[i])) i++;
    if (i >= raw.length) break;
    if (raw[i] !== "[") process.exit(1);
    let depth = 0, inStr = false, esc = false, start = i;
    for (; i < raw.length; i++) {
      const c = raw[i];
      if (inStr) { if (esc) esc = false; else if (c === "\\") esc = true; else if (c === "\"") inStr = false; continue; }
      if (c === "\"") { inStr = true; continue; }
      if (c === "[") depth++;
      else if (c === "]") { depth--; if (depth === 0) { i++; break; } }
    }
    if (depth !== 0) process.exit(1);
    rows.push(...JSON.parse(raw.slice(start, i)));
  }
} catch (_) { process.exit(1); }
if (!Array.isArray(rows)) process.exit(1);
const ok = rows.some((r) => {
  const st = String(r.state || "").toUpperCase();
  return (st === "COMMENTED" || st === "COMMENT") && String(r.commit_id || (r.commit || {}).oid || "") === head;
});
process.exit(ok ? 0 : 1);
' "$head_oid" <<< "$reviews"; then
        return 0
    fi
    comments="$(gh api "repos/$repo/issues/$pr_id/comments" --paginate 2>/dev/null || true)"
    node -e '
const fs = require("fs");
const marker = process.argv[1];
const raw = fs.readFileSync(0, "utf8").trim();
const rows = [];
try {
  let i = 0;
  while (i < raw.length) {
    while (i < raw.length && /\s/.test(raw[i])) i++;
    if (i >= raw.length) break;
    if (raw[i] !== "[") process.exit(1);
    let depth = 0, inStr = false, esc = false, start = i;
    for (; i < raw.length; i++) {
      const c = raw[i];
      if (inStr) { if (esc) esc = false; else if (c === "\\") esc = true; else if (c === "\"") inStr = false; continue; }
      if (c === "\"") { inStr = true; continue; }
      if (c === "[") depth++;
      else if (c === "]") { depth--; if (depth === 0) { i++; break; } }
    }
    if (depth !== 0) process.exit(1);
    rows.push(...JSON.parse(raw.slice(start, i)));
  }
} catch (_) { process.exit(1); }
if (!Array.isArray(rows)) process.exit(1);
process.exit(rows.some((r) => String(r.body || "").includes(marker)) ? 0 : 1);
' "$marker" <<< "$comments"
}

# Mode B：release-authorization 评论必须绑定当前 head、当前契约 SHA 与 accepted_by（ADR-0012 决策 10）
release_authorization_ok() {
    local pr_id="$1" head_oid="$2" contract_sha="$3" repo comments accepted_by accepted_at risk
    [[ "$(auth_mode)" == "single_owner" ]] || return 1
    accepted_by="$(auth_accepted_by)"
    accepted_at="$(auth_accepted_at)"
    [[ -n "$accepted_by" ]] || return 1
    risk="$accepted_by@$accepted_at"
    repo="$(github_repo)"
    [[ -n "$repo" ]] || return 1
    comments="$(gh api "repos/$repo/issues/$pr_id/comments" --paginate 2>/dev/null || true)"
    # 输出被丢弃：本函数只回 0/1，匹配到的 login 不进入调用方 stdout。
    gate_comment_author "$comments" "<!-- loopx-flow:release-authorization:$pr_id@$head_oid -->" \
        eq "$accepted_by" principal \
        gate=2 mode=single_owner head="$head_oid" contract_sha="$contract_sha" risk_acceptance="$risk" >/dev/null
}

# Mode A：非作者 formal review APPROVED 且 review commit == 当前 head，PR 非 Draft（ADR-0012 决策 2②）
mode_a_review_ok() {
    local pr_id="$1" head_oid="$2" json
    json="$(gh pr view "$pr_id" --json reviews,author,reviewDecision,isDraft --jq '[(.author.login // ""), (.reviewDecision // ""), ((.isDraft // false) | tostring), (.reviews // [])] | @json' 2>/dev/null || true)"
    [[ -n "$json" ]] || return 1
    node -e '
const fs = require("fs");
let data;
try { data = JSON.parse(fs.readFileSync(0, "utf8")); } catch (_) { process.exit(1); }
const prAuthor = String(data[0] || ""), decision = String(data[1] || ""), isDraft = String(data[2] || "false"), reviews = Array.isArray(data[3]) ? data[3] : [];
const head = process.argv[1];
if (isDraft === "true") process.exit(1);
if (decision !== "APPROVED") process.exit(1);
const ok = reviews.some((r) => String((r.author || {}).login || "") !== prAuthor && String((r.commit || {}).oid || r.commit_id || "") === head && String(r.state || "").toUpperCase() === "APPROVED");
process.exit(ok ? 0 : 1);
' "$head_oid" <<< "$json"
}

# readiness JSON 提取（容忍前后日志噪声）
readiness_json_field() {
    local raw="$1"
    node -e '
const balancedFrom = (s, start) => { let depth = 0, inStr = false, esc = false; for (let i = start; i < s.length; i++) { const c = s[i]; if (inStr) { if (esc) esc = false; else if (c === "\\") esc = true; else if (c === "\"") inStr = false; continue; } if (c === "\"") { inStr = true; continue; } if (c === "{") { depth++; } else if (c === "}") { depth--; if (depth === 0) return s.slice(start, i + 1); } } return null; };
const raw = process.argv[1];
for (let start = raw.indexOf("{"); start !== -1; start = raw.indexOf("{", start + 1)) {
  const json = balancedFrom(raw, start);
  if (!json) break;
  try {
    const d = JSON.parse(json);
    process.stdout.write(JSON.stringify(d));
    process.exit(0);
  } catch (_) { /* 前置噪声里的伪 JSON 片段，继续向后探测 */ }
}
process.stderr.write("readiness JSON 解析失败\n");
process.exit(1);
' "$raw"
}

# Mode A readiness：以 JSON ready 字段为准（ADR-0012 决策 2③）
mode_a_readiness_ok() {
    local pr_id="$1" head_oid="$2" goal_id="${3:-}" out parsed
    local -a goal_flag=()
    [[ -n "$goal_id" ]] && goal_flag=(--goal-id "$goal_id")
    out="$(run_loopx pr-review ${goal_flag[@]+"${goal_flag[@]}"} --check-merge-readiness "$pr_id@$head_oid" --format json 2>&1 || true)"
    parsed="$(readiness_json_field "$out")" || return 1
    node -e '
let d = {};
try { d = JSON.parse(process.argv[1]); } catch (_) { process.exit(1); }
process.exit(d.ready === true ? 0 : 1);
' "$parsed"
}

# Mode B readiness：blocking_reasons 三档判定（ADR-0012 决策 2③ 允许/忽略列表）
mode_b_readiness_ok() {
    local pr_id="$1" head_oid="$2" goal_id="${3:-}" out parsed
    local -a goal_flag=()
    [[ -n "$goal_id" ]] && goal_flag=(--goal-id "$goal_id")
    out="$(run_loopx pr-review ${goal_flag[@]+"${goal_flag[@]}"} --check-merge-readiness "$pr_id@$head_oid" --format json 2>&1 || true)"
    parsed="$(readiness_json_field "$out")" || return 1
    node -e '
const allow = new Set(["pull_request_not_open","draft_pull_request","remote_head_mismatch","status_checks_missing","status_checks_failed","status_checks_pending","status_checks_incomplete","review_threads_incomplete","unresolved_review_threads","merge_state_requires_update","merge_state_unverified","repository_merge_state_blocked"]);
const ignore = new Set(["current_head_review_missing_or_invalid","current_head_conclusion_not_approval","github_review_decision_not_approved"]);
let d = {};
try { d = JSON.parse(process.argv[1]); } catch (_) { process.exit(1); }
const obs = (d.readiness_observation && typeof d.readiness_observation === "object") ? d.readiness_observation : {};
const raw = Array.isArray(d.blocking_reasons) ? d.blocking_reasons : (Array.isArray(obs.blocking_reasons) ? obs.blocking_reasons : null);
if (!raw) { process.stderr.write("blocking_reasons 缺失或不可解析\n"); process.exit(1); }
for (const row of raw) {
  const code = typeof row === "string" ? row : String((row && (row.code || row.reason || row.kind)) || "");
  if (!code) { process.stderr.write("blocking_reasons 含无法识别的条目\n"); process.exit(1); }
  if (allow.has(code)) { process.stderr.write("Mode B readiness 命中允许列表阻断项: " + code + "\n"); process.exit(1); }
  if (ignore.has(code)) continue;
  process.stderr.write("Mode B readiness 命中未知阻断项: " + code + "\n"); process.exit(1);
}
process.exit(0);
' "$parsed"
}

# CI/分支保护是 Gate2 前置；缺失时 merge fail-closed（ADR-0012 决策 5）
branch_protection_ok() {
    local mode="$1" branch="${2:-main}" script="$WORKFLOW_ROOT/scripts/setup-branch-protection.sh" out
    if [[ ! -f "$script" ]]; then
        echo "[-] [FAIL-CLOSED] 缺少分支保护检查脚本: $script" >&2
        return 1
    fi
    if out="$(bash "$script" --check --mode "$mode" --branch "$branch" 2>&1)"; then
        return 0
    fi
    echo "[-] [FAIL-CLOSED] 分支保护未满足 authorization_mode=$mode (branch=$branch): ${out:-<no output>}" >&2
    echo "🛠️ 修复指令: bash scripts/setup-branch-protection.sh --apply --branch $branch" >&2
    return 1
}

cmd_approve() {
    local target="${1:-}" feature="${2:-}" yes=false prepare=false interactive=false arg
    for arg in "$@"; do
        case "$arg" in
            --yes) yes=true ;;
            --prepare) prepare=true ;;
            --interactive) interactive=true ;;
        esac
    done
    if [[ "$target" != "contract" ]]; then
        echo "[-] 错误: 目前仅支持 approve contract，例如: loopx-flow approve contract user-auth" >&2
        exit 1
    fi
    if [[ -z "$feature" ]]; then
        local branch
        branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
        if [[ "$branch" =~ ^feature/(.+) ]]; then feature="${BASH_REMATCH[1]}"; fi
    fi
    if [[ -z "$feature" ]]; then
        echo "[-] 错误: 请指定特性名称，例如: loopx-flow approve contract user-auth" >&2
        exit 1
    fi

    local contract_file="$PROJECT_ROOT/specs/features/$feature/04-contract.md"
    local decision_file="$PROJECT_ROOT/specs/features/$feature/01-decisions.md"
    local index_file="$PROJECT_ROOT/specs/features/$feature/00-INDEX.md"

    [[ -f "$contract_file" ]] || { echo "[-] 未找到契约文件: $contract_file" >&2; exit 1; }
    command -v loopx >/dev/null 2>&1 || { echo "[-] [FAIL-CLOSED] 未检测到 loopx CLI，禁止写批准标记。" >&2; exit 1; }

    # Gate1 授权强制启用：缺失/非法配置即 fail-closed（ADR-0009 T3/T4）
    auth_require_config
    local mode
    mode="$(auth_mode)"
    [[ -n "$mode" ]] || { echo "[-] [FAIL-CLOSED] 无法读取 authorization_mode" >&2; exit 1; }
    if ! gate1_decisions_approved "$feature"; then
        echo "[-] [FAIL-CLOSED] 01-decisions.md 未标记 APPROVED" >&2; exit 1
    fi
    if ! gate1_spec_complete "$feature"; then
        echo "[-] [FAIL-CLOSED] 规格不完整: 04-contract 需含 AC/Scope/Verification Plan/依赖顺序/REQ或ADR，且每个 story id 在 AC 矩阵中有一行" >&2; exit 1
    fi
    # 纯参数校验先于发布前置：--yes 永远拒绝，--interactive 的 TTY 能力也不依赖远端发布状态。
    if [[ "$yes" == "true" ]]; then
        echo "[-] [FAIL-CLOSED] 不支持 --yes：授权必须来自 accepted_by 的 GitHub 评论或 --interactive TTY" >&2
        exit 1
    fi
    if [[ "$interactive" == "true" && ! -t 0 ]]; then
        echo "[-] [FAIL-CLOSED] --interactive 需要 TTY 交互确认" >&2
        exit 1
    fi

    local principal="" executor="" spec_commit=""

    # 先落最终字节：批准标记行固定，不把审批人/时间写进参与哈希的正文。
    # 临时字节写到项目沙箱而非胶囊目录：否则 Gate1 发布前置的「胶囊内无未跟踪文件」检查
    # 会把编排器自己的临时文件当成未跟踪规格包而自我阻断。文件名不含 feature，
    # 避免任意 feature 名（含路径分隔符/引号）参与文件路径构造。
    local temp_contract
    mkdir -p "$LOOPX_TMP_DIR"
    temp_contract="$(mktemp "$LOOPX_TMP_DIR/contract.XXXXXX")"
    wf_register_temp_file "$temp_contract"
    node -e '
const fs = require("fs");
const src = process.argv[1], dst = process.argv[2];
let text = fs.readFileSync(src, "utf8");
const line = "- **Contract-Status**: FROZEN & APPROVED";
if (/Contract-Status/i.test(text)) text = text.replace(/.*Contract-Status.*$/m, line);
else text = line + "\n" + text;
fs.writeFileSync(dst, text);
' "$contract_file" "$temp_contract"

    # 评论、configure-goal、evidence、最终落盘共用这一份字节的 SHA
    local contract_sha
    contract_sha="$(sha256_file "$temp_contract")"

    # spec_commit 只作追溯（不参与 gate verify）；生产路径必须工作区干净。
    local dirty
    dirty="$(git status --porcelain --untracked-files=no 2>/dev/null || true)"
    if [[ -n "$dirty" ]]; then
        rm -f "$temp_contract"; wf_unregister_temp_file "$temp_contract"
        echo "[-] [FAIL-CLOSED] 工作区不干净，Spec-Commit 无法确定；请先提交" >&2
        exit 1
    fi
    spec_commit="$(git rev-parse HEAD)"

    # ADR-0019：--prepare 只打印 GitHub 签名评论模板，零写入。
    if [[ "$prepare" == "true" ]]; then
        [[ "$yes" != "true" ]] || { rm -f "$temp_contract"; echo "[-] [FAIL-CLOSED] 不支持 --yes：--prepare 也不得跳过人工签名" >&2; exit 1; }
        rm -f "$temp_contract"; wf_unregister_temp_file "$temp_contract"
        wf_unregister_temp_file "$temp_contract"
        if [[ "$mode" == "single_owner" ]]; then
            local prepared_by
            prepared_by="$(auth_accepted_by)"
            echo "[i] Gate1 准备完成（single_owner，未写入任何批准标记）"
            echo "    feature      : $feature"
            echo "    contract_sha : $contract_sha"
            echo "    spec_commit  : $spec_commit"
            echo "    approver     : $prepared_by"
            echo ""
            echo "请在 PR 上以 $prepared_by 身份粘贴以下评论，然后重跑 loopx-flow approve contract ${feature}："
            echo ""
            echo "<!-- loopx-flow:gate1-authorization:$feature@$contract_sha -->"
            echo "gate=1;mode=single_owner;contract_sha=$contract_sha;spec_commit=$spec_commit;approver=$prepared_by"
        else
            echo "[i] Gate1 准备完成（independent，未写入任何批准标记）"
            echo "    feature      : $feature"
            echo "    contract_sha : $contract_sha"
            echo "    spec_commit  : $spec_commit"
            echo ""
            echo "请由【另一个 GitHub 账号】在 PR 上粘贴以下评论（approver 必须替换为该账号 login），"
            echo "然后由执行者重跑 loopx-flow approve contract ${feature}："
            echo ""
            echo "<!-- loopx-flow:gate1-authorization:$feature@$contract_sha -->"
            echo "gate=1;mode=independent;contract_sha=$contract_sha;spec_commit=$spec_commit;approver=<第二 GitHub 账号 login>"
        fi
        exit 0
    fi

    # 发布前置先于任何授权确认：审批人无法从远端审阅规格包时不得进入签字环节（REQ-PR-LIFECYCLE-1）。
    # 放在 --prepare 之后：生成签名模板是零写入动作，不构成授权。
    if ! gate1_publication_preflight "$feature"; then
        echo "[-] [FAIL-CLOSED] Gate1 发布前置未满足，禁止写批准标记。" >&2
        exit 1
    fi

    if [[ "$mode" == "single_owner" ]]; then
        [[ "$yes" != "true" ]] || { echo "[-] [FAIL-CLOSED] 不支持 --yes：授权必须来自 accepted_by 的 GitHub 评论或 --interactive TTY" >&2; exit 1; }
        command -v gh >/dev/null 2>&1 || { echo "[-] [FAIL-CLOSED] single_owner approve 需要 gh" >&2; exit 1; }
        local accepted_by
        accepted_by="$(auth_accepted_by)"
        if [[ "$interactive" == "true" ]]; then
            [[ -t 0 ]] || { rm -f "$temp_contract"; echo "[-] [FAIL-CLOSED] --interactive 需要 TTY 交互确认" >&2; exit 1; }
            executor="$(gh_login)"
            [[ -n "$executor" ]] || { rm -f "$temp_contract"; echo "[-] [FAIL-CLOSED] 无法读取 gh api user login" >&2; exit 1; }
            [[ "$executor" == "$accepted_by" ]] || { rm -f "$temp_contract"; echo "[-] [FAIL-CLOSED] 当前 gh login ($executor) 与 accepted_by ($accepted_by) 不一致" >&2; exit 1; }
            principal="$executor"
            local confirm_reply=""
            printf '确认以 single_owner (%s) 签署 Gate1 契约授权 [%s]? 请输入 yes 继续: ' "$principal" "$feature"
            if ! IFS= read -r confirm_reply; then
                rm -f "$temp_contract"; wf_unregister_temp_file "$temp_contract"
                echo "[-] [FAIL-CLOSED] 未收到交互确认输入，已取消。" >&2
                exit 1
            fi
            if [[ "$confirm_reply" != "yes" && "$confirm_reply" != "y" && "$confirm_reply" != "YES" ]]; then
                rm -f "$temp_contract"; wf_unregister_temp_file "$temp_contract"
                echo "[-] [FAIL-CLOSED] Gate1 授权已取消（需输入 yes 确认）。" >&2
                exit 1
            fi
        else
            principal="$(find_gate1_single_owner_comment "$feature" "$contract_sha" "$spec_commit" "$accepted_by" || true)"
            if [[ -z "$principal" ]]; then
                rm -f "$temp_contract"; wf_unregister_temp_file "$temp_contract"
                echo "[-] [FAIL-CLOSED] 未找到 single_owner 的 GitHub gate=1 授权评论：作者必须是 accepted_by=${accepted_by}，且 contract_sha/spec_commit 与当前一致。" >&2
                echo "🧭 下一步: 运行 loopx-flow approve contract $feature --prepare，把输出评论粘贴到 PR，然后重跑本命令。" >&2
                echo "🧭 如确实要走本机 TTY 确认：追加 --interactive。" >&2
                exit 1
            fi
        fi
    else
        command -v gh >/dev/null 2>&1 || { echo "[-] [FAIL-CLOSED] independent approve 需要 gh" >&2; exit 1; }
        executor="$(gh_login)"
        [[ -n "$executor" ]] || { echo "[-] [FAIL-CLOSED] 无法读取 gh api user login" >&2; exit 1; }
        principal="$(find_gate1_independent_comment "$feature" "$contract_sha" "$executor" "$spec_commit" || true)"
        [[ -n "$principal" ]] || { echo "[-] [FAIL-CLOSED] independent 缺少有效的第二 GitHub 账号 gate=1 评论（评论 contract_sha 必须等于最终锁定字节的 SHA）" >&2; exit 1; }
    fi

    local timestamp operator
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    operator="${principal:-${USER:-$(whoami)}}"

    echo "    契约 SHA256 指纹: $contract_sha (mode=$mode, principal=$principal)"
    local goal_id="$feature-goal"
    local configure_out
    if ! configure_out="$(run_loopx configure-goal --goal-id "$goal_id" --progress-review-contract-revision "$contract_sha" --execute 2>&1)"; then
        rm -f "$temp_contract"; wf_unregister_temp_file "$temp_contract"
        echo "[-] [FAIL-CLOSED] 契约 SHA256 物理锁定失败: $configure_out" >&2
        exit 1
    fi

    local agent="${LOOPX_AGENT_ID:-loopx-flow-agent}"
    local register_out
    if ! register_out="$(run_loopx register-agent --goal-id "$goal_id" --agent-id "$agent" --execute 2>&1)"; then
        if ! printf '%s' "$register_out" | grep -qiE 'already|exist|duplicate|idempot|已注册|已存在|重复'; then
            echo -e "${YELLOW}[WARN] register-agent 失败（非幂等冲突，继续审批但需人工核查）: ${register_out}${NC}" >&2
        fi
    fi
    local evidence
    if [[ "$mode" == "single_owner" ]]; then
        evidence="authorization_mode=single_owner;contract_sha=$contract_sha;spec_commit=$spec_commit;feature=$feature;principal=$principal;risk_acceptance=$(auth_accepted_by)@$(auth_accepted_at)"
    else
        evidence="authorization_mode=independent;contract_sha=$contract_sha;spec_commit=$spec_commit;feature=$feature;principal=$principal"
    fi
    local add_out todo_id
    if ! add_out="$(read_loopx_json todo.add --format json todo add --goal-id "$goal_id" --role user --task-class user_gate --text "Gate1 specification authorization: $feature" --decision-scope "other:goal:$contract_sha" --global-gate)"; then
        rm -f "$temp_contract"; echo "[-] [FAIL-CLOSED] 写 user_gate 授权记录失败: $add_out" >&2; exit 1
    fi
    todo_id="$(node -e 'const fs=require("fs");let d={};try{d=JSON.parse(fs.readFileSync(0,"utf8"))}catch(_){};process.stdout.write(String(d.todo_id||""))' <<< "$add_out")"
    [[ -n "$todo_id" ]] || { rm -f "$temp_contract"; echo "[-] [FAIL-CLOSED] user_gate 未返回 todo_id" >&2; exit 1; }
    local complete_out
    if ! complete_out="$(read_loopx_json todo.complete --format json todo complete --goal-id "$goal_id" --todo-id "$todo_id" --agent-id "$agent" --decision-outcome approve --evidence "$evidence")"; then
        rm -f "$temp_contract"; echo "[-] [FAIL-CLOSED] 完成 user_gate 授权记录失败: $complete_out" >&2; exit 1
    fi

    mv "$temp_contract" "$contract_file"
    wf_unregister_temp_file "$temp_contract"

    if [[ -f "$decision_file" ]]; then
        node -e '
const fs=require("fs");const file=process.argv[1],op=process.argv[2],ts=process.argv[3];
let text=fs.readFileSync(file,"utf8");const line="- **Status**: APPROVED BY HUMAN ("+op+"@"+ts+")";
if (/^- \*\*Status\*\*: .*$/m.test(text)) text=text.replace(/^- \*\*Status\*\*: .*$/m,line); else text=line+"\n"+text;
fs.writeFileSync(file,text);
' "$decision_file" "$principal" "$timestamp"
    fi
    if [[ -f "$index_file" ]]; then
        node -e '
const fs=require("fs");const file=process.argv[1];let text=fs.readFileSync(file,"utf8");
if (/\*{0,2}Contract Status\*{0,2}\s*[:：]/.test(text)) text=text.replace(/^.*\*{0,2}Contract Status\*{0,2}\s*[:：].*$/m,"- **Contract Status**: FROZEN & APPROVED");
if (/\*{0,2}Current Status\*{0,2}\s*[:：]/.test(text)) text=text.replace(/^.*\*{0,2}Current Status\*{0,2}\s*[:：].*$/m,"- **Current Status**: APPROVED (Stage 5 TDD Ready)");
fs.writeFileSync(file,text);
' "$index_file"
    fi

    if ! sync_global_required "$goal_id"; then
        echo "[-] [FAIL-CLOSED] 契约已锁定成功，但 sync-global 失败（已锁定、未同步）" >&2
        exit 1
    fi
    echo "[✓] 断点 1 方案与规格审批通过；契约已锁定。"
}

cmd_check() {
    local with_ocr=false feature="" goal_id=""
    local -a args=("$@")
    local i arg
    for ((i=0; i<${#args[@]}; i++)); do
        arg="${args[$i]}"
        case "$arg" in
            --with-ocr) with_ocr=true ;;
            --goal-id)
                goal_id="${args[$((i+1))]:-}"
                i=$((i+1))
                ;;
            -*) ;;
            *)
                if [[ -z "$feature" ]]; then feature="$arg"; fi
                ;;
        esac
    done

    local branch
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
    if [[ -z "$feature" && "$branch" =~ ^feature/(.+) ]]; then
        feature="${BASH_REMATCH[1]}"
    fi
    # Issue 修复分支直接绑定每 Issue Goal；feature 保持为空，不写 05-evidence。
    if [[ -z "$feature" && -z "$goal_id" && "$branch" =~ ^fix/issue-([0-9]+) ]]; then
        goal_id="issue-${BASH_REMATCH[1]}-goal"
        echo -e "    ${BLUE}[i] 从修复分支 $branch 推断 Issue Goal: $goal_id${NC}"
    fi

    if [[ -z "$feature" && -z "$goal_id" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] check 无法解析 Goal 身份：既不在 feature/<name> 或 fix/issue-<id> 分支，也没有显式 feature 或 --goal-id。${NC}" >&2
        echo -e "💡 为什么阻断？没有 Goal 就无法核验 change-quality 严格收据，不能进入交付。${NC}" >&2
        echo -e "🛠️ 修复指令: 检出 feature/<name> / fix/issue-<id> 分支，或执行: loopx-flow check --goal-id <goal-id>${NC}" >&2
        exit 1
    fi
    if [[ "$with_ocr" == "true" && -z "$feature" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] --with-ocr 只适用于 Feature 胶囊（OCR 证据需回写 05-evidence）；Issue 修复不写 05-evidence。${NC}" >&2
        exit 1
    fi
    local resolved_goal="${goal_id:-${feature}-goal}"

    # 前置解析真实远程默认基线（GitHub Issue #13）：失败必须早于四大门禁。
    local cq_base_ref
    if ! cq_base_ref="$(resolve_change_quality_base_ref)"; then
        echo -e "${RED}[-] [FAIL-CLOSED] 无法解析远程默认基线：origin/HEAD / origin/main / origin/master 均不存在。${NC}" >&2
        echo -e "[-] 为什么阻断？change-quality prepare/record/verify 必须绑定可解析的远程基线。${NC}" >&2
        echo -e "🛠️ 修复指令: git fetch origin && git remote set-head origin -a" >&2
        exit 1
    fi

    # 前置诊断 Goal 资格：未启用则 fail-closed，不再空跑四大门禁。
    preflight_change_quality_qualification "$resolved_goal" check

    echo -e "${BLUE}======================================================================${NC}"
    echo -e "${BLUE}        执行本地四大硬门禁与代码质量一体化自检                          ${NC}"
    echo -e "${BLUE}======================================================================${NC}"

    if [[ -n "$feature" ]]; then
        local contract_file="$PROJECT_ROOT/specs/features/$feature/04-contract.md"
        local archive_contract="$PROJECT_ROOT/specs/archive/$feature/04-contract.md"
        if [[ -f "$contract_file" || -f "$archive_contract" ]]; then
            echo -e "${BOLD}[0/3] 先验证冻结节契约 (gate verify contract)...${NC}"
            if ! "$WORKFLOW_ROOT/bin/loopx-flow" ${REGISTRY_ARGS[@]+"${REGISTRY_ARGS[@]}"} gate verify contract "$feature"; then
                echo -e "${RED}[-] [FAIL-CLOSED] 契约门禁未通过，禁止进入 check。${NC}" >&2
                exit 1
            fi
        fi
    fi

    echo -e "${BOLD}[1/3] 正在运行本地四大硬门禁 (Typecheck, Lint, Build, Test)...${NC}"
    wf_run_dir check
    gate_results_file="$WF_RUN_DIR/gate-results.json"
    node -e '
const fs = require("fs");
fs.writeFileSync(process.argv[1], JSON.stringify({ schema_version: "loopx_flow_gate_results_v0", gates: [] }, null, 2));
' "$gate_results_file"
    local gate_failed=0 gate_name gate_out gate_code gate_status
    for gate_name in typecheck lint build test; do
        if [[ "$gate_failed" -ne 0 ]]; then
            node -e '
const fs = require("fs");
const file = process.argv[1], name = process.argv[2];
const d = JSON.parse(fs.readFileSync(file, "utf8"));
d.gates = d.gates.filter((g) => g.name !== name);
d.gates.push({ name, command: "npm run " + name, exit_code: null, status: "not_run" });
fs.writeFileSync(file, JSON.stringify(d, null, 2));
' "$gate_results_file" "$gate_name"
            continue
        fi
        if gate_out="$(cd "$PROJECT_ROOT" && gate_child_env npm run "$gate_name" 2>&1)"; then
            gate_code=0; gate_status="passed"
        else
            gate_code=$?; gate_status="failed"
        fi
        echo "$gate_out"
        node -e '
const fs = require("fs");
const file = process.argv[1], name = process.argv[2], code = process.argv[3], status = process.argv[4];
const d = JSON.parse(fs.readFileSync(file, "utf8"));
d.gates = d.gates.filter((g) => g.name !== name);
d.gates.push({ name, command: "npm run " + name, exit_code: Number(code), status });
fs.writeFileSync(file, JSON.stringify(d, null, 2));
' "$gate_results_file" "$gate_name" "$gate_code" "$gate_status"
        if [[ "$gate_code" -ne 0 ]]; then gate_failed=1; fi
    done
    # 把本次实测固化为 PR 可直接引用的证据（带 head，避免用旧结果冒充新提交）。
    local gate_state_dir="$PROJECT_ROOT/.loopx/state" # loopx-allow: run-state dir under the project, ignored by git
    mkdir -p "$gate_state_dir"
    node -e '
const fs = require("fs");
const [src, dst, head] = process.argv.slice(1);
const d = JSON.parse(fs.readFileSync(src, "utf8"));
d.head = head;
fs.writeFileSync(dst, JSON.stringify(d, null, 2));
' "$gate_results_file" "$gate_state_dir/gate-results.json" "$(git -C "$PROJECT_ROOT" rev-parse HEAD 2>/dev/null || echo '')"
    if [[ "$gate_failed" -ne 0 ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 四大硬门禁未全绿；仍会写 05-evidence 的 failed/not_run 实测，但禁止进入交付。${NC}" >&2
        echo -e "    四门禁实测结果文件: $gate_results_file" >&2
    else
        echo -e "    ${GREEN}[✓] 四大硬门禁 100% 全绿通过！${NC}"
    fi

    echo -e "\n${BOLD}[2/3] 正在执行代码级审查与质量适配映射...${NC}"
    if [[ "$with_ocr" == "true" && "$gate_failed" -eq 0 ]]; then
        echo -e "    检测到启用阿里 OCR 选配项，调用技能内自闭环脚本..."
        "$WORKFLOW_ROOT/skills/open-code-review/run-ocr.sh" "$cq_base_ref" "$feature" "$gate_results_file"
    else
        echo -e "    调用默认语义契约审查并送入 LoopX Quality 适配器..."
        node "$WORKFLOW_ROOT/skills/code-review/scripts/ingest-to-loopx-quality.js" ${feature:+--feature "$feature"} --goal-id "$resolved_goal" --base-ref "$cq_base_ref" --gate-results "$gate_results_file"
    fi
    if [[ "$gate_failed" -ne 0 ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 四门禁未全绿；已写 05-evidence 实测状态，交付阻断。${NC}" >&2
        exit 1
    fi

    echo -e "\n${BOLD}[3/3] 正在核验 LoopX change-quality 严格收据凭据 (Fail-Closed)...${NC}"
    if ! command -v loopx >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] 严格收据核验失败: 未检测到 loopx CLI，禁止进入交付阶段。${NC}" >&2
        echo -e "💡 为什么阻断？质量门禁收据核验是强阻断项，必须依赖 LoopX 校验不可篡改凭据。" >&2
        echo -e "🛠️ 修复指令: 安装 loopx (python3 -m pip install --upgrade loopx) 后重试。" >&2 # loopx-allow: install hint text
        exit 1
    fi
    local cq_json cq_ok
    cq_json="$(read_loopx_json change-quality.verify change-quality verify --goal-id "$resolved_goal" --repo-path "$PROJECT_ROOT" --base-ref "$cq_base_ref" --format json || echo '{}')"
    cq_ok="$(node -e '
const fs = require("fs");
let d = {};
try { d = JSON.parse(fs.readFileSync(0, "utf8")); } catch (e) {}
process.stdout.write(d.ok === true ? "true" : "false");
' <<< "$cq_json")"
    if [[ "$cq_ok" != "true" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] LoopX change-quality 收据核验未通过 (ok=false)，禁止进入交付阶段。${NC}" >&2
        echo -e "${RED}    请先运行 prepare/review 并记录与当前 exact-scope 对齐的通过收据。${NC}" >&2
        exit 1
    fi
    echo -e "    ${GREEN}[✓] 严格收据核验通过 (ok=true)。${NC}"

    echo -e "${GREEN}======================================================================${NC}"
    echo -e "${GREEN}[✓] 本地门禁、代码审查与质量收据 100% 通过！${NC}"
    if [[ -n "$feature" && -d "$PROJECT_ROOT/specs/features/$feature" ]]; then
        echo -e "${GREEN}    凭据已同步写入: specs/features/$feature/05-evidence.md${NC}"
    else
        echo -e "${GREEN}    严格收据已记录到 Goal: $resolved_goal (无 feature 胶囊，未写 05-evidence)${NC}"
    fi
    echo -e "${GREEN}======================================================================${NC}"
}
# review 的本地参数校验（唯一实现，review #73 P0）：
# 只判定不依赖外部 CLI 的非法输入（缺 PR 号；--model / --reasoning-effort / --agent-bin
# 的缺失值、空值、换行/空白/控制字符与非法 reasoning-effort 枚举）。
# dispatch 能力门之前调用一次（只校验），cmd_review 在能力门之后调用一次并填充
# REVIEW_PASS_ARGS 透传给审查管线；两处共用同一判据与文案，避免口径漂移。
# 返回值刻意全部写成 `return 1` 而非 `exit 1`：能力门之前的调用点自行决定退出。
review_parse_local_args() {
    REVIEW_PASS_ARGS=()
    local pr_id="${1:-}"
    [[ "$pr_id" == "--help" || "$pr_id" == "-h" ]] && return 0
    # 位置参数必须是 PR 编号；flag 前置（如 `review --model gpt`）不得被当成 PR 号，
    # 否则参数诊断会被后续 gh/能力探针掩盖（review #73 P0 复审 finding）。
    if [[ -z "$pr_id" || "$pr_id" == -* ]]; then
        echo -e "${RED}[-] 错误: 请指定 PR 编号，例如: loopx-flow review 12${NC}" >&2
        return 1
    fi
    shift || true
    local flag token cleaned
    while [[ $# -gt 0 ]]; do
        flag="$1"
        case "$flag" in
            --cross-validate|--rebuild-body|--force-recheck) REVIEW_PASS_ARGS+=("$flag"); shift ;;
            --agent-bin|--agent-bin=*|--model|--model=*|--reasoning-effort|--reasoning-effort=*)
                if [[ "$flag" == *=* ]]; then
                    token="${flag#*=}"; flag="${flag%%=*}"; shift
                else
                    # 末位缺值时必须显式报「为空」，不能 `shift 2` 让 set -e 静默退出。
                    token="${2:-}"
                    if [[ $# -ge 2 ]]; then shift 2; else shift; fi
                fi
                if [[ "$flag" == "--agent-bin" ]]; then
                    if [[ -z "$token" || "$token" == --* ]]; then echo -e "${RED}[-] [FAIL-CLOSED] --agent-bin 需要 codex 或 claude${NC}" >&2; return 1; fi
                    cleaned="$(printf '%s' "$token" | tr -d '[:cntrl:][:space:]')"
                    if [[ "$cleaned" != "$token" ]]; then echo -e "${RED}[-] [FAIL-CLOSED] --agent-bin 含换行、空白或控制字符，拒绝执行${NC}" >&2; return 1; fi
                    REVIEW_PASS_ARGS+=("--agent-bin" "$token")
                    continue
                fi
                if [[ -z "$token" || "$token" == --* ]]; then echo -e "${RED}[-] [FAIL-CLOSED] $flag 为空，拒绝执行${NC}" >&2; return 1; fi
                cleaned="$(printf '%s' "$token" | tr -d '[:cntrl:][:space:]')"
                if [[ "$cleaned" != "$token" ]]; then echo -e "${RED}[-] [FAIL-CLOSED] $flag 含换行、空白或控制字符，拒绝执行${NC}" >&2; return 1; fi
                if [[ "$flag" == "--reasoning-effort" ]]; then
                    case "$token" in
                        none|minimal|low|medium|high|xhigh|max|ultra) ;;
                        *) echo -e "${RED}[-] [FAIL-CLOSED] --reasoning-effort 非法值 \"${token}\"，允许: none|minimal|low|medium|high|xhigh|max|ultra${NC}" >&2; return 1 ;;
                    esac
                fi
                REVIEW_PASS_ARGS+=("$flag" "$token") ;;
            *) shift ;;
        esac
    done
}

cmd_review() {
    local pr_id="${1:-}"
    if [[ "$pr_id" == "--help" || "$pr_id" == "-h" ]]; then
        cat << 'HELPTXT'
用法: loopx-flow review <pr_id> [options]

可选参数（default-off：未传且未设置对应环境变量时，不向 codex/claude 附加模型参数）:
  --agent-bin <codex|claude>     审查执行器，默认 codex（或 REVIEW_AGENT_BIN）
  --model <id>                   透传模型。优先级: 该参数 > REVIEW_MODEL > runtime 默认
                                 codex: -m <id>；claude: --model <id>
  --reasoning-effort <level>     透传推理强度。优先级: 该参数 > REVIEW_REASONING_EFFORT > runtime 默认
                                 允许: none|minimal|low|medium|high|xhigh|max|ultra
                                 codex: -c model_reasoning_effort=<level>；claude: --effort <level>
  --cross-validate               用另一 runtime 交叉核验
  --rebuild-body                 用胶囊重建 PR body
  --force-recheck                跳过同 head 短路

空值、换行/空白/控制字符、非法 reasoning-effort 一律 Fail-Closed，不静默忽略。
传给 CLI 的是原始模型 ID；declared_model 只发布产品家族名，不携带 router/gateway/endpoint。
HELPTXT
        exit 0
    fi
    # 与 dispatch 前的本地校验复用同一实现（review #73 P0），此处只负责填充透传参数；
    # 判定失败时以同一诊断信息退出。
    review_parse_local_args "$@" || exit 1
    local -a pass=()
    [[ ${#REVIEW_PASS_ARGS[@]} -gt 0 ]] && pass=("${REVIEW_PASS_ARGS[@]}")

    if ! command -v gh >/dev/null 2>&1; then
        echo -e "${RED}[-] 错误: 未安装 gh CLI，无法执行交付审查。${NC}" >&2
        exit 1
    fi

    echo -e "${BLUE}==> [交付审查 L2] 正在执行真实模型审查管线 (LoopX check-result 核验)...${NC}"
    local repo
    repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || echo '')"
    if [[ -z "$repo" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 无法解析 owner/repo，拒绝执行无锚定审查。${NC}" >&2
        exit 1
    fi

    local review_draft
    review_draft="$(gh pr view "$pr_id" --json isDraft --jq '.isDraft' 2>/dev/null || true)"
    if [[ "$review_draft" == "true" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] PR #$pr_id 仍是 Draft：先 loopx-flow pr ready，再发布 formal review。${NC}" >&2
        exit 1
    fi

    # Infer target feature from current branch (feature/<name>) for capsule evidence
    local feature=""
    local cur_branch
    cur_branch="$(git branch --show-current 2>/dev/null || echo "")"
    if [[ "$cur_branch" =~ ^feature/(.+) ]]; then
        feature="${BASH_REMATCH[1]}"
    fi

    local args=(--pr "$pr_id" --repo "$repo")
    [[ -n "$feature" ]] && args+=(--feature "$feature")
    if [[ ${#pass[@]} -gt 0 ]]; then
        args+=("${pass[@]}")
    fi

    # 编排器场景显式开启降载三件套（head-oid 幂等短路 + 节流 + comment upsert），
    # 避免同一 head 在 CI/自动化会话中反复打爆 GitHub 限流阈值。
    # 人工本地裸跑 node authentic-review.js 时不注入这些 env，行为与改造前一致。
    export REVIEW_SHORTCIRCUIT="${REVIEW_SHORTCIRCUIT:-1}"
    export REVIEW_DEBOUNCE_SECONDS="${REVIEW_DEBOUNCE_SECONDS:-60}"
    export REVIEW_UPSERT_PUBLISH="${REVIEW_UPSERT_PUBLISH:-1}"

    if ! node "$WORKFLOW_ROOT/skills/code-review/scripts/authentic-review.js" "${args[@]}"; then
        echo -e "${RED}[-] [FAIL-CLOSED] 真实审查管线未通过 (NOT_VERIFIED / HEAD 漂移 / 门禁失败 / check-result 拒绝)。${NC}" >&2
        exit 1
    fi
    echo -e "${GREEN}[✓] Authentic 审查管线完成：真实 findings 已核验并发布至 PR ${pr_id}。${NC}"
}


cmd_respond() {
    local pr_id="${1:-}"
    shift || true
    local result_file=""
    local resolutions_file=""
    local dry_run="false"

    if [[ "$pr_id" == "--help" || "$pr_id" == "-h" || -z "$pr_id" ]]; then
        cat << 'HELPTXT'
用法: loopx-flow respond <pr_id> [--result-file <path>] [--resolutions-file <path>] [--dry-run]
说明: 复用 LoopX `pr-review` 的 `review_template` 五段式格式（动机/改动思路/具体改动/对主干的风险/我的整体评价），
      基于原生评审缓存 (.loopx/cache/reviews/<pr>@<head>.json) 逐项闭环 Review findings，并附带实测验证矩阵。
      失败一票熔断：找不到原生评审产物或门禁不通过时拒绝发布。
HELPTXT
        exit 0
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --result-file) result_file="${2:-}"; shift 2 ;;
            --resolutions-file) resolutions_file="${2:-}"; shift 2 ;;
            --dry-run) dry_run="true"; shift ;;
            *) shift ;;
        esac
    done

    local repo
    repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || echo "")"
    if [[ -z "$repo" ]]; then
        echo -e "${RED}[-] 错误: 无法获取 GitHub repo 标识。${NC}" >&2
        exit 1
    fi

    local head_oid
    head_oid="$(gh pr view "$pr_id" --json headRefOid --jq .headRefOid 2>/dev/null || echo "")"
    if [[ -z "$head_oid" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 无法获取 PR #$pr_id 的 HEAD commit，PR 不存在或无访问权限！${NC}" >&2
        exit 1
    fi
    local short_sha="${head_oid:0:9}"

    echo -e "${BLUE}==> [Review 回复] 复用 LoopX 原生五段式格式，执行门禁实测并生成逐项闭环汇报 (Commit $short_sha)...${NC}"

    # 真实执行验证，失败一票熔断 (Fail-Closed)
    echo -e "    [1/5] 执行 Typecheck..."
    if ! gate_child_env npm run typecheck >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] Typecheck 失败，阻断回复发布！${NC}" >&2
        exit 1
    fi

    echo -e "    [2/5] 执行 Lint..."
    if ! gate_child_env npm run lint >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] Lint 失败，阻断回复发布！${NC}" >&2
        exit 1
    fi

    echo -e "    [3/5] 执行 Build..."
    if ! gate_child_env npm run build >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] Build 失败，阻断回复发布！${NC}" >&2
        exit 1
    fi

    echo -e "    [4/5] 执行 Test..."
    if ! gate_child_env npm test >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] Test 失败，阻断回复发布！${NC}" >&2
        exit 1
    fi

    echo -e "    [5/5] 执行 LoopX Status..."
    local loopx_status="PASSED"
    if command -v loopx >/dev/null 2>&1; then
        # 只核验本次交付的 Goal：全局 status 会因其它项目的 stale goal 非 0，
        # 那与本次回复无关，不应阻断（也不能因此跳过核验）。
        local respond_goal="" respond_branch
        respond_branch="$(git -C "$PROJECT_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
        if [[ "$respond_branch" =~ ^fix/issue-([0-9]+) ]]; then
            respond_goal="issue-${BASH_REMATCH[1]}-goal"
        fi
        local -a respond_status_args=(status)
        if [[ -n "$respond_goal" ]]; then
            respond_status_args+=(--goal-id "$respond_goal")
        fi
        if ! run_loopx "${respond_status_args[@]}" >/dev/null 2>&1; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX status 检查失败，阻断回复发布！${NC}" >&2
            exit 1
        fi
    else
        loopx_status="SKIPPED"
    fi

    local gates_json
    gates_json="$(printf '{"typecheck":"PASSED","lint":"PASSED","build":"PASSED","test":"PASSED","loopx_status":"%s"}' "$loopx_status")"

    local helper_args=(--pr "$pr_id" --head "$head_oid" --review-dir "$LOOPX_REVIEW_CACHE_DIR" --gates-json "$gates_json")
    [[ -n "$result_file" ]] && helper_args+=(--result-file "$result_file")
    [[ -n "$resolutions_file" ]] && helper_args+=(--resolutions-file "$resolutions_file")

    if [[ "$dry_run" == "true" ]]; then
        if ! node "$WORKFLOW_ROOT/skills/code-review/scripts/respond-report.js" "${helper_args[@]}" --print; then
            echo -e "${RED}[-] [FAIL-CLOSED] 原生格式回复生成失败（dry-run），未发布。${NC}" >&2
            exit 1
        fi
        echo -e "${GREEN}[✓] dry-run 完成：未向 PR 发布评论。${NC}"
        exit 0
    fi

    # 流优先（ADR-0013 / §2.1）：正文通过 stdout 捕获并由 stdin 管道直传 gh，零临时文件。
    local report_body
    if ! report_body="$(node "$WORKFLOW_ROOT/skills/code-review/scripts/respond-report.js" "${helper_args[@]}" --print)"; then
        echo -e "${RED}[-] [FAIL-CLOSED] 原生格式回复生成失败（缺少评审产物或格式不符），未发布。${NC}" >&2
        exit 1
    fi

    if [[ -z "$report_body" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 回复报告正文为空，拒绝发布。${NC}" >&2
        exit 1
    fi

    # T2 comment upsert: 编排器场景检索既有 respond 标记 comment；命中 → PATCH，未命中 → POST
    # 标记行置于正文尾部（HTML 注释，页面不可见），与 review 侧 upsert 保持一致，不破坏首行结构
    local marker="<!-- loopx-flow:respond:${pr_id}@${short_sha} -->"
    local posted_body
    posted_body="${report_body}

${marker}"
    local existing_comment_id=""
    if [[ "${REVIEW_UPSERT_PUBLISH:-1}" == "1" ]]; then
        if existing_comment_id="$(gh api "repos/${repo}/issues/${pr_id}/comments?per_page=100" 2>/dev/null \
            | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{try{const a=JSON.parse(d);const m=a.find(c=>c.body&&c.body.includes(process.argv[1]));process.stdout.write(m?String(m.id):'')}catch(_){process.stdout.write('')}})" "$marker" 2>/dev/null || true)"; then
            if [[ -n "$existing_comment_id" ]]; then
                echo -e "${YELLOW}[THROTTLE-UPSERT] 复用既有 respond comment id=${existing_comment_id}（PATCH 更新，不再新增）${NC}"
                if printf '%s' "$posted_body" | gh api -X PATCH "repos/${repo}/issues/comments/${existing_comment_id}" -F body=@- >/dev/null 2>&1; then
                    echo -e "${GREEN}[✓] 已更新既有 respond 汇报（comment ${existing_comment_id}，head ${short_sha}）！${NC}"
                    exit 0
                fi
                echo -e "${YELLOW}[i] PATCH 失败，回退 POST 新建${NC}"
            fi
        fi
    fi
    if ! printf '%s' "$posted_body" | gh pr comment "$pr_id" --repo "$repo" --body-file -; then
        echo -e "${RED}[-] [FAIL-CLOSED] gh pr comment 失败，回复未发布。${NC}" >&2
        exit 1
    fi
    echo -e "${GREEN}[✓] 已发布 LoopX 原生五段式更新汇报至 PR #${pr_id}（head ${short_sha}）！${NC}"
}

cmd_pr() {
    local sub="${1:-}"
    shift || true

    if [[ "$sub" == "--help" || "$sub" == "-h" || -z "$sub" ]]; then
        cat << 'HELPTXT'
用法:
  loopx-flow pr create [feature] [--title "feat(...)"] [--base "main"] [--draft]
  loopx-flow pr create --issue <id> [--goal-id <gid>] [--impact R0|R1|R2]
  loopx-flow pr preview [feature]
  loopx-flow pr update <pr_id> [feature]
  loopx-flow pr ready <pr_id>

说明:
  按照 LoopX PR #7545 官方标准，从特性胶囊与真实 Git Diff 自动生成双语 4-Part 结构的 PR 描述（包含动机剖析、架构思路、关键代码逐文件讲解、主干风险及四大门禁实测矩阵），并直接发起或更新 GitHub PR。
  --issue 模式从 Issue 正文生成动机/风险，并在 body 写入 loopx-meta / loopx-impact 机器标记（不读 Feature 胶囊）。
HELPTXT
        exit 0
    fi

    local current_branch
    current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
    if [[ "$current_branch" == "main" || "$current_branch" == "master" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 严禁在主干分支直接操作 PR。请检出特性分支 (feature/<name>)。${NC}" >&2
        exit 1
    fi

    local feature=""
    local title=""
    local pr_id=""

    case "$sub" in
        preview)
            feature="${1:-}"
            if [[ -z "$feature" ]]; then
                if [[ "$current_branch" =~ ^feature/(.+) ]]; then
                    feature="${BASH_REMATCH[1]}"
                elif [[ "$current_branch" =~ ^fix/(.+) ]]; then
                    feature="${BASH_REMATCH[1]}"
                fi
            fi
            if [[ -z "$feature" ]]; then
                echo -e "${RED}[-] 错误: 请指定特性名称或检出 feature/<name> 分支。${NC}" >&2
                exit 1
            fi
            node "$WORKFLOW_ROOT/skills/code-review/scripts/authentic-review.js" --generate-pr-body --feature "$feature"
            ;;
        create)
            local base="main"
            local draft="false"
            local issue_id="" goal_id="" impact="" impact_explicit="false"
            local contract_impact="none"
            local -a adrs=()
            local passthru_args=()
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --title)
                        [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --title 需要取值${NC}" >&2; exit 1; }
                        title="$2"
                        shift 2
                        ;;
                    --base)
                        [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --base 需要取值${NC}" >&2; exit 1; }
                        base="$2"
                        shift 2
                        ;;
                    --issue)
                        [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --issue 需要 Issue 编号${NC}" >&2; exit 1; }
                        issue_id="$2"
                        shift 2
                        ;;
                    --goal-id)
                        [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --goal-id 需要取值${NC}" >&2; exit 1; }
                        goal_id="$2"
                        shift 2
                        ;;
                    --impact)
                        [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --impact 需要取值 R0|R1|R2${NC}" >&2; exit 1; }
                        impact="$2"
                        impact_explicit="true"
                        shift 2
                        ;;
                    --contract-impact)
                        [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --contract-impact 需要取值 none|changed${NC}" >&2; exit 1; }
                        contract_impact="$2"
                        shift 2
                        ;;
                    --adr)
                        [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --adr 需要取值 docs/adr/*.md${NC}" >&2; exit 1; }
                        adrs+=("$2")
                        shift 2
                        ;;
                    --draft)
                        draft="true"; shift ;;
                    --no-draft)
                        draft="false"; shift ;;
                    *)
                        if [[ -z "$feature" && -z "$issue_id" ]]; then
                            feature="$1"
                            shift
                        else
                            passthru_args+=("$1")
                            shift
                        fi
                        ;;
                esac
            done

            if ! command -v gh >/dev/null 2>&1; then
                echo -e "${RED}[-] 错误: 未安装 gh CLI，无法自动创建 PR。${NC}" >&2
                exit 1
            fi

            if [[ -n "$issue_id" ]]; then
                # Issue 修复模式：不要求 Feature 胶囊，PR body 从 Issue 正文生成并写入机器标记。
                if [[ ! "$issue_id" =~ ^[0-9]+$ ]]; then
                    echo -e "${RED}[-] [FAIL-CLOSED] 非法 --issue ${issue_id}（只接受数字编号）${NC}" >&2
                    exit 1
                fi
                [[ -n "$goal_id" ]] || goal_id="issue-${issue_id}-goal"
                # 未显式传 --impact 时从 Issue 正文读取（loopx-impact 标记或 Impact: 行），
                # 与 cmd_issue 同一解析，避免 R0 纯文档 Issue 被静默写成 R1。
                if [[ "$impact_explicit" != "true" ]]; then
                    local issue_impact_probe issue_impact_parsed
                    issue_impact_probe="$(gh issue view "$issue_id" --json body --jq '.body // ""' 2>/dev/null || true)"
                    if [[ -n "$issue_impact_probe" ]]; then
                        issue_impact_parsed="$(printf '%s' "$issue_impact_probe" | issue_impact_from_body)"
                        case "$issue_impact_parsed" in
                            R0|R1|R2) impact="$issue_impact_parsed" ;;
                            INVALID:*)
                                echo -e "${RED}[-] [FAIL-CLOSED] Issue #$issue_id 的 impact 分级非法（${issue_impact_parsed#INVALID:}），只接受 R0|R1|R2。${NC}" >&2
                                exit 1 ;;
                        esac
                    fi
                fi
                [[ -n "$impact" ]] || impact="R1"
                if [[ ! "$impact" =~ ^R[012]$ ]]; then
                    echo -e "${RED}[-] [FAIL-CLOSED] 非法影响分级 --impact ${impact}（只接受 R0|R1|R2）${NC}" >&2
                    exit 1
                fi
                if [[ ! "$contract_impact" =~ ^(none|changed)$ ]]; then
                    echo -e "${RED}[-] [FAIL-CLOSED] 非法 --contract-impact ${contract_impact}（只接受 none|changed）${NC}" >&2
                    exit 1
                fi
                if [[ "$contract_impact" == "changed" && ${#adrs[@]} -eq 0 ]]; then
                    echo -e "${RED}[-] [FAIL-CLOSED] --contract-impact changed 必须用 --adr 指明至少一份 ADR（merge 会核验其在 PR head 上为 Accepted）。${NC}" >&2
                    exit 1
                fi
                if [[ "$current_branch" =~ ^fix/issue-([0-9]+) && "${BASH_REMATCH[1]}" != "$issue_id" ]]; then
                    echo -e "${YELLOW}[WARN] 当前分支 $current_branch 与 --issue $issue_id 不一致。${NC}" >&2
                fi
            elif [[ -z "$feature" ]]; then
                if [[ "$current_branch" =~ ^feature/(.+) ]]; then
                    feature="${BASH_REMATCH[1]}"
                elif [[ "$current_branch" =~ ^fix/(.+) ]]; then
                    feature="${BASH_REMATCH[1]}"
                fi
            fi
            if [[ -z "$feature" && -z "$issue_id" ]]; then
                echo -e "${RED}[-] 错误: 请指定特性名称、--issue <id>，或检出 feature/<name> 分支。${NC}" >&2
                exit 1
            fi

            if [[ -z "$title" && -n "$issue_id" ]]; then
                local issue_title
                issue_title="$(gh issue view "$issue_id" --json title --jq .title 2>/dev/null || true)"
                title="fix(issue-${issue_id}): ${issue_title:-resolve issue #$issue_id}"
            fi
            if [[ -z "$title" ]]; then
                title="feat(${feature}): implement ${feature} aligned with PR #7545 protocol"
            fi

            local pr_body
            if [[ -n "$issue_id" ]]; then
                wf_run_dir pr-create
                local issue_body_file="$WF_RUN_DIR/issue-${issue_id}-body.md"
                wf_register_temp_file "$issue_body_file"
                if ! gh issue view "$issue_id" --json body --jq '.body // ""' > "$issue_body_file" 2>/dev/null || [[ ! -s "$issue_body_file" ]]; then
                    wf_unregister_temp_file "$issue_body_file"
                    rm -f "$issue_body_file"
                    echo -e "${RED}[-] [FAIL-CLOSED] 无法读取 Issue #$issue_id 正文，拒绝生成无动机的 PR。${NC}" >&2
                    exit 1
                fi
                local -a body_args=(--generate-pr-body --issue-body-file "$issue_body_file" --impact "$impact" --goal-id "$goal_id")
                local gate_evidence="$PROJECT_ROOT/.loopx/state/gate-results.json" # loopx-allow: check 固化的实测证据
                if [[ -f "$gate_evidence" ]]; then body_args+=(--gate-results "$gate_evidence"); fi
                pr_body="$(node "$WORKFLOW_ROOT/skills/code-review/scripts/authentic-review.js" "${body_args[@]}")"
                wf_unregister_temp_file "$issue_body_file"
                rm -f "$issue_body_file"
                local adrs_json="[]"
                if [[ ${#adrs[@]} -gt 0 ]]; then
                    adrs_json="$(node -e 'process.stdout.write(JSON.stringify(process.argv.slice(1)))' "${adrs[@]}")"
                fi
                pr_body="${pr_body}

<!-- loopx-meta: {\"goal_id\":\"${goal_id}\"} -->
<!-- loopx-impact: {\"level\":\"${impact}\",\"issue\":${issue_id},\"contract_impact\":\"${contract_impact}\",\"adrs\":${adrs_json},\"regression\":[\"tests/unit/issues/issue-${issue_id}.test.js\"],\"rollback\":\"revert the squash commit of this PR\"} -->"
            else
                pr_body="$(node "$WORKFLOW_ROOT/skills/code-review/scripts/authentic-review.js" --generate-pr-body --feature "$feature")"
            fi

            echo -e "${BLUE}==> [PR 提交] 正在通过 GitHub CLI 创建 PR (对齐 PR #7545 双语 4-Part 体系)...${NC}"
            local pr_url pr_err_file pr_err marker="" draft_hint=""
            local -a draft_args=()
            if [[ "$draft" == "true" ]]; then
                draft_args=(--draft)
                draft_hint=" --draft"
            fi
            # Issue 修复没有 Feature 胶囊，也没有 Gate1，因此不落 presentation 标记。
            if [[ -n "$feature" ]]; then marker="$(presentation_state_file "$feature")"; fi
            wf_run_dir pr-create
            pr_err_file="$WF_RUN_DIR/gh-pr-create.err"
            wf_register_temp_file "$pr_err_file"
            if pr_url="$(printf '%s' "$pr_body" | gh pr create --title "$title" --base "$base" --body-file - ${draft_args[@]+"${draft_args[@]}"} ${passthru_args[@]+"${passthru_args[@]}"} 2>"$pr_err_file")"; then
                wf_unregister_temp_file "$pr_err_file"
                rm -f "$pr_err_file"
                if [[ -n "$marker" ]]; then rm -f "$marker"; fi
                echo -e "${GREEN}[✓] PR 创建成功: ${pr_url}${NC}"
                echo "presentation=published"
            else
                pr_err="$(tr '\n' ' ' < "$pr_err_file" 2>/dev/null | cut -c1-400 || true)"
                wf_unregister_temp_file "$pr_err_file"
                rm -f "$pr_err_file"
                if [[ -n "$marker" ]]; then
                    # presentation=pending 必须可观测且持久：Gate1 approve 读取该标记并 BLOCK（不再是 WARN）。
                    mkdir -p "$(dirname "$marker")"
                    node -e '
const fs = require("fs");
const [file, feature, draft, reason] = process.argv.slice(1);
fs.writeFileSync(file, JSON.stringify({
  schema_version: "loopx_flow_presentation_v0",
  feature,
  presentation: "pending",
  draft: draft === "true",
  reason,
  recorded_at: new Date().toISOString()
}, null, 2) + "\n");
' "$marker" "$feature" "$draft" "${pr_err:-gh pr create failed}"
                    echo -e "${RED}[-] PR 创建失败（presentation=pending）。${NC}" >&2
                else
                    echo -e "${RED}[-] PR 创建失败（Issue 修复路径无 Feature 胶囊，不写 presentation 标记）。${NC}" >&2
                fi
                if [[ -n "$pr_err" ]]; then
                    echo -e "    gh 输出: ${pr_err}${NC}" >&2
                fi
                if [[ -n "$issue_id" ]]; then
                    echo -e "🛠️ 修复指令: 修复 gh 认证/网络后重跑 loopx-flow pr create --issue $issue_id --goal-id ${goal_id} --impact ${impact}${draft_hint}。${NC}" >&2
                else
                    echo -e "🛠️ 修复指令: 修复 gh 认证/网络后重跑 loopx-flow pr create $feature${draft_hint}；presentation=pending 会阻断 Gate1 approve。${NC}" >&2
                fi
                exit 1
            fi
            ;;
        update)
            local upd_issue="" upd_goal="" upd_impact="" upd_contract="none" upd_title=""
            local -a upd_adrs=()
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --issue)
                        [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --issue 需要 Issue 编号${NC}" >&2; exit 1; }
                        upd_issue="$2"; shift 2 ;;
                    --goal-id)
                        [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --goal-id 需要取值${NC}" >&2; exit 1; }
                        upd_goal="$2"; shift 2 ;;
                    --impact)
                        [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --impact 需要取值 R0|R1|R2${NC}" >&2; exit 1; }
                        upd_impact="$2"; shift 2 ;;
                    --contract-impact)
                        [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --contract-impact 需要取值 none|changed${NC}" >&2; exit 1; }
                        upd_contract="$2"; shift 2 ;;
                    --adr)
                        [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --adr 需要取值 docs/adr/*.md${NC}" >&2; exit 1; }
                        upd_adrs+=("$2"); shift 2 ;;
                    --title)
                        [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --title 需要取值${NC}" >&2; exit 1; }
                        upd_title="$2"; shift 2 ;;
                    -*)
                        echo -e "${RED}[-] 错误: 未知参数 $1${NC}" >&2; exit 1 ;;
                    *)
                        if [[ -z "$pr_id" ]]; then pr_id="$1"; elif [[ -z "$feature" ]]; then feature="$1"; fi
                        shift ;;
                esac
            done
            if [[ -z "$pr_id" ]]; then
                echo -e "${RED}[-] 错误: 请指定待更新的 PR 编号，例如: loopx-flow pr update 13${NC}" >&2
                exit 1
            fi
            if [[ -z "$upd_issue" && "$current_branch" =~ ^fix/issue-([0-9]+) ]]; then
                upd_issue="${BASH_REMATCH[1]}"
            fi
            if [[ -z "$feature" && -z "$upd_issue" ]]; then
                if [[ "$current_branch" =~ ^feature/(.+) ]]; then
                    feature="${BASH_REMATCH[1]}"
                elif [[ "$current_branch" =~ ^fix/(.+) ]]; then
                    feature="${BASH_REMATCH[1]}"
                fi
            fi
            if [[ -z "$feature" && -z "$upd_issue" ]]; then
                echo -e "${RED}[-] 错误: 请指定特性名称、--issue <id>，或检出 feature/<name> 分支。${NC}" >&2
                exit 1
            fi

            local pr_body
            if [[ -n "$upd_issue" ]]; then
                if [[ ! "$upd_issue" =~ ^[0-9]+$ ]]; then
                    echo -e "${RED}[-] [FAIL-CLOSED] 非法 --issue ${upd_issue}（只接受数字编号）${NC}" >&2
                    exit 1
                fi
                [[ -n "$upd_goal" ]] || upd_goal="issue-${upd_issue}-goal"
                [[ -n "$upd_impact" ]] || upd_impact="R1"
                if [[ ! "$upd_impact" =~ ^R[012]$ ]]; then
                    echo -e "${RED}[-] [FAIL-CLOSED] 非法影响分级 --impact ${upd_impact}（只接受 R0|R1|R2）${NC}" >&2
                    exit 1
                fi
                if [[ ! "$upd_contract" =~ ^(none|changed)$ ]]; then
                    echo -e "${RED}[-] [FAIL-CLOSED] 非法 --contract-impact ${upd_contract}（只接受 none|changed）${NC}" >&2
                    exit 1
                fi
                if [[ "$upd_contract" == "changed" && ${#upd_adrs[@]} -eq 0 ]]; then
                    echo -e "${RED}[-] [FAIL-CLOSED] --contract-impact changed 必须用 --adr 指明至少一份 ADR（merge 会核验其在 PR head 上为 Accepted）。${NC}" >&2
                    exit 1
                fi
                wf_run_dir pr-update
                local upd_body_file="$WF_RUN_DIR/issue-${upd_issue}-body.md"
                wf_register_temp_file "$upd_body_file"
                if ! gh issue view "$upd_issue" --json body --jq '.body // ""' > "$upd_body_file" 2>/dev/null || [[ ! -s "$upd_body_file" ]]; then
                    wf_unregister_temp_file "$upd_body_file"
                    rm -f "$upd_body_file"
                    echo -e "${RED}[-] [FAIL-CLOSED] 无法读取 Issue #$upd_issue 正文。${NC}" >&2
                    exit 1
                fi
                local -a upd_args=(--generate-pr-body --issue-body-file "$upd_body_file" --impact "$upd_impact" --goal-id "$upd_goal")
                local upd_gate_evidence="$PROJECT_ROOT/.loopx/state/gate-results.json" # loopx-allow: check 固化的实测证据
                if [[ -f "$upd_gate_evidence" ]]; then upd_args+=(--gate-results "$upd_gate_evidence"); fi
                pr_body="$(node "$WORKFLOW_ROOT/skills/code-review/scripts/authentic-review.js" "${upd_args[@]}")"
                wf_unregister_temp_file "$upd_body_file"
                rm -f "$upd_body_file"
                local upd_adrs_json="[]"
                if [[ ${#upd_adrs[@]} -gt 0 ]]; then
                    upd_adrs_json="$(node -e 'process.stdout.write(JSON.stringify(process.argv.slice(1)))' "${upd_adrs[@]}")"
                fi
                pr_body="${pr_body}

<!-- loopx-meta: {\"goal_id\":\"${upd_goal}\"} -->
<!-- loopx-impact: {\"level\":\"${upd_impact}\",\"issue\":${upd_issue},\"contract_impact\":\"${upd_contract}\",\"adrs\":${upd_adrs_json},\"regression\":[\"tests/unit/issues/issue-${upd_issue}.test.js\"],\"rollback\":\"revert the squash commit of this PR\"} -->"
            else
                pr_body="$(node "$WORKFLOW_ROOT/skills/code-review/scripts/authentic-review.js" --generate-pr-body --feature "$feature")"
            fi

            echo -e "${BLUE}==> [PR 更新] 正在更新 PR #${pr_id} 描述 (对齐 PR #7545 双语 4-Part 体系)...${NC}"
            local -a edit_args=(--body-file -)
            if [[ -n "$upd_title" ]]; then edit_args+=(--title "$upd_title"); fi
            if printf '%s' "$pr_body" | gh pr edit "$pr_id" "${edit_args[@]}"; then
                echo -e "${GREEN}[✓] PR #${pr_id} 描述已成功更新！${NC}"
            else
                echo -e "${RED}[-] PR 更新失败。${NC}" >&2
                exit 1
            fi
            ;;
        ready)
            pr_id="${1:-}"
            shift || true
            if [[ -z "$pr_id" ]]; then
                echo -e "${RED}[-] 错误: 请指定 PR 编号，例如: loopx-flow pr ready 13${NC}" >&2
                exit 1
            fi
            if ! command -v gh >/dev/null 2>&1; then
                echo -e "${RED}[-] 错误: 未安装 gh CLI，无法转换 PR 状态。${NC}" >&2
                exit 1
            fi
            local is_draft
            is_draft="$(gh pr view "$pr_id" --json isDraft --jq '.isDraft' 2>/dev/null || true)"
            if [[ "$is_draft" != "true" ]]; then
                echo -e "${YELLOW}[i] PR #$pr_id 已非 Draft，无需转换。${NC}"
                exit 0
            fi
            if ! gh pr ready "$pr_id"; then
                echo -e "${RED}[-] [FAIL-CLOSED] PR #$pr_id 转 Ready 失败。${NC}" >&2
                exit 1
            fi
            echo -e "${GREEN}[✓] PR #$pr_id 已转为 Ready（不代表合并授权；Gate2 仍须 Mode A/B 授权）。${NC}"
            ;;
        *)
            echo -e "${RED}[-] 未知操作: ${sub}。可用操作: create, preview, update, ready${NC}" >&2
            exit 1
            ;;
    esac
}

cmd_release_approve() {
    local pr_id="${1:-}" yes="false" prepare="false" interactive="false" arg
    shift || true
    for arg in "$@"; do
        case "$arg" in
            --yes) yes="true" ;;
            --prepare) prepare="true" ;;
            --interactive) interactive="true" ;;
        esac
    done
    if [[ -z "$pr_id" ]]; then
        echo "[-] 错误: 请指定 PR 编号，例如: loopx-flow release-approve 12" >&2
        exit 1
    fi
    command -v gh >/dev/null 2>&1 || { echo "[-] [FAIL-CLOSED] release-approve 需要 gh" >&2; exit 1; }
    auth_require_config
    local mode
    mode="$(auth_mode)"
    [[ "$mode" == "single_owner" ]] || { echo "[-] [FAIL-CLOSED] release-approve 只用于 single_owner" >&2; exit 1; }
    [[ "$yes" != "true" ]] || { echo "[-] [FAIL-CLOSED] 不支持 --yes：授权必须来自 accepted_by 的 GitHub 评论或 --interactive TTY" >&2; exit 1; }

    local principal accepted_by
    principal="$(gh_login)"
    accepted_by="$(auth_accepted_by)"
    [[ -n "$principal" ]] || { echo "[-] [FAIL-CLOSED] 无法读取 gh api user login" >&2; exit 1; }
    [[ -n "$accepted_by" ]] || { echo "[-] [FAIL-CLOSED] 缺少 single_owner risk acceptance" >&2; exit 1; }

    local pr_view head_oid head_ref is_draft
    pr_view="$(gh pr view "$pr_id" --json headRefOid,headRefName,isDraft --jq '[.headRefOid, .headRefName, ((.isDraft // false) | tostring)] | join("%")' 2>/dev/null || true)"
    [[ -n "$pr_view" ]] || { echo "[-] [FAIL-CLOSED] 无法读取 PR #$pr_id" >&2; exit 1; }
    IFS="%" read -r head_oid head_ref is_draft <<< "$pr_view"
    [[ "$is_draft" != "true" ]] || { echo "[-] [FAIL-CLOSED] PR #$pr_id 仍为 Draft：先 pr ready，再签发 release-approve。" >&2; exit 1; }
    local feature=""
    feature="$(resolve_pr_feature "$pr_id" "$head_ref")"
    local contract_sha="none"
    if [[ -n "$feature" ]]; then
        contract_sha="$(contract_sha_for "$feature" || true)"
        [[ -n "$contract_sha" ]] || { echo "[-] [FAIL-CLOSED] 缺少 feature ${feature} 的 04-contract.md" >&2; exit 1; }
    else
        echo "[WARN] Issue Goal / 非 feature PR 不绑定 Feature 契约：Gate2 评论 contract_sha=none。" >&2
    fi

    # 本 PR 自己新增/修改的 ADR：Gate2 评论里必须带 Owner 的 `adr-accepted:` 行，
    # 否则 merge 的 ADR 自证防护会阻断（作者不能给自己的 ADR 写 Accepted 就算数）。
    local adr_accept_lines=""
    adr_accept_lines="$(release_adr_accept_lines "$pr_id" 2>/dev/null || true)"

    # ADR-0019：--prepare 只打印 GitHub 签名评论模板，零写入。
    if [[ "$prepare" == "true" ]]; then
        echo "[i] Gate2 准备完成（未写入任何授权评论）"
        echo "    pr           : #$pr_id"
        echo "    head         : $head_oid"
        echo "    contract_sha : $contract_sha"
        echo "    principal    : $accepted_by"
        if [[ -n "$adr_accept_lines" ]]; then
            echo "    adr          : $(printf '%s' "$adr_accept_lines" | sed 's/^adr-accepted: //' | paste -sd, - 2>/dev/null || true)"
        fi
        echo ""
        echo "请在 PR #${pr_id} 上以 ${accepted_by} 身份粘贴以下评论，然后重跑 loopx-flow merge ${pr_id}："
        echo ""
        echo "<!-- loopx-flow:release-authorization:$pr_id@$head_oid -->"
        echo "gate=2;mode=single_owner;head=$head_oid;contract_sha=$contract_sha;principal=$accepted_by;risk_acceptance=$(auth_accepted_by)@$(auth_accepted_at)"
        if [[ -n "$adr_accept_lines" ]]; then
            printf '%s\n' "$adr_accept_lines"
        fi
        exit 0
    fi

    # GitHub 签名路径：已存在合法 gate=2 评论即视为授权完成（不重复写）。
    if release_authorization_ok "$pr_id" "$head_oid" "$contract_sha"; then
        echo "[✓] 已检测到 Gate2 GitHub 授权评论（author=${accepted_by}, head=${head_oid}）"
        exit 0
    fi

    if [[ "$interactive" != "true" ]]; then
        echo "[-] [FAIL-CLOSED] 未找到 accepted_by=$accepted_by 的 Gate2 GitHub 授权评论（head 与 contract_sha 必须与当前一致）。" >&2
        echo "🧭 下一步: 运行 loopx-flow release-approve $pr_id --prepare，把输出评论粘贴到 PR，然后重跑 loopx-flow merge ${pr_id}。" >&2
        echo "🧭 如确实要走本机 TTY 确认：追加 --interactive。" >&2
        exit 1
    fi

    [[ "$principal" == "$accepted_by" ]] || { echo "[-] [FAIL-CLOSED] principal ($principal) != accepted_by ($accepted_by)" >&2; exit 1; }
    [[ -t 0 ]] || { echo "[-] [FAIL-CLOSED] --interactive 需要 TTY 交互确认" >&2; exit 1; }
    local confirm_reply=""
    printf '确认以 single_owner (%s) 签发 Gate2 发布授权 PR #%s? 请输入 yes 继续: ' "$principal" "$pr_id"
    if ! IFS= read -r confirm_reply; then
        echo "[-] [FAIL-CLOSED] 未收到交互确认输入，已取消。" >&2
        exit 1
    fi
    if [[ "$confirm_reply" != "yes" && "$confirm_reply" != "y" && "$confirm_reply" != "YES" ]]; then
        echo "[-] [FAIL-CLOSED] Gate2 发布授权已取消（需输入 yes 确认）。" >&2
        exit 1
    fi

    local timestamp
    timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    local body
    body="<!-- loopx-flow:release-authorization:$pr_id@$head_oid -->
gate=2;mode=single_owner;head=$head_oid;contract_sha=$contract_sha;principal=$principal;approved_at=$timestamp;risk_acceptance=$(auth_accepted_by)@$(auth_accepted_at)"
    if [[ -n "$adr_accept_lines" ]]; then
        body="${body}
${adr_accept_lines}"
    fi
    if ! gh pr comment "$pr_id" --body "$body" >/dev/null 2>&1; then
        echo "[-] [FAIL-CLOSED] 写入 release-authorization 评论失败" >&2
        exit 1
    fi
    echo "[✓] Mode B 发布授权已记录到 PR #$pr_id @ $head_oid (principal=$principal)"
}

cmd_status_next() {
    local feature="${1:-}"
    if [[ -z "$feature" ]]; then
        local branch
        branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
        if [[ "$branch" =~ ^feature/(.+) ]]; then feature="${BASH_REMATCH[1]}"; fi
    fi
    [[ -n "$feature" ]] || { echo "[-] 无法解析 feature；请指定 status --next <feature>" >&2; exit 1; }
    echo "Feature: $feature"
    echo "Read-only projection; no state mutation."
    local active_dir="$PROJECT_ROOT/specs/features/$feature"
    local archive_dir="$PROJECT_ROOT/specs/archive/$feature"
    if [[ ! -d "$active_dir" ]]; then
        if [[ -d "$archive_dir" ]]; then
            # 已合入并归档的特性不是「待授权」；只读投影必须反映归档事实。
            echo "Status: Archived (delivered)"
            echo "Next: none"
            echo "Reason: 该特性已交付并归档到 specs/archive/$feature/。"
            return 0
        fi
        echo "Status: Unknown feature"
        echo "Next: loopx-flow feature $feature"
        echo "Reason: specs/features/$feature/ 与 specs/archive/$feature/ 均不存在。"
        return 0
    fi
    local contract="$active_dir/04-contract.md"
    if [[ ! -f "$contract" ]] || ! grep -q 'FROZEN & APPROVED' "$contract" 2>/dev/null; then
        echo "Next: loopx-flow approve contract $feature"
        echo "Reason: 规格包尚未授权。"
        return 0
    fi
    local evidence="$PROJECT_ROOT/specs/features/$feature/05-evidence.md"
    if [[ ! -f "$evidence" ]] || ! grep -qi 'PASSING' "$evidence" 2>/dev/null; then
        echo "Next: loopx-flow check"
        echo "Reason: 尚未形成有效质量证据。"
        return 0
    fi
    echo "Next: loopx-flow pr ready <pr> && loopx-flow review <pr>"
    echo "Reason: 契约已批准、证据存在；进入交付审查（Gate2 未授权）。"
}

# Issue 正文的 impact 分级（唯一实现）：优先 loopx-impact 机器标记，其次 `Impact:` 行。
# 空输出 = 未声明；INVALID:<值> = 声明了非法值。cmd_issue 与 pr create --issue 共用。
issue_impact_from_body() {
    node -e '
let raw = "";
process.stdin.on("data", (c) => { raw += c; }).on("end", () => {
  const tag = /<!--\s*loopx-impact:\s*(\{[\s\S]*?\})\s*-->/.exec(raw);
  if (tag) {
    try {
      const marker = JSON.parse(tag[1]);
      if (marker && typeof marker.level === "string") {
        const level = marker.level.toUpperCase();
        process.stdout.write(/^R[012]$/.test(level) ? level : `INVALID:${marker.level}`);
        return;
      }
    } catch (e) { /* 落到人读行 */ }
  }
  const line = /(?:^|\n)[ \t]*(?:[-*][ \t]*)?\**[ \t]*impact[ \t]*\**[ \t]*[:：][ \t]*`?\**[ \t]*([A-Za-z0-9]+)/i.exec(raw);
  if (line) {
    const value = String(line[1] || "").toUpperCase();
    process.stdout.write(/^R[012]$/.test(value) ? value : `INVALID:${line[1]}`);
  }
});
'
}

# impact 标记等级解析（唯一实现）：与 merge_enforce_issue_impact 同一规则——
# 按本分支 Issue 编号优先匹配，匹配不到才兜底取最后一条；避免两处解析各读一条
# 标记导致「校验按 R1、Goal 门读 R0」的自相矛盾。
pr_impact_level() {
    local pr_id="$1" issue_id="$2" body
    body="$(gh pr view "$pr_id" --json body --jq '.body // ""' 2>/dev/null || true)"
    [[ -n "$body" ]] || return 0
    printf '%s' "$body" | node -e '
let raw = "";
process.stdin.on("data", (c) => { raw += c; }).on("end", () => {
  const issueId = String(process.argv[1] || "");
  const re = /<!--\s*loopx-impact:\s*(\{[\s\S]*?\})\s*-->/g;
  const found = [];
  let m;
  while ((m = re.exec(raw)) !== null) {
    try { found.push(JSON.parse(m[1])); } catch (e) { found.push(null); }
  }
  let pick = null;
  for (let i = found.length - 1; i >= 0; i -= 1) {
    if (found[i] && String(found[i].issue || "") === issueId) { pick = found[i]; break; }
  }
  if (!pick) pick = found.length ? found[found.length - 1] : null;
  if (pick && typeof pick.level === "string") process.stdout.write(pick.level.toUpperCase());
});
' "$issue_id"
}

# Issue 修复 PR 的影响分级检查（ADR-0023）：只对 fix/issue-<id> 分支生效。
# R0 免 Goal/Receipt 但出现任何代码文件即取消豁免；R1 必须有随 PR 变更的复现测试；
# R2 额外要求 rollback，contract_impact=changed 时要求 ADR 在 PR head 上为 Accepted。
merge_enforce_issue_impact() {
    local pr_id="$1" head_oid="$2" head_ref="$3" issue_id
    [[ "$head_ref" =~ ^fix/issue-([0-9]+) ]] || return 0
    issue_id="${BASH_REMATCH[1]}"

    local payload verdict
    payload="$(gh pr view "$pr_id" --json body,files --jq '{body: (.body // ""), files: [(.files // [])[].path]}' 2>/dev/null || true)"
    if [[ -z "$payload" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 无法读取 PR #$pr_id 的 body/files，无法核验 impact 分级。${NC}" >&2
        return 1
    fi
    verdict="$(node -e '
let raw = "";
process.stdin.on("data", (c) => { raw += c; }).on("end", () => {
  const issueId = process.argv[1];
  let p = {};
  try { p = JSON.parse(raw); } catch (e) { console.log("INVALID"); return; }
  const body = String(p.body || "");
  const files = new Set(Array.isArray(p.files) ? p.files.map((f) => String((f && f.path) || f)) : []);
  // PR body 里可能同时有 Issue 正文自带的标记和 pr create/update 生成的那一条。
  // 先按本分支 Issue 编号匹配，再兜底取最后一条（生成标记永远追加在正文末尾）。
  const re = /<!--\s*loopx-impact:\s*(\{[\s\S]*?\})\s*-->/g;
  const found = [];
  let hit;
  while ((hit = re.exec(body)) !== null) {
    try { found.push(JSON.parse(hit[1])); } catch (e) { found.push(null); }
  }
  if (!found.length) { console.log("MISSING"); return; }
  let marker = null;
  for (let i = found.length - 1; i >= 0; i -= 1) {
    if (found[i] && String(found[i].issue || "") === issueId) { marker = found[i]; break; }
  }
  if (!marker) {
    marker = found[found.length - 1];
    if (!marker) { console.log("INVALID"); return; }
    if (marker.issue !== undefined && String(marker.issue) !== issueId) { console.log("ISSUE_MISMATCH " + marker.issue); return; }
  }
  const level = String(marker.level || "").toUpperCase();
  if (!/^R[012]$/.test(level)) { console.log("INVALID"); return; }
  if (level === "R0") {
    const codeFiles = [...files].filter((f) => !/^(docs\/|\.github\/ISSUE_TEMPLATE\/|README|LICENSE|CHANGELOG|AGENTS\.md|GLOSSARY\.md)/.test(f));
    console.log(codeFiles.length ? "R0_WITH_CODE " + codeFiles.slice(0, 5).join(",") : "OK R0");
    return;
  }
  const regression = Array.isArray(marker.regression) ? marker.regression.map(String) : [];
  const required = regression.length ? regression : ["tests/unit/issues/issue-" + issueId + ".test.js"];
  const missing = required.filter((f) => !files.has(f));
  if (missing.length) { console.log("REGRESSION_MISSING " + missing.join(",")); return; }
  if (level === "R2") {
    if (!String(marker.rollback || "").trim()) { console.log("ROLLBACK_MISSING"); return; }
    const contract = String(marker.contract_impact || "none");
    if (contract === "changed") {
      const adrs = Array.isArray(marker.adrs) ? marker.adrs.map(String) : [];
      if (!adrs.length) { console.log("ADR_MISSING"); return; }
      // 本 PR 自己新增/修改的 ADR 不能靠作者自写「Accepted」自证，必须另有 Owner 授权。
      const inDiff = adrs.filter((a) => files.has(a));
      console.log("ADR_CHECK " + adrs.join(",") + "|" + inDiff.join(","));
      return;
    }
    if (contract !== "none") { console.log("INVALID"); return; }
  }
  console.log((regression.length ? "OK " : "WARN_NO_REGRESSION ") + level);
});
' "$issue_id" <<< "$payload")"

    local repo adr content list
    local -a adrs
    case "$verdict" in
        "OK R0")
            echo -e "    ${YELLOW}[i] impact:R0 纯文档/隔离配置 PR，免 check 收据，仍走 Gate2。${NC}"
            return 0 ;;
        R0_WITH_CODE*)
            echo -e "${RED}[-] [FAIL-CLOSED] PR 标记 impact:R0，但包含代码文件：${verdict#R0_WITH_CODE }。R0 豁免失效，请改为 R1/R2 并提供复现测试与 Goal。${NC}" >&2
            return 1 ;;
        "OK R1"|"OK R2")
            echo -e "    ${GREEN}[✓] impact:${verdict#OK } 回归路径已随 PR 变更${NC}"
            return 0 ;;
        WARN_NO_REGRESSION*)
            echo -e "    ${YELLOW}[WARN] loopx-impact 未声明 regression[]；已确认默认路径 tests/unit/issues/issue-$issue_id.test.js 在 PR 变更中（否则会以 REGRESSION_MISSING 阻断）。${NC}"
            return 0 ;;
        REGRESSION_MISSING*)
            echo -e "${RED}[-] [FAIL-CLOSED] impact 回归证据缺失：PR 未包含 ${verdict#REGRESSION_MISSING }。${NC}" >&2
            return 1 ;;
        ROLLBACK_MISSING)
            echo -e "${RED}[-] [FAIL-CLOSED] impact:R2 缺少 rollback 说明。${NC}" >&2
            return 1 ;;
        INVALID)
            echo -e "${RED}[-] [FAIL-CLOSED] PR body 的 loopx-impact 标记非法（level 只接受 R0|R1|R2）。${NC}" >&2
            return 1 ;;
        ADR_MISSING)
            echo -e "${RED}[-] [FAIL-CLOSED] impact:R2 且 contract_impact=changed，但 adrs[] 为空。${NC}" >&2
            return 1 ;;
        ADR_CHECK*)
            repo="$(github_repo || true)"
            if [[ -z "$repo" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 无法解析 GitHub 仓库，无法核验 ADR 状态。${NC}" >&2
                return 1
            fi
            list="${verdict#ADR_CHECK }"
            local changed_adrs="${list#*|}"
            list="${list%%|*}"
            IFS=',' read -r -a adrs <<< "$list"
            for adr in "${adrs[@]}"; do
                content="$(gh api "repos/$repo/contents/$adr?ref=$head_oid" -H "Accept: application/vnd.github.raw" 2>/dev/null || true)"
                # 本仓库 ADR 模板用「**状态**：Accepted」，英文 Status 只是别名；两种都要认。
                if ! printf '%s' "$content" | grep -Eq '(状态|[Ss]tatus)[^A-Za-z]{0,8}Accepted'; then
                    echo -e "${RED}[-] [FAIL-CLOSED] impact:R2 要求 $adr 在 PR head 上为 Accepted。${NC}" >&2
                    return 1
                fi
                # 自证防护：本 PR 自己新增/修改的 ADR，head 上的 Accepted 必须另有
                # accepted_by 在 PR 上绑定当前 head 的授权评论佐证，否则只是作者单方面声明。
                if [[ ",$changed_adrs," != *",$adr,"* ]]; then
                    :
                elif [[ "$(auth_mode)" != "single_owner" ]]; then
                    # independent 模式：非作者批准本身就是外部授权，ADR 接受由 Mode A 覆盖。
                    echo -e "    ${YELLOW}[i] independent 模式：$adr 由本 PR 新增/修改，接受证据由非作者批准覆盖。${NC}"
                else
                    local accepted_by comments_json
                    accepted_by="$(auth_accepted_by 2>/dev/null || true)"
                    if [[ -z "$accepted_by" ]]; then
                        echo -e "${RED}[-] [FAIL-CLOSED] 本 PR 变更了 $adr，但配置缺少 accepted_by，无法核验 ADR 接受授权。${NC}" >&2
                        return 1
                    fi
                    comments_json="$(gh api "repos/$repo/issues/$pr_id/comments" --paginate 2>/dev/null || true)"
                    if ! printf '%s' "$comments_json" | node -e '
let raw = "";
process.stdin.on("data", (c) => { raw += c; }).on("end", () => {
  const [login, adr, head] = process.argv.slice(1);
  let rows;
  try { rows = JSON.parse(raw.replace(/\]\s*\[/g, ",")); } catch (e) { process.exit(1); }
  if (!Array.isArray(rows)) process.exit(1);
  const ok = rows.some((r) => String((r.user || {}).login || "") === login
    && String(r.body || "").includes("adr-accepted: " + adr)
    && String(r.body || "").includes("head=" + head));
  process.exit(ok ? 0 : 1);
});
' "$accepted_by" "$adr" "$head_oid"; then
                        echo -e "${RED}[-] [FAIL-CLOSED] $adr 由本 PR 新增/修改，作者自写 Accepted 不能自证。${NC}" >&2
                        echo -e "    需要 ${accepted_by} 在 PR #$pr_id 上发布含 \`adr-accepted: $adr\` 与 \`head=$head_oid\` 的授权评论（\`release-approve $pr_id --prepare\` 会自动带上该行）。${NC}" >&2
                        return 1
                    fi
                fi
            done
            echo -e "    ${GREEN}[✓] impact:R2 契约变更 ADR 已在 PR head 接受${NC}"
            if [[ -n "$changed_adrs" ]]; then
                echo -e "    ${GREEN}[✓] 本 PR 变更的 ADR 有 accepted_by 授权评论绑定 head $head_oid${NC}"
            fi
            return 0 ;;
        ISSUE_MISMATCH*)
            echo -e "${RED}[-] [FAIL-CLOSED] PR body 的 loopx-impact 标记属于 Issue #${verdict#ISSUE_MISMATCH }，与分支 issue #$issue_id 不一致。${NC}" >&2
            return 1 ;;
        MISSING)
            echo -e "    ${YELLOW}[WARN] PR body 缺少 loopx-impact 标记；按 impact:R1 处理，并核验默认复现测试。${NC}"
            if ! gh pr view "$pr_id" --json files --jq '.files[].path' 2>/dev/null | grep -Fxq "tests/unit/issues/issue-$issue_id.test.js"; then
                echo -e "${RED}[-] [FAIL-CLOSED] 缺少 loopx-impact 标记，且 PR 未包含 tests/unit/issues/issue-$issue_id.test.js。${NC}" >&2
                return 1
            fi
            return 0 ;;
        *)
            echo -e "${RED}[-] [FAIL-CLOSED] impact 核验输出无法识别: ${verdict}${NC}" >&2
            return 1 ;;
    esac
}

# Gate2 授权评论需要携带的 ADR 接受行：只针对本 PR 自己新增/修改的 ADR（自证防护）。
# 输出每行 `adr-accepted: <path>`；未声明 contract_impact=changed 时输出为空。
release_adr_accept_lines() {
    local pr_id="$1" payload
    payload="$(gh pr view "$pr_id" --json body,files --jq '{body: (.body // ""), files: [(.files // [])[].path]}' 2>/dev/null || true)"
    [[ -n "$payload" ]] || return 0
    node -e '
let raw = "";
process.stdin.on("data", (c) => { raw += c; }).on("end", () => {
  let p = {};
  try { p = JSON.parse(raw); } catch (e) { return; }
  const files = new Set(Array.isArray(p.files) ? p.files.map((f) => String((f && f.path) || f)) : []);
  const re = /<!--\s*loopx-impact:\s*(\{[\s\S]*?\})\s*-->/g;
  let m, marker = null;
  while ((m = re.exec(String(p.body || ""))) !== null) {
    try { marker = JSON.parse(m[1]); } catch (e) { /* 忽略非法标记，交给 merge 侧 fail-closed */ }
  }
  if (!marker || String(marker.contract_impact || "none") !== "changed") return;
  const adrs = Array.isArray(marker.adrs) ? marker.adrs.map(String) : [];
  for (const a of adrs) if (files.has(a)) console.log("adr-accepted: " + a);
});
' <<< "$payload"
}

cmd_merge() {
    local pr_id="" feature="" goal_id_flag=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --feature)
                [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --feature 需要取值${NC}" >&2; exit 1; }
                feature="$2"; shift 2 ;;
            --goal-id)
                [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --goal-id 需要取值${NC}" >&2; exit 1; }
                goal_id_flag="$2"; shift 2 ;;
            --)
                shift; break ;;
            -*)
                echo -e "${RED}[-] 错误: 未知参数 $1${NC}" >&2
                exit 1 ;;
            *)
                if [[ -z "$pr_id" ]]; then
                    pr_id="$1"
                elif [[ -z "$feature" ]]; then
                    feature="$1"
                else
                    echo -e "${RED}[-] 错误: 多余的位置参数 $1${NC}" >&2
                    exit 1
                fi
                shift ;;
        esac
    done

    if [[ -z "$pr_id" ]]; then
        echo -e "${RED}[-] 错误: 请指定 PR 编号，例如: loopx-flow merge 12${NC}" >&2
        exit 1
    fi

    local pr_view state merged_at decision head_oid head_ref base_ref
    pr_view="$(gh pr view "$pr_id" --json state,mergedAt,reviewDecision,headRefOid,headRefName,baseRefName --jq '[.state, (.mergedAt // ""), (.reviewDecision // ""), .headRefOid, .headRefName, .baseRefName] | join("%")' 2>/dev/null || echo "")"
    if [[ -z "$pr_view" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 无法读取 PR #$pr_id 状态，禁止合入。${NC}" >&2
        exit 1
    fi
    IFS="%" read -r state merged_at decision head_oid head_ref base_ref <<< "$pr_view"

    if [[ -z "$feature" && "$head_ref" =~ ^feature/(.+) ]]; then
        feature="${BASH_REMATCH[1]}"
    fi
    if [[ -z "$feature" && ! "$head_ref" =~ ^fix/issue-[0-9]+ ]]; then
        feature="$(resolve_pr_feature "$pr_id" "$head_ref")"
    fi
    # Goal 解析优先级：显式 --goal-id > fix/issue-<id> 分支 > feature > PR body loopx-meta。
    local merge_goal_id="$goal_id_flag"
    if [[ -z "$merge_goal_id" ]]; then
        if [[ "$head_ref" =~ ^fix/issue-([0-9]+) ]]; then
            merge_goal_id="issue-${BASH_REMATCH[1]}-goal"
        elif [[ -n "$feature" ]]; then
            merge_goal_id="${feature}-goal"
        else
            merge_goal_id="$(resolve_pr_goal_id "$pr_id" || true)"
        fi
    fi
    if [[ "$state" != "MERGED" && -z "$merged_at" ]]; then
        merge_enforce_issue_impact "$pr_id" "$head_oid" "$head_ref" || exit 1
    fi
    # R0 纯文档 / 首次接入没有 Goal：绝不能对未登记的 Goal 做 stop/retire/sync，
    # 否则合入后必然以「已合入、未闭环」非 0 退出（Review P0）。
    # 显式 --goal-id 是操作者断言，仍按原样传递；只有从分支/PR body 推导出的
    # Goal 才要求已登记，避免为 R0 凭空补偿一个不存在的 Goal。
    if [[ -z "$goal_id_flag" && -n "$merge_goal_id" && "$head_ref" =~ ^fix/issue-[0-9]+ ]] \
        && ! issue_goal_registered "$merge_goal_id"; then
        local derived_level derived_issue="${head_ref#fix/issue-}"
        derived_issue="${derived_issue%%[!0-9]*}"
        derived_level="$(pr_impact_level "$pr_id" "$derived_issue" || true)"
        if [[ "$derived_level" == "R0" ]]; then
            echo -e "    ${YELLOW}[i] impact:R0 不建 Goal，跳过 Goal 补偿步骤。${NC}"
            merge_goal_id=""
        else
            echo -e "${RED}[-] [FAIL-CLOSED] Goal ${merge_goal_id} 未登记：R1/R2 必须有 Goal 与 check 收据，不得静默跳过补偿。${NC}" >&2
            echo -e "    💡 修复: loopx-flow issue <id> --init-goal，或显式传 --goal-id <gid>（操作者断言）。" >&2
            exit 1
        fi
    fi
    local auth_mode_val=""
    if [[ -f "$(auth_config_path)" ]]; then
        # 文件在但解析失败或 mode 非法时，禁止退回「无配置」的 reviewDecision 路径（ADR-0009：非法配置即非 0）。
        auth_require_config
        auth_mode_val="$(auth_mode)"
        if [[ "$auth_mode_val" != "independent" && "$auth_mode_val" != "single_owner" ]]; then
            echo -e "${RED}[-] [FAIL-CLOSED] authorization_mode 无法解析，禁止退回 reviewDecision。${NC}" >&2
            exit 1
        fi
    fi
    local original_branch
    original_branch="$(git -C "$PROJECT_ROOT" branch --show-current 2>/dev/null || true)"

    echo -e "${BLUE}======================================================================${NC}"
    echo -e "${BLUE}        LoopX 原子 Squash 合并与目标归档核销 (Fail-Closed)            ${NC}"
    echo -e "${BLUE}======================================================================${NC}"

    local already_merged="false"
    if [[ "$state" == "MERGED" || -n "$merged_at" ]]; then
        already_merged="true"
        echo -e "${YELLOW}[i] PR #$pr_id 已处于 MERGED，跳过重复合并与 readiness，进入补偿模式。${NC}"
        # ADR-0012 T9：网页/管理员绕过 loopx-flow merge 时无法阻止，但必须留审计告警
        if [[ -n "$auth_mode_val" ]]; then
            if [[ "$auth_mode_val" == "single_owner" ]]; then
                local merged_contract_sha="none"
                if [[ -n "$feature" ]]; then
                    merged_contract_sha="$(contract_sha_for "$feature" 2>/dev/null || true)"
                fi
                if [[ -z "$merged_contract_sha" ]] || ! release_authorization_ok "$pr_id" "$head_oid" "$merged_contract_sha"; then
                    echo -e "${YELLOW}[WARN] 审计告警：PR #$pr_id 已 MERGED，但缺少绑定当前 head 的 release-authorization；可能为网页/管理员绕过 loopx-flow merge（Mode B 挡不住该路径，仅记录告警）。${NC}" >&2
                fi
            elif [[ "$auth_mode_val" == "independent" ]] && ! mode_a_review_ok "$pr_id" "$head_oid"; then
                echo -e "${YELLOW}[WARN] 审计告警：PR #$pr_id 已 MERGED，但未找到绑定当前 head 的非作者 APPROVED formal review；可能为管理员绕过 ruleset（仅记录告警）。${NC}" >&2
            fi
        fi
        if [[ -z "$head_oid" ]]; then
            head_oid="$(gh pr view "$pr_id" --json headRefOid --jq .headRefOid 2>/dev/null || echo "")"
        fi
    else
        echo -e "${BOLD}[1/4] 正在校验 GitHub PR 决议与 HEAD SHA...${NC}"
        if [[ -n "$auth_mode_val" ]]; then
            if pr_is_draft "$pr_id"; then
                echo -e "${RED}[-] [FAIL-CLOSED] PR #$pr_id 仍为 Draft：先 loopx-flow pr ready，再走 Gate2。${NC}" >&2
                exit 1
            fi
        fi
        if [[ "$auth_mode_val" == "single_owner" ]]; then
            local merge_operator accepted_owner
            merge_operator="$(gh_login || true)"
            accepted_owner="$(auth_accepted_by)"
            if [[ -z "$merge_operator" || "$merge_operator" != "$accepted_owner" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] Mode B 操作者身份校验失败: 当前 gh login (${merge_operator:-<empty>}) != accepted_by ($accepted_owner)${NC}" >&2
                exit 1
            fi
            local current_contract_sha="none"
            if [[ -n "$feature" ]]; then
                current_contract_sha="$(contract_sha_for "$feature" || true)"
                if [[ -z "$current_contract_sha" ]]; then
                    echo -e "${RED}[-] [FAIL-CLOSED] 缺少 specs/features/$feature/04-contract.md，无法核验 release-authorization 的 contract_sha。${NC}" >&2
                    exit 1
                fi
            fi
            if ! release_authorization_ok "$pr_id" "$head_oid" "$current_contract_sha"; then
                echo -e "${RED}[-] [FAIL-CLOSED] Mode B 缺少 release-authorization 评论，或 head/contract_sha/principal/risk_acceptance 与当前 PR 不一致${NC}" >&2
                exit 1
            fi
            if ! agent_comment_ok "$pr_id" "$head_oid"; then
                echo -e "${RED}[-] [FAIL-CLOSED] Mode B 当前 head 上缺少 Agent 的 COMMENT review（先 loopx-flow review <pr>）。${NC}" >&2
                exit 1
            fi
            echo -e "    ${GREEN}[✓] Mode B release-authorization 已绑定当前 head/contract，Agent COMMENT 在位${NC}"
        elif [[ "$auth_mode_val" == "independent" ]]; then
            if ! mode_a_review_ok "$pr_id" "$head_oid"; then
                echo -e "${RED}[-] [FAIL-CLOSED] 阻断: PR #$pr_id 未获得绑定当前 head 的非作者 APPROVED formal review（或仍为 Draft）${NC}" >&2
                exit 1
            fi
            echo -e "    ${GREEN}[✓] Mode A formal review 已绑定当前 head${NC}"
        else
            if [[ "$decision" != "APPROVED" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 阻断: PR #$pr_id 尚未在 GitHub 获得人类 APPROVED 审批！(当前状态: ${decision:-<empty>})${NC}" >&2
                echo -e "${RED}    请人类决策者在 GitHub PR 页面核验 8 项事实后点击 Approve，方可执行合并。${NC}" >&2
                exit 1
            fi
            echo -e "    ${GREEN}[✓] GitHub 审查决议确认: APPROVED${NC}"
        fi
        echo -e "    当前 PR 最新 HEAD SHA: ${BOLD}$head_oid${NC}"

        echo -e "\n${BOLD}[2/4] 调用 LoopX 原生合入就绪度物理锁核验 (Fail-Closed)...${NC}"
        if ! command -v loopx >/dev/null 2>&1; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 合入就绪度核验失败: 未检测到 loopx CLI，物理防偷跑锁无法核验，禁止合并。${NC}" >&2
            exit 1
        fi
        if [[ -n "$auth_mode_val" ]]; then
            if ! branch_protection_ok "$auth_mode_val" "${base_ref:-main}"; then
                exit 1
            fi
            echo -e "    ${GREEN}[✓] 分支保护满足 ${auth_mode_val}（必须走 PR + Four Gates）${NC}"
        fi
        local -a goal_flag=()
        if [[ -n "$merge_goal_id" ]]; then
            goal_flag=(--goal-id "$merge_goal_id")
        fi
        if [[ "$auth_mode_val" == "single_owner" ]]; then
            if ! mode_b_readiness_ok "$pr_id" "$head_oid" "$merge_goal_id"; then
                echo -e "${RED}[-] [FAIL-CLOSED] Mode B readiness 三档判定失败（blocking_reasons 命中允许列表/未知项/缺失）${NC}" >&2
                exit 1
            fi
            echo -e "    ${GREEN}[✓] Mode B readiness 通过${NC}"
        elif [[ "$auth_mode_val" == "independent" ]]; then
            if ! mode_a_readiness_ok "$pr_id" "$head_oid" "$merge_goal_id"; then
                echo -e "${RED}[-] [FAIL-CLOSED] Mode A readiness 未 ready=true: PR #$pr_id @ $head_oid${NC}" >&2
                exit 1
            fi
            echo -e "    ${GREEN}[✓] Mode A readiness ready=true${NC}"
        else
            if ! loopx pr-review ${goal_flag[@]+"${goal_flag[@]}"} --check-merge-readiness "${pr_id}@${head_oid}"; then
                echo -e "${RED}[-] [FAIL-CLOSED] LoopX 合入就绪度核验失败: PR #$pr_id @ ${head_oid:-<unknown>} 未通过物理防偷跑锁核验。${NC}" >&2
                exit 1
            fi
            echo -e "    ${GREEN}[✓] 物理防偷跑核验通过${NC}"
        fi
        local head_oid_now
        head_oid_now="$(gh pr view "$pr_id" --json headRefOid --jq .headRefOid 2>/dev/null || echo "$head_oid")"
        if [[ "$head_oid_now" != "$head_oid" ]]; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 合入就绪度核验失败: HEAD SHA 发生漂移 ($head_oid -> $head_oid_now)，禁止合并。${NC}" >&2
            exit 1
        fi
        echo -e "    ${GREEN}[✓] 物理防偷跑核验通过 (Lock: UNLOCKED @ $head_oid)。${NC}"
        echo -e "\n${BOLD}[3/4] 执行原子 Squash 合并并删除特性分支...${NC}"
        if ! gh pr merge "$pr_id" --squash --delete-branch --match-head-commit "$head_oid"; then
            echo -e "${RED}[-] [FAIL-CLOSED] gh pr merge 失败，禁止继续补偿。${NC}" >&2
            exit 1
        fi
        echo -e "    ${GREEN}[✓] GitHub PR 已成功 Squash 合入主干！${NC}"
    fi

    # Issue 修复没有 Feature 胶囊：收尾只做 Goal 停机/退役/同步，措辞不能复用 Feature 语汇。
    if [[ -n "$feature" ]]; then
        echo -e "\n${BOLD}[4/4] 特性资产胶囊归档与 Goal 生命周期补偿...${NC}"
    else
        echo -e "\n${BOLD}[4/4] Goal 生命周期收尾（Issue 修复无 Feature 胶囊）...${NC}"
    fi
    local -a step_names=() step_states=() step_details=()
    local failed=0
    local goal_id="$merge_goal_id"
    local teardown_reason="Feature delivered and archived"
    if [[ -z "$feature" ]]; then teardown_reason="Issue fix delivered (PR #$pr_id)"; fi

    if [[ -n "$goal_id" ]]; then
        if ! command -v loopx >/dev/null 2>&1; then
            echo -e "${RED}[-] [FAIL-CLOSED] 未检测到 loopx CLI，无法完成 Goal 停机/退役/同步补偿。${NC}" >&2
            exit 1
        fi

        local out status
        if out="$(run_loopx goal-lifecycle --goal-id "$goal_id" --operation stop --actor-kind controller --reason "$teardown_reason" --execute 2>&1)"; then
            step_names+=("stop"); step_states+=("done"); step_details+=("")
            echo -e "    ${GREEN}[✓] Goal $goal_id 已停机。${NC}"
        else
            status=$?
            if grep -Eiq "not found in (the )?registry|already stopped|already inactive|no .*transition|unchanged" <<< "$out"; then
                step_names+=("stop"); step_states+=("skipped"); step_details+=("already stopped")
                echo -e "    ${YELLOW}[i] Goal $goal_id 已停机，跳过。${NC}"
            else
                failed=1
                step_names+=("stop"); step_states+=("failed"); step_details+=("$out")
                echo -e "${RED}[-] Goal $goal_id 停机失败: $out${NC}" >&2
            fi
        fi

        if out="$(run_loopx retire-global-goal --goal-id "$goal_id" --execute 2>&1)"; then
            step_names+=("retire"); step_states+=("done"); step_details+=("")
            echo -e "    ${GREEN}[✓] 全局 Goal $goal_id 已退役。${NC}"
        else
            status=$?
            if grep -Eiq "not found in global registry|already retired|live source_registry|refusing to retire" <<< "$out"; then
                step_names+=("retire"); step_states+=("skipped"); step_details+=("live source registry / already retired")
                echo -e "    ${YELLOW}[i] 全局退役跳过（source registry 仍存活或已退役）。${NC}"
            else
                failed=1
                step_names+=("retire"); step_states+=("failed"); step_details+=("$out")
                echo -e "${RED}[-] 全局 Goal 退役失败: $out${NC}" >&2
            fi
        fi

        if out="$(run_loopx sync-global --goal-id "$goal_id" 2>&1)"; then
            step_names+=("sync"); step_states+=("done"); step_details+=("")
            echo -e "    ${GREEN}[✓] 全局 registry 已同步 ${goal_id}。${NC}"
        else
            status=$?
            failed=1
            step_names+=("sync"); step_states+=("failed"); step_details+=("$out")
            echo -e "${RED}[-] sync-global 失败: $out${NC}" >&2
        fi
    fi

    if [[ "$failed" -eq 0 && -n "$feature" ]]; then
        if [[ "${LOOPX_FLOW_MERGE_SKIP_GIT_SYNC:-0}" == "1" ]]; then
            if [[ -d "$PROJECT_ROOT/specs/features/$feature" ]]; then
                mkdir -p "$PROJECT_ROOT/specs/archive"
                if mv "$PROJECT_ROOT/specs/features/$feature" "$PROJECT_ROOT/specs/archive/$feature"; then
                    write_archive_state_snapshot "$feature" "$goal_id" "$PROJECT_ROOT/specs/archive/$feature"
                    step_names+=("archive"); step_states+=("done"); step_details+=("")
                    echo -e "    ${GREEN}[✓] 资产包已原子迁移至归档区: specs/archive/$feature/${NC}"
                else
                    failed=1
                    step_names+=("archive"); step_states+=("failed"); step_details+=("mv failed")
                fi
            elif [[ -d "$PROJECT_ROOT/specs/archive/$feature" ]]; then
                write_archive_state_snapshot "$feature" "$goal_id" "$PROJECT_ROOT/specs/archive/$feature"
                step_names+=("archive"); step_states+=("skipped"); step_details+=("already archived")
                echo -e "    ${YELLOW}[i] 资产包已在归档区，跳过。${NC}"
            else
                step_names+=("archive"); step_states+=("skipped"); step_details+=("no capsule")
            fi
        else
            local base_branch="${base_ref:-main}"
            local dirty
            dirty="$(git -C "$PROJECT_ROOT" status --porcelain --untracked-files=no 2>/dev/null | grep -vE "^(..) (specs/archive/$feature/|specs/features/$feature/|\.loopx/)" || true)"
            if [[ -n "$dirty" ]]; then
                failed=1
                step_names+=("archive"); step_states+=("failed"); step_details+=("dirty worktree; base checkout skipped")
                echo -e "${RED}[-] 工作区存在 unrelated 未提交文件，跳过 base 切换与归档（不冒险覆盖）:${NC}" >&2
                echo "$dirty" | sed 's/^/    /' >&2
            elif (cd "$PROJECT_ROOT" && git fetch origin "$base_branch" && git checkout "$base_branch" && git pull --ff-only origin "$base_branch") >/dev/null 2>&1; then
                if [[ -d "$PROJECT_ROOT/specs/features/$feature" && ! -d "$PROJECT_ROOT/specs/archive/$feature" ]]; then
                    mkdir -p "$PROJECT_ROOT/specs/archive"
                    if (cd "$PROJECT_ROOT" && (git mv "specs/features/$feature" "specs/archive/$feature" 2>/dev/null || mv "specs/features/$feature" "specs/archive/$feature")); then
                        write_archive_state_snapshot "$feature" "$goal_id" "$PROJECT_ROOT/specs/archive/$feature"
                        step_names+=("archive"); step_states+=("done"); step_details+=("")
                        echo -e "    ${GREEN}[✓] 资产包已原子迁移至归档区: specs/archive/$feature/${NC}"
                    else
                        failed=1
                        step_names+=("archive"); step_states+=("failed"); step_details+=("mv failed")
                    fi
                elif [[ -d "$PROJECT_ROOT/specs/archive/$feature" ]]; then
                    write_archive_state_snapshot "$feature" "$goal_id" "$PROJECT_ROOT/specs/archive/$feature"
                    step_names+=("archive"); step_states+=("skipped"); step_details+=("already archived")
                    echo -e "    ${YELLOW}[i] 资产包已在归档区，跳过。${NC}"
                else
                    step_names+=("archive"); step_states+=("skipped"); step_details+=("no capsule")
                fi

                if [[ "$failed" -eq 0 ]]; then
                    (cd "$PROJECT_ROOT" && git add -A -- "specs/archive/$feature" >/dev/null 2>&1 || true)
                    (cd "$PROJECT_ROOT" && git ls-files --error-unmatch "specs/features/$feature" >/dev/null 2>&1 && git rm -r -q --cached --ignore-unmatch "specs/features/$feature" || true)
                    if (cd "$PROJECT_ROOT" && ! git diff --cached --quiet); then
                        if (cd "$PROJECT_ROOT" && git commit -m "chore($feature): archive capsule after merge" >/dev/null 2>&1); then
                            if (cd "$PROJECT_ROOT" && git push origin "$base_branch" >/dev/null 2>&1); then
                                step_names+=("push"); step_states+=("done"); step_details+=("")
                                echo -e "    ${GREEN}[✓] 本地 $base_branch 已同步并推送 archive 移动。${NC}"
                            else
                                local archive_branch="chore/archive-$feature" archive_pr_url=""
                                if (cd "$PROJECT_ROOT" && git checkout -B "$archive_branch" >/dev/null 2>&1 && git push -f -u origin "$archive_branch" >/dev/null 2>&1); then
                                    archive_pr_url="$(cd "$PROJECT_ROOT" && gh pr create --base "$base_branch" --head "$archive_branch" --title "chore($feature): archive capsule after merge" --body "Automated capsule archival after PR #$pr_id squash merge." 2>/dev/null || true)"
                                    (cd "$PROJECT_ROOT" && git checkout "$base_branch" >/dev/null 2>&1 && git reset --hard "origin/$base_branch" >/dev/null 2>&1 || true)
                                    if [[ -n "$archive_pr_url" ]]; then
                                        step_names+=("push"); step_states+=("pr_created"); step_details+=("$archive_pr_url")
                                        echo -e "    ${YELLOW}[i] 远端 $base_branch 受保护拦截直推，已创建归档 PR: $archive_pr_url${NC}"
                                    else
                                        failed=1
                                        step_names+=("push"); step_states+=("failed"); step_details+=("archive PR create failed")
                                    fi
                                else
                                    (cd "$PROJECT_ROOT" && git checkout "$base_branch" >/dev/null 2>&1 && git reset --hard "origin/$base_branch" >/dev/null 2>&1 || true)
                                    failed=1
                                    step_names+=("push"); step_states+=("failed"); step_details+=("push and archive branch push failed")
                                fi
                            fi
                        else
                            failed=1
                            step_names+=("push"); step_states+=("failed"); step_details+=("archive commit failed")
                        fi
                    else
                        step_names+=("push"); step_states+=("skipped"); step_details+=("no archive diff")
                    fi
                fi
                if [[ -n "$original_branch" && "$original_branch" != "$base_branch" ]] && git -C "$PROJECT_ROOT" rev-parse --verify "$original_branch" >/dev/null 2>&1; then
                    git -C "$PROJECT_ROOT" checkout "$original_branch" >/dev/null 2>&1 || true
                fi
            else
                failed=1
                step_names+=("archive"); step_states+=("failed"); step_details+=("base refresh failed")
            fi
        fi
    fi

    echo -e "\n${BOLD}补偿步骤汇总:${NC}"
    local i
    for i in "${!step_names[@]}"; do
        echo -e "    - ${step_names[$i]}: ${step_states[$i]}${step_details[$i]:+ (${step_details[$i]})}"
    done

    if [[ "$failed" -ne 0 ]]; then
        echo -e "\n${RED}[-] [FAIL-CLOSED] PR #$pr_id 已合入，但 archive/stop/retire/sync 未闭环。${NC}" >&2
        echo -e "🛠️ 修复后重跑: loopx-flow merge $pr_id${merge_goal_id:+ --goal-id $merge_goal_id}" >&2
        exit 1
    fi

    echo -e "\n${GREEN}[✓] PR #$pr_id 交付全流程闭环完成！${NC}"
}
cmd_gate() {
    local subaction="${1:-}"
    local stage="${2:-}"
    local feature="${3:-}"

    if [[ "$subaction" != "verify" ]]; then
        echo -e "${RED}[-] 错误: 目前仅支持 gate verify <stage> <feature>${NC}" >&2
        exit 1
    fi

    if [[ -z "$stage" || -z "$feature" ]]; then
        echo -e "${RED}[-] 错误: 请指定阶段与特性名称，例如: loopx-flow gate verify contract user-auth${NC}" >&2
        exit 1
    fi

    case "$stage" in
        decisions)
            local decision_file="$PROJECT_ROOT/specs/features/$feature/01-decisions.md"
            if [[ ! -f "$decision_file" && -f "$PROJECT_ROOT/specs/archive/$feature/01-decisions.md" ]]; then
                decision_file="$PROJECT_ROOT/specs/archive/$feature/01-decisions.md"
            fi
            if [[ ! -f "$decision_file" ]]; then
                echo -e "${RED}[-] [GATE FAIL] 未找到决策文件: $decision_file${NC}" >&2
                exit 1
            fi
            if ! grep -Eq '^(status:[[:space:]]*APPROVED([[:space:]]|$)|[-*][[:space:]]*\*\*(Status|方案状态)\*\*(:|：).*APPROVED)' "$decision_file"; then
                echo -e "${RED}[-] [GATE FAIL] 阶段 1 架构决策未标记 APPROVED: $decision_file${NC}" >&2
                echo -e "💡 修复指令: 由人类决策者在 decisions frontmatter 落款 'status: APPROVED'（或 '- **Status**: APPROVED'）。" >&2
                exit 1
            fi
            echo -e "${GREEN}[✓] [GATE PASS] 阶段 1 架构决策签名通过: $decision_file${NC}"
            ;;
        contract)
            local contract_file="$PROJECT_ROOT/specs/features/$feature/04-contract.md"
            if [[ ! -f "$contract_file" && -f "$PROJECT_ROOT/specs/archive/$feature/04-contract.md" ]]; then
                contract_file="$PROJECT_ROOT/specs/archive/$feature/04-contract.md"
            fi
            if [[ ! -f "$contract_file" ]]; then
                echo -e "${RED}[-] [GATE FAIL] 未找到契约文件: $contract_file${NC}" >&2
                exit 1
            fi
            if ! grep -q -E "Contract-Status.*FROZEN & APPROVED" "$contract_file"; then
                echo -e "${RED}[-] [GATE FAIL] 阶段 4 契约未冻结或未批准: $contract_file${NC}" >&2
                exit 1
            fi

            # Double-anchor SHA256 physical verification against LoopX locked contract revision
            local current_sha
            if command -v node >/dev/null 2>&1; then
                current_sha="$(node -e 'const fs=require("fs"),crypto=require("crypto");console.log(crypto.createHash("sha256").update(fs.readFileSync(process.argv[1])).digest("hex"))' "$contract_file")"
            elif command -v sha256sum >/dev/null 2>&1; then
                current_sha="$(sha256sum "$contract_file" | awk '{print $1}')"
            else
                current_sha="$(LC_ALL=C shasum -a 256 "$contract_file" | awk '{print $1}')"
            fi

            local goal_id="${feature}-goal"
            local locked_sha=""
            local goal_found="false"
            # 允许测试/CI 用独立 registry 隔离（避免污染真实项目控制面状态，见 ADR-0007 INV-ENV-6）
            wf_require_registry
            local reg_file="$LOOPX_REGISTRY_PATH"
            if [[ ! -f "$reg_file" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 本地注册表缺失 ($reg_file)，无法核验控制面契约锁定状态！${NC}" >&2
                echo -e "💡 为什么阻断？契约标记为已冻结，但本地注册表未就绪，禁止绕过物理指纹核验。" >&2
                echo -e "🛠️ 修复指令: 运行 loopx bootstrap 初始化或运行 loopx-flow approve contract $feature 重新锁定。" >&2
                exit 1
            fi

            local check_info
            check_info="$(node -e '
                const fs = require("fs");
                try {
                    const reg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
                    const g = reg.goals?.find(item => item.id === process.argv[2] || item.goal_id === process.argv[2] || item.id === process.argv[3] || item.goal_id === process.argv[3]);
                    if (!g) {
                        process.stdout.write("NOT_FOUND:");
                    } else {
                        const rev = g?.control_plane?.progress_review?.contract_revision || g?.progress_review?.contract_revision || "";
                        process.stdout.write("FOUND:" + rev);
                    }
                } catch (e) {
                    process.stdout.write("NOT_FOUND:");
                }
            ' "$reg_file" "$goal_id" "${feature}-feature" 2>/dev/null || echo "NOT_FOUND:")"

            if [[ "$check_info" =~ ^FOUND:(.*) ]]; then
                goal_found="true"
                locked_sha="${BASH_REMATCH[1]}"
            fi

            if [[ "$goal_found" != "true" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 目标实体未在 LoopX 注册 (GOAL_NOT_FOUND: $goal_id)！${NC}" >&2
                echo -e "💡 为什么阻断？契约标记为 FROZEN & APPROVED，但注册表中未登记对应 Goal，存在虚假审批或状态脱管风险。" >&2
                echo -e "🛠️ 修复指令: 由决策者执行审批以锁定指纹: loopx-flow approve contract $feature" >&2
                exit 1
            fi

            if [[ -z "$locked_sha" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 契约尚未在 LoopX 控制面锁定指纹 (MISSING_LOCKED_CONTRACT_REVISION)！${NC}" >&2
                echo -e "    Goal: $goal_id 存在于 .loopx/registry.json 但未设置 progress_review.contract_revision" >&2
                echo -e "💡 为什么阻断？双重锚定要求契约必须具备控制面物理指纹锁定，缺失物理锁定视为未完成审批。" >&2
                echo -e "🛠️ 修复指令: 由决策者执行审批以锁定指纹: loopx-flow approve contract $feature" >&2
                exit 1
            fi

            if [[ "$locked_sha" != "$current_sha" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 契约已被篡改 (CONTRACT_TAMPERED)! 契约指纹不一致，门禁物理熔断！${NC}" >&2
                echo -e "    文件当前 SHA256: ${BOLD}$current_sha${NC}" >&2
                echo -e "    已锁定基线指纹: ${BOLD}$locked_sha${NC}" >&2
                echo -e "💡 为什么阻断？契约在批准后发生非授权变更，严禁在未重新审批的情况下私自变更接口与断言不变量。" >&2
                echo -e "🛠️ 修复指令: 还原契约文件修改，或由决策者重新执行: loopx-flow approve contract $feature" >&2
                exit 1
            fi
            gate1_verify_authorization "$feature" "$current_sha"
            echo -e "${GREEN}[✓] [GATE PASS] 阶段 4 契约双重锚定核验通过 (SHA256: $current_sha)${NC}"
            ;;
        *)
            echo -e "${RED}[-] 未知守卫阶段: $stage (可选: decisions, contract)${NC}" >&2
            exit 1
            ;;
    esac
}

cmd_context() {
    local feature="${1:-}"
    if [[ -z "$feature" ]]; then
        echo -e "${RED}[-] 错误: 请指定特性名称，例如: loopx-flow context hard-guard${NC}" >&2
        exit 1
    fi

    local index_file="$PROJECT_ROOT/specs/features/$feature/00-INDEX.md"
    if [[ -f "$index_file" ]]; then
        cat "$index_file"
    else
        echo -e "${YELLOW}未找到特性胶囊: $index_file${NC}"
    fi
}

write_archive_state_snapshot() {
    local feature="$1" goal_id="$2" archive_dir="$3"
    local reg_file="$LOOPX_REGISTRY_PATH"
    node -e '
const fs = require("fs");
const path = require("path");
const [projectRoot, feature, goalId, archiveDir, regFile] = process.argv.slice(1);
if (!fs.existsSync(archiveDir)) process.exit(0);
let stateFile = "";
let goalStatus = "stopped";
try {
  const reg = JSON.parse(fs.readFileSync(regFile, "utf8"));
  const g = (reg.goals || []).find((item) => item && (item.id === goalId || item.goal_id === goalId || item.id === feature + "-feature"));
  if (g) {
    if (g.state_file) stateFile = g.state_file;
    if (g.status) goalStatus = String(g.status);
  }
} catch (_) {}
const candidates = [
  stateFile ? (path.isAbsolute(stateFile) ? stateFile : path.join(projectRoot, stateFile)) : "",
  path.join(projectRoot, ".loopx", "goals", goalId, "ACTIVE_GOAL_STATE.md"),
  path.join(archiveDir, "ACTIVE_STATE.md")
].filter(Boolean);
let sourcePath = "";
let raw = "";
for (const p of candidates) {
  if (fs.existsSync(p)) {
    sourcePath = p;
    raw = fs.readFileSync(p, "utf8");
    break;
  }
}
for (const stray of ["ACTIVE_STATE.md", "ACTIVE_STATE.md.lock"]) {
  const p = path.join(archiveDir, stray);
  if (fs.existsSync(p)) fs.rmSync(p, { force: true });
}
const snapPath = path.join(archiveDir, "ACTIVE_STATE.snapshot.md");
const excerpt = raw ? raw.trim().split("\n").slice(0, 40).join("\n") : "_No runtime state file found at archive time._";
const body = [
  "# Historical Goal State Snapshot: " + goalId,
  "",
  "- **historical_snapshot**: `true`",
  "- **authority**: `none (read-only archive snapshot; do not recover runtime authority from this file)`",
  "- **feature**: `" + feature + "`",
  "- **goal_id**: `" + goalId + "`",
  "- **goal_status**: `" + goalStatus + "`",
  "- **generated_at**: `" + new Date().toISOString() + "`",
  "- **runtime_source**: `" + (sourcePath ? path.relative(projectRoot, sourcePath) : "not_found") + "`",
  "",
  "## State Summary",
  "",
  excerpt,
  ""
].join("\n");
fs.writeFileSync(snapPath, body, "utf8");
' "$PROJECT_ROOT" "$feature" "$goal_id" "$archive_dir" "$reg_file"
}

cmd_archive() {
    local feature="${1:-}"
    if [[ -z "$feature" ]]; then
        echo -e "${RED}[-] 错误: 请指定特性名称，例如: loopx-flow archive hard-guard${NC}" >&2
        exit 1
    fi

    local source_dir="$PROJECT_ROOT/specs/features/$feature"
    local archive_dir="$PROJECT_ROOT/specs/archive/$feature"

    if [[ -d "$source_dir" ]]; then
        mkdir -p "$PROJECT_ROOT/specs/archive"
        mv "$source_dir" "$archive_dir"
        write_archive_state_snapshot "$feature" "${feature}-goal" "$archive_dir"
        echo -e "${GREEN}[✓] 特性 $feature 已成功归档至: specs/archive/$feature/${NC}"
    else
        echo -e "${YELLOW}未找到特性目录: $source_dir${NC}"
    fi
}

# Issue 修复管线的 Goal 是否已登记（项目 registry 或全局 registry 任一命中即可）。
issue_goal_registered() {
    local gid="$1"
    node -e '
const fs = require("fs");
const os = require("os");
const path = require("path");
const gid = process.argv[1];
// 与 doctor 同源：显式 registry、~/.loopx 全局 registry、CODEX_HOME 下的全局 registry 都要认。
const files = [process.argv[2], path.join(os.homedir(), ".loopx", "registry.global.json"),
  process.argv[3] ? path.join(process.argv[3], "loopx", "registry.global.json") : ""].filter(Boolean);
for (const file of files) {
  let data = {};
  try { data = JSON.parse(fs.readFileSync(file, "utf8")); } catch (e) { continue; }
  const hit = (data.goals || []).some((goal) => goal && (goal.id === gid || goal.goal_id === gid));
  if (hit) process.exit(0);
}
process.exit(1);
' "$gid" "$LOOPX_REGISTRY_PATH" "$(wf_codex_home)"
}

# 为 Issue 修复创建（或幂等复用）每 Issue Goal，并启用 change-quality 严格收据。
issue_ensure_goal() {
    local gid="$1" title="$2"
    if issue_goal_registered "$gid"; then
        echo -e "    ${YELLOW}[i] Goal ${gid} 已登记，跳过 bootstrap${NC}"
    else
        echo -e "${BLUE}==> 初始化每 Issue Goal: ${gid}${NC}"
        local state_file
        state_file=".loopx/goals/${gid}/ACTIVE_GOAL_STATE.md" # loopx-allow: repo-relative path passed to --project "$PROJECT_ROOT"
        if ! run_loopx bootstrap \
            --project "$PROJECT_ROOT" \
            --goal-id "$gid" \
            --display-name "Issue fix: ${title:-$gid}" \
            --state-file "$state_file"; then
            echo -e "${RED}[-] [FAIL-CLOSED] Goal bootstrap 失败: ${gid}${NC}" >&2
            return 1
        fi
    fi
    if ! run_loopx configure-goal \
        --goal-id "$gid" \
        --change-quality-enabled \
        --change-quality-strict-receipt \
        --execute >/dev/null; then
        echo -e "${RED}[-] [FAIL-CLOSED] configure-goal 失败: ${gid}（无法启用 change-quality 严格收据）${NC}" >&2
        return 1
    fi
    echo -e "    ${GREEN}[✓] Goal ${gid} 已启用 change-quality 严格收据${NC}"
}

# 从能力矩阵 JSON 读取单个能力的探测状态（PASS / WARN / BLOCK / UNKNOWN）。
capability_status_of() {
    local capability_id="$1" matrix_json="$2"
    node -e '
let raw = "";
process.stdin.on("data", (chunk) => { raw += chunk; }).on("end", () => {
  let payload = {};
  try { payload = JSON.parse(raw); } catch (e) { process.exit(0); }
  const entry = (payload.entries || []).find((item) => item && item.id === process.argv[1]);
  process.stdout.write(entry ? String(entry.status || "") : "");
});
' "$capability_id" <<< "$matrix_json"
}

cmd_issue() {
    local issue_id="${1:-}"
    shift || true

    if [[ "$issue_id" == "-h" || "$issue_id" == "--help" ]]; then
        usage
        exit 0
    fi
    if [[ -z "$issue_id" ]]; then
        echo -e "${RED}[-] 错误: 请指定 Issue 编号，例如: loopx-flow issue 123${NC}" >&2
        exit 1
    fi

    if ! command -v loopx >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] 未检测到 loopx CLI，无法执行 LoopX 原生缺陷可行性裁决。${NC}" >&2
        exit 1
    fi
    if ! command -v gh >/dev/null 2>&1; then
        echo -e "${RED}[-] 错误: 未安装 gh CLI，无法提取 Issue 真实元数据。${NC}" >&2
        exit 1
    fi

    # 能力前置门：issue-fix.feasibility（BLOCK）缺失或探测 UNKNOWN → 直接非 0，不降级为静默成功。
    require_loopx_capabilities issue || {
        echo -e "${RED}[-] [FAIL-CLOSED] LoopX 能力探针未通过（issue-fix.feasibility），issue 命令已阻断。${NC}" >&2
        exit 1
    }

    # 解析 Agent 观察量与 Issue 修复管线参数
    local repro="missing" scope="uncertain" goal_id="" project_root="$PROJECT_ROOT"
    local impact="" base_branch="main" issue_branch="" execute="false" init_goal="false"
    local repro_label="" validation_label="" comment_value="none" context_json=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --reproduction)
                [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --reproduction 需要取值${NC}" >&2; exit 1; }
                repro="$2"; shift 2 ;;
            --reproduction-label)
                [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --reproduction-label 需要取值${NC}" >&2; exit 1; }
                repro_label="$2"; shift 2 ;;
            --validation-label)
                [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --validation-label 需要取值${NC}" >&2; exit 1; }
                validation_label="$2"; shift 2 ;;
            --comment-value)
                [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --comment-value 需要取值${NC}" >&2; exit 1; }
                comment_value="$2"; shift 2 ;;
            --repository-context-json)
                [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --repository-context-json 需要文件路径或 '-'${NC}" >&2; exit 1; }
                context_json="$2"; shift 2 ;;
            --scope)
                [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --scope 需要取值${NC}" >&2; exit 1; }
                scope="$2"; shift 2 ;;
            --goal-id)
                [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --goal-id 需要取值${NC}" >&2; exit 1; }
                goal_id="$2"; shift 2 ;;
            --project)
                [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --project 需要取值${NC}" >&2; exit 1; }
                project_root="$2"; shift 2 ;;
            --impact)
                [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --impact 需要取值 R0|R1|R2${NC}" >&2; exit 1; }
                impact="$2"; shift 2 ;;
            --base-branch)
                [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --base-branch 需要取值${NC}" >&2; exit 1; }
                base_branch="$2"; shift 2 ;;
            --issue-branch)
                [[ -n "${2:-}" ]] || { echo -e "${RED}[-] 错误: --issue-branch 需要取值${NC}" >&2; exit 1; }
                issue_branch="$2"; shift 2 ;;
            --execute)
                execute="true"; shift ;;
            --init-goal)
                init_goal="true"; shift ;;
            -h|--help)
                usage; exit 0 ;;
            *)
                echo -e "${RED}[-] 错误: 未知参数 $1${NC}" >&2
                exit 1 ;;
        esac
    done

    if [[ -z "$issue_branch" ]]; then
        issue_branch="fix/issue-$issue_id"
    fi
    if [[ -n "$impact" && ! "$impact" =~ ^R[012]$ ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 非法影响分级 --impact ${impact}（只接受 R0|R1|R2）${NC}" >&2
        exit 1
    fi

    echo -e "${BLUE}==> 正在提取 GitHub Issue #$issue_id 真实元数据...${NC}"
    local issue_json repo_label
    issue_json="$(gh issue view "$issue_id" --json number,title,state,body,labels 2>/dev/null || echo '{}')"
    repo_label="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || echo '')"

    if [[ -z "$issue_json" || "$issue_json" == "{}" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 无法读取 Issue #$issue_id 元数据（gh issue view 失败）。${NC}" >&2
        exit 1
    fi

    local issue_title issue_impact_raw
    issue_title="$(node -e '
const fs = require("fs");
let d = {};
try { d = JSON.parse(fs.readFileSync(0, "utf8")); } catch (e) {}
process.stdout.write(String(d.title ?? ""));
' <<< "$issue_json")"
    # 影响分级：优先读机器标记 loopx-impact，其次读正文的 Impact: 行；缺省 R1，非法值非 0。
    issue_impact_raw="$(node -e 'const d = JSON.parse(require("fs").readFileSync(0, "utf8")); process.stdout.write(String(d.body || ""))' <<< "$issue_json" | issue_impact_from_body)"

    if [[ "$issue_impact_raw" == INVALID:* ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] Issue #$issue_id 的影响分级非法: ${issue_impact_raw#INVALID:}（只接受 R0|R1|R2）。${NC}" >&2
        exit 1
    fi
    if [[ -n "$impact" && -n "$issue_impact_raw" && "$impact" != "$issue_impact_raw" ]]; then
        echo -e "    ${YELLOW}[WARN] CLI --impact $impact 覆盖 Issue body 的 $issue_impact_raw${NC}"
    fi
    if [[ -z "$impact" ]]; then
        impact="${issue_impact_raw:-R1}"
    fi
    # ADR-0023：R0 是纯文档/隔离配置，0 Goal、不建分支；impact 在这里是约束而非建议。
    if [[ "$impact" == "R0" && ( "$init_goal" == "true" || "$execute" == "true" ) ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] impact:R0 不建 Goal、不建分支（ADR-0023）；请在 PR body 标记 loopx-impact 后直接走 Gate2。${NC}" >&2
        exit 1
    fi

    echo -e "    Issue 标题: ${BOLD}${issue_title:-<unknown>}${NC} | Repo: ${BOLD}${repo_label:-unknown}${NC}"
    # feasibility 的枚举与互斥约束来自 LoopX 2.3.0 --help：越界值在本地先 fail-closed，
    # 且 confirmed/planned 必须带 compact public-safe 的 reproduction-label。
    if [[ ! "$repro" =~ ^(confirmed|planned|missing|blocked)$ ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 非法 --reproduction ${repro}（只接受 confirmed|planned|missing|blocked）${NC}" >&2
        exit 1
    fi
    if [[ ! "$scope" =~ ^(bounded|uncertain|oversized)$ ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 非法 --scope ${scope}（只接受 bounded|uncertain|oversized）${NC}" >&2
        exit 1
    fi
    if [[ ! "$comment_value" =~ ^(none|clarification|diagnosis)$ ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 非法 --comment-value ${comment_value}（只接受 none|clarification|diagnosis）${NC}" >&2
        exit 1
    fi
    if [[ -n "$context_json" && "$context_json" != "-" && ! -f "$context_json" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] --repository-context-json 指向的文件不存在: ${context_json}${NC}" >&2
        exit 1
    fi
    if [[ -z "$repro_label" && ( "$repro" == "confirmed" || "$repro" == "planned" ) ]]; then
        repro_label="issue-${issue_id}-repro"
        echo -e "    ${YELLOW}[i] 未提供 --reproduction-label，使用公开安全的默认标签: ${repro_label}${NC}"
    fi
    # fix_pr 的第二个必要条件：LoopX 要求具名验证面（validation_label）。
    if [[ -z "$validation_label" ]]; then
        validation_label="npm-run-test"
        echo -e "    ${YELLOW}[i] 未提供 --validation-label，使用默认验证面标签: ${validation_label}${NC}"
    fi

    echo -e "    影响分级: ${BOLD}impact:$impact${NC} | 观察量: reproduction=$repro | scope=$scope"
    echo -e "${BLUE}==> 调用 LoopX issue-fix feasibility 执行因果路由裁决...${NC}"

    local -a feasibility_args=(issue-fix feasibility \
        --repo "$repo_label" \
        --issue-ref "$issue_id" \
        --reproduction-status "$repro" \
        --scope-class "$scope" \
        --format json)
    if [[ -n "$repro_label" ]]; then feasibility_args+=(--reproduction-label "$repro_label"); fi
    if [[ -n "$validation_label" ]]; then feasibility_args+=(--validation-label "$validation_label"); fi
    if [[ "$comment_value" != "none" ]]; then feasibility_args+=(--comment-value "$comment_value"); fi
    if [[ -n "$context_json" ]]; then feasibility_args+=(--repository-context-json "$context_json"); fi

    local feasibility_json
    if ! feasibility_json="$(run_loopx "${feasibility_args[@]}")"; then
        echo -e "${RED}[-] [FAIL-CLOSED] LoopX 缺陷可行性裁决失败: Issue #$issue_id 无法获取因果路由，操作已阻断。${NC}" >&2
        exit 1
    fi

    local route reason_codes
    # 路由事实在 decision.route（LoopX issue-fix schema），不在顶层 route（ADR-0012 决策 7）
    route="$(node -e '
const fs = require("fs");
let d = {};
try { d = JSON.parse(fs.readFileSync(0, "utf8")); } catch (e) {}
const decision = (d && typeof d.decision === "object" && d.decision) ? d.decision : {};
process.stdout.write(String(decision.route ?? ""));
' <<< "$feasibility_json")"
    # LoopX 2.3.0 feasibility schema 只提供 decision.reason_codes[]（没有 rationale）。
    reason_codes="$(node -e '
const fs = require("fs");
let d = {};
try { d = JSON.parse(fs.readFileSync(0, "utf8")); } catch (e) {}
const decision = (d && typeof d.decision === "object" && d.decision) ? d.decision : {};
const codes = Array.isArray(decision.reason_codes) ? decision.reason_codes : [];
process.stdout.write(codes.map((code) => String(code)).join(", "));
' <<< "$feasibility_json")"

    if [[ -z "$route" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] LoopX issue-fix feasibility 未输出 decision.route (fix_pr|comment_only|triage_only)，操作已阻断。${NC}" >&2
        exit 1
    fi

    echo -e "    ${GREEN}[✓] LoopX 因果路由裁决: ${BOLD}$route${NC}${GREEN}${reason_codes:+ ($reason_codes)}${NC}"
    case "$route" in
        fix_pr)
            if [[ "$init_goal" == "true" ]]; then
                [[ -n "$goal_id" ]] || goal_id="issue-$issue_id-goal"
                issue_ensure_goal "$goal_id" "$issue_title" || exit 1
            fi
            if [[ "$execute" == "true" && -z "$goal_id" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] --execute 需要 --goal-id <gid> 或 --init-goal：Issue 修复必须绑定每 Issue Goal。${NC}" >&2
                echo -e "    💡 修复: loopx-flow issue $issue_id --init-goal  或  loopx-flow issue $issue_id --goal-id issue-$issue_id-goal --execute" >&2
                exit 1
            fi

            local matrix_json wp_status crb_status
            matrix_json="$(probe_loopx_capabilities --scope issue --format json 2>/dev/null || true)"
            wp_status="$(capability_status_of issue-fix.workflow-plan "$matrix_json")"
            crb_status="$(capability_status_of issue-fix.caller-repo-branch "$matrix_json")"

            if [[ "$execute" == "true" && "$crb_status" != "PASS" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] --execute 需要 LoopX issue-fix caller-repo-branch 能力（当前: ${crb_status:-UNKNOWN}）。${NC}" >&2
                exit 1
            fi

            if [[ "$wp_status" == "PASS" || "$execute" == "true" ]]; then
                local -a plan_args=(issue-fix workflow-plan \
                    --repo "$repo_label" \
                    --issue-ref "$issue_id" \
                    --repo-path "$PROJECT_ROOT" \
                    --base-branch "$base_branch" \
                    --issue-branch "$issue_branch" \
                    --format json)
                if [[ -n "$goal_id" ]]; then
                    plan_args+=(--goal-id "$goal_id" --project "$project_root")
                fi
                if [[ -n "$validation_label" ]]; then
                    plan_args+=(--validation-label "$validation_label")
                fi
                if [[ -n "$context_json" ]]; then
                    plan_args+=(--repository-context-json "$context_json")
                fi
                if [[ "$execute" != "true" ]]; then
                    plan_args+=(--no-write-domain-state)
                fi
                local plan_json
                if ! plan_json="$(run_loopx "${plan_args[@]}")"; then
                    echo -e "${RED}[-] [FAIL-CLOSED] LoopX issue-fix workflow-plan 失败，操作已阻断。${NC}" >&2
                    exit 1
                fi
                echo -e "    ${GREEN}[✓] workflow-plan 已生成（Todo 预览仅供规划，不自动写入）${NC}"
                node -e '
let raw = "";
process.stdin.on("data", (chunk) => { raw += chunk; }).on("end", () => {
  let payload = {};
  try { payload = JSON.parse(raw); } catch (e) { console.log("    [WARN] workflow-plan 输出不是 JSON"); return; }
  const keys = ["branch_plan", "validation_plan", "next_safe_action", "ordered_loopx_todo_writeback_preview"];
  for (const key of keys) {
    if (payload[key] !== undefined && payload[key] !== null) {
      console.log(`    ${key}: ${JSON.stringify(payload[key])}`);
    }
  }
});
' <<< "$plan_json"
            else
                echo -e "    ${YELLOW}[WARN] 当前 loopx 缺少 issue-fix workflow-plan（${wp_status:-UNKNOWN}）；dry-run 跳过计划生成。${NC}"
            fi

            if [[ "$execute" == "true" ]]; then
                if [[ -z "$repo_label" ]]; then
                    echo -e "${RED}[-] [FAIL-CLOSED] --execute 需要可解析的 GitHub 仓库标识（gh repo view 失败）。${NC}" >&2
                    exit 1
                fi
                local dirty
                dirty="$(git -C "$PROJECT_ROOT" status --porcelain 2>/dev/null || true)"
                if [[ -n "$dirty" ]]; then
                    echo -e "${RED}[-] [FAIL-CLOSED] --execute 要求工作区干净：请先提交或暂存改动。${NC}" >&2
                    printf '%s\n' "$dirty" >&2
                    exit 1
                fi
                local branch_json
                if ! branch_json="$(run_loopx issue-fix caller-repo-branch \
                    --repo-path "$PROJECT_ROOT" \
                    --repo "$repo_label" \
                    --issue-ref "$issue_id" \
                    --base-branch "$base_branch" \
                    --issue-branch "$issue_branch" \
                    --validation-command "npm run test" \
                    --execute \
                    --format json)"; then
                    echo -e "${RED}[-] [FAIL-CLOSED] LoopX issue-fix caller-repo-branch 失败，未创建修复分支。${NC}" >&2
                    exit 1
                fi
                node -e '
let raw = "";
process.stdin.on("data", (chunk) => { raw += chunk; }).on("end", () => {
  let payload = {};
  try { payload = JSON.parse(raw); } catch (e) { return; }
  const action = payload.branch_action || payload.action || "unknown";
  const branch = payload.issue_branch || payload.branch || "";
  console.log(`    branch_action: ${action}${branch ? ` | issue_branch: ${branch}` : ""}`);
});
' <<< "$branch_json"
                echo -e "    ${GREEN}[✓] 修复分支已就绪: ${BOLD}$issue_branch${NC}"
            fi

            echo -e "  - 裁决为 ${BOLD}Issue 修复管线${NC}: 复现测试先 FAIL (tests/unit/issues/issue-$issue_id.test.js) → 修复 → 四门禁 → check → PR → Gate2。Impact=${BOLD}$impact${NC}"
            if [[ -n "$goal_id" ]]; then
                echo -e "${BLUE}下一步:${NC}"
                echo -e "  1. loopx-flow check --goal-id $goal_id"
                echo -e "  2. loopx-flow pr create --issue $issue_id --goal-id $goal_id --impact $impact"
                echo -e "  3. loopx-flow review <pr_id>"
                echo -e "  4. loopx-flow release-approve <pr_id> --prepare"
                echo -e "  5. loopx-flow merge <pr_id> --goal-id $goal_id"
            else
                echo -e "  首次接入: loopx-flow issue $issue_id --init-goal（创建 issue-$issue_id-goal）"
                echo -e "  或指定既有 Goal: loopx-flow issue $issue_id --goal-id <gid>"
            fi
            ;;
        comment_only)
            echo -e "  - 裁决为 ${BOLD}仅评论响应${NC}: 在 GitHub Issue #$issue_id 补充澄清/诊断评论，不启动代码修复。"
            ;;
        triage_only)
            echo -e "  - 裁决为 ${BOLD}仅分诊处理${NC}: 记录分诊结论并更新 Issue 标签，等待更多信息后再评估。"
            ;;
        *)
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 输出未知路由: ${route}，请人工核查。${NC}" >&2
            exit 1
            ;;
    esac
}

cmd_integrate() {
    local mode="sync"
    local execute=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --execute)
                execute=true; shift ;;
            --status)
                mode="status"; shift ;;
            *)
                shift ;;
        esac
    done

    if ! command -v loopx >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] 未检测到 loopx CLI，无法执行 LoopX 原生集成分支预演。${NC}" >&2
        exit 1
    fi

    # 能力前置门：integration-branch（BLOCK）缺失或探测 UNKNOWN → 直接非 0。
    require_loopx_capabilities integrate || {
        echo -e "${RED}[-] [FAIL-CLOSED] LoopX 能力探针未通过（integration-branch），integrate 命令已阻断。${NC}" >&2
        exit 1
    }

    if [[ "$mode" == "status" ]]; then
        echo -e "${BLUE}==> 正在查询 LoopX 集成分支状态 (base/source/integration heads)...${NC}"
        if ! run_loopx integration-branch status --repo-path "$PROJECT_ROOT"; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 集成分支状态查询失败，请核查 integration-branch configure。${NC}" >&2
            exit 1
        fi
        return 0
    fi

    if [[ "$execute" == "true" ]]; then
        echo -e "${BLUE}==> 正在执行 LoopX 本地集成合入 (temporary worktree, --execute)...${NC}"
        if ! run_loopx integration-branch sync --repo-path "$PROJECT_ROOT" --execute; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 本地集成合入失败: 源头未按序合入，操作已阻断。${NC}" >&2
            exit 1
        fi
        echo -e "${GREEN}[✓] 本地预集成已落盘完成。${NC}"
    else
        echo -e "${BLUE}==> 正在预演 LoopX 本地集成 (preview, 不落盘)...${NC}"
        if ! run_loopx integration-branch sync --repo-path "$PROJECT_ROOT"; then
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 本地集成预演失败，操作已阻断。${NC}" >&2
            exit 1
        fi
        echo -e "${YELLOW}[i] 预演模式未落盘；确认无误后执行: loopx-flow integrate --execute${NC}"
    fi
}

cmd_status() {
    if command -v loopx >/dev/null 2>&1; then
        run_loopx status || true
    else
        echo -e "${YELLOW}[!] 未安装 loopx CLI。正在显示本地 specs/features/ 状态:${NC}"
        ls -la "$PROJECT_ROOT/specs/features" || true
    fi
}

# 打印可直接执行的 register-agent 修复命令。预览不够，必须带 --execute。
# 占位符 <registered-agent-id> 必须原样出现；%q 会把它写成 \<registered-agent-id\>。
print_register_agent_repair() {
    local goal_id="$1"
    local agent_id="$2"
    local goal_q agent_q
    printf -v goal_q '%q' "$goal_id"
    if [[ "$agent_id" == "<registered-agent-id>" ]]; then
        agent_q="$agent_id"
    else
        printf -v agent_q '%q' "$agent_id"
    fi
    echo -e "${YELLOW}    修复: loopx ${REGISTRY_FLAG} --format json register-agent --goal-id ${goal_q} --agent-id ${agent_q} --execute${NC}" >&2
}

# 读完 agent-directory 的全部分页后再判定 owner。首页最多 24 行，诊断行会占满首页。
# 成功时向 stdout 打印已注册 agent id。失败时打印修复指令并返回 1，不申领租约。
resolve_claim_owner() {
    local goal_id="$1"
    local page_dir cursor="" page_index=0 meta next_cursor
    wf_run_dir todo-claim
    page_dir="$WF_RUN_DIR/agents"
    mkdir -p "$page_dir"

    while true; do
        page_index=$((page_index + 1))
        if (( page_index > 128 )); then
            echo -e "${RED}[-] [FAIL-CLOSED] Goal ${goal_id} 的 agent-directory 分页超过 128 页，已阻断租约申领。${NC}" >&2
            rm -rf "$page_dir"
            return 1
        fi
        local page_file="$page_dir/$(printf 'page-%03d.json' "$page_index")"
        local page_err="$page_dir/$(printf 'page-%03d.err' "$page_index")"
        if [[ -z "$cursor" ]]; then
            read_loopx_json agent-directory --format json agent-directory --goal-id "$goal_id" >"$page_file" 2>"$page_err" || true
        else
            read_loopx_json agent-directory --format json agent-directory --goal-id "$goal_id" --cursor "$cursor" >"$page_file" 2>"$page_err" || true
        fi
        meta="$(node - "$page_file" <<'NODE'
const fs = require("fs");
let raw = "";
try { raw = fs.readFileSync(process.argv[2], "utf8"); }
catch (_) { process.stdout.write("BAD"); process.exit(0); }
function firstJson(text) {
  const start = text.indexOf("{");
  if (start < 0) return null;
  let depth = 0, inStr = false, esc = false;
  for (let i = start; i < text.length; i++) {
    const c = text[i];
    if (inStr) {
      if (esc) esc = false;
      else if (c === "\\") esc = true;
      else if (c === "\"") inStr = false;
      continue;
    }
    if (c === "\"") { inStr = true; continue; }
    if (c === "{") depth++;
    else if (c === "}") {
      depth--;
      if (depth === 0) return text.slice(start, i + 1);
    }
  }
  return null;
}
let payload;
try { payload = JSON.parse(firstJson(raw) || ""); }
catch (_) { process.stdout.write("BAD"); process.exit(0); }
if (!payload || typeof payload !== "object" || Array.isArray(payload)) {
  process.stdout.write("BAD");
  process.exit(0);
}
if (payload.ok === false && payload.error_code === "goal_not_registered") {
  process.stdout.write("GOAL_MISSING");
  process.exit(0);
}
if (payload.ok !== true) { process.stdout.write("BAD"); process.exit(0); }
const next = payload.next_cursor;
if (next == null || next === "") { process.stdout.write("END"); process.exit(0); }
if (typeof next !== "string" || /[\s\u0000]/.test(next)) {
  process.stdout.write("BAD");
  process.exit(0);
}
process.stdout.write("NEXT " + next);
NODE
)"
        case "$meta" in
            END|GOAL_MISSING)
                break
                ;;
            BAD|"")
                echo -e "${RED}[-] [FAIL-CLOSED] 无法读取 Goal ${goal_id} 的已注册 Agent 身份，已阻断租约申领。${NC}" >&2
                # schema_version 漂移时 read_loopx_json 的升级诊断卡落在 page_err：原样透出，
                # 否则操作者无法区分「Goal 未注册」与「LoopX 契约漂移」。
                if [[ -s "$page_err" ]]; then
                    sed $'s/\033\\[[0-9;]*m//g' "$page_err" >&2 || true
                fi
                local goal_q
                printf -v goal_q '%q' "$goal_id"
                echo -e "${YELLOW}    修复: loopx ${REGISTRY_FLAG} --format json agent-directory --goal-id ${goal_q}${NC}" >&2
                rm -rf "$page_dir"
                return 1
                ;;
            NEXT\ *)
                next_cursor="${meta#NEXT }"
                if [[ -n "$next_cursor" && -f "$page_dir/seen" ]] && grep -Fxq -e "$next_cursor" "$page_dir/seen"; then
                    echo -e "${RED}[-] [FAIL-CLOSED] Goal ${goal_id} 的 agent-directory 游标重复，已停止翻页并阻断租约申领。${NC}" >&2
                    rm -rf "$page_dir"
                    return 1
                fi
                if [[ -z "$next_cursor" || "$next_cursor" == "$cursor" ]]; then
                    echo -e "${RED}[-] [FAIL-CLOSED] Goal ${goal_id} 的 agent-directory 游标没有前进，已阻断租约申领。${NC}" >&2
                    rm -rf "$page_dir"
                    return 1
                fi
                printf '%s\n' "$next_cursor" >> "$page_dir/seen"
                cursor="$next_cursor"
                ;;
            *)
                echo -e "${RED}[-] [FAIL-CLOSED] 无法读取 Goal ${goal_id} 的已注册 Agent 身份，已阻断租约申领。${NC}" >&2
                rm -rf "$page_dir"
                return 1
                ;;
        esac
    done

    node - "$page_dir" <<'NODE'
const fs = require("fs");
const path = require("path");
const dir = process.argv[2];
const envRaw = String(process.env.LOOPX_AGENT_ID || "").trim();
const fold = (value) => String(value || "").trim().toLowerCase().replace(/ /g, "-");
function firstJson(text) {
  const start = text.indexOf("{");
  if (start < 0) return null;
  let depth = 0, inStr = false, esc = false;
  for (let i = start; i < text.length; i++) {
    const c = text[i];
    if (inStr) {
      if (esc) esc = false;
      else if (c === "\\") esc = true;
      else if (c === "\"") inStr = false;
      continue;
    }
    if (c === "\"") { inStr = true; continue; }
    if (c === "{") depth++;
    else if (c === "}") {
      depth--;
      if (depth === 0) return text.slice(start, i + 1);
    }
  }
  return null;
}
function write(verdict, extra) {
  const fields = extra || {};
  fs.writeFileSync(path.join(dir, "verdict"), verdict);
  fs.writeFileSync(path.join(dir, "owner"), fields.owner || "");
  fs.writeFileSync(path.join(dir, "env_id"), fields.env || "");
  fs.writeFileSync(path.join(dir, "registered"), (fields.registered || []).join("\n"));
}
const files = fs.readdirSync(dir).filter((name) => /^page-\d+\.json$/.test(name)).sort();
let goalMissing = false;
let declared = null;
const registered = [];
for (const name of files) {
  const raw = fs.readFileSync(path.join(dir, name), "utf8");
  let payload;
  try { payload = JSON.parse(firstJson(raw) || ""); }
  catch (_) { write("LOOKUP_FAILED"); process.exit(0); }
  if (!payload || typeof payload !== "object" || Array.isArray(payload)) {
    write("LOOKUP_FAILED");
    process.exit(0);
  }
  if (payload.ok === false && payload.error_code === "goal_not_registered") {
    goalMissing = true;
    continue;
  }
  if (payload.ok !== true) { write("LOOKUP_FAILED"); process.exit(0); }
  const count = Number(payload.registered_agent_count);
  if (Number.isFinite(count)) declared = declared == null ? count : Math.max(declared, count);
  for (const row of Array.isArray(payload.rows) ? payload.rows : []) {
    if (!row || row.registered !== true || typeof row.agent_id !== "string" || !row.agent_id) continue;
    if (!registered.includes(row.agent_id)) registered.push(row.agent_id);
  }
}
if (goalMissing) { write("GOAL_MISSING"); process.exit(0); }
if (declared != null && declared > registered.length) { write("LOOKUP_FAILED"); process.exit(0); }
if (envRaw) {
  const match = registered.find((id) => id === envRaw || fold(id) === fold(envRaw));
  if (match) write("OK", { owner: match });
  else write("UNREGISTERED", { env: envRaw, registered });
  process.exit(0);
}
if (registered.length === 1) write("OK", { owner: registered[0] });
else if (registered.length === 0) write("MISSING");
else write("AMBIGUOUS", { registered });
NODE

    local verdict="" owner_id="" env_id="" known=""
    verdict="$(cat "$page_dir/verdict" 2>/dev/null || true)"
    owner_id="$(cat "$page_dir/owner" 2>/dev/null || true)"
    env_id="$(cat "$page_dir/env_id" 2>/dev/null || true)"
    if [[ -s "$page_dir/registered" ]]; then
        known="$(tr '\n' ' ' < "$page_dir/registered" | sed 's/[[:space:]]*$//')"
    fi
    rm -rf "$page_dir"

    case "$verdict" in
        OK)
            if [[ -z "$owner_id" ]]; then
                echo -e "${RED}[-] [FAIL-CLOSED] 无法解析 Goal ${goal_id} 的 Agent 身份，已阻断租约申领。${NC}" >&2
                return 1
            fi
            printf '%s\n' "$owner_id"
            return 0
            ;;
        MISSING)
            echo -e "${RED}[-] [FAIL-CLOSED] Goal ${goal_id} 尚未注册 Agent 身份，已阻断租约申领。${NC}" >&2
            print_register_agent_repair "$goal_id" "<registered-agent-id>"
            return 1
            ;;
        GOAL_MISSING)
            echo -e "${RED}[-] [FAIL-CLOSED] Goal ${goal_id} 不在 LoopX registry 中，无法解析已注册 Agent，已阻断租约申领。${NC}" >&2
            print_register_agent_repair "$goal_id" "<registered-agent-id>"
            return 1
            ;;
        AMBIGUOUS)
            echo -e "${RED}[-] [FAIL-CLOSED] Goal ${goal_id} 有多个已注册 Agent，未设置唯一的 LOOPX_AGENT_ID，已阻断租约申领。${NC}" >&2
            if [[ -n "$known" ]]; then
                echo -e "${YELLOW}    已注册: ${known}${NC}" >&2
            fi
            echo -e "${YELLOW}    修复: LOOPX_AGENT_ID=<registered-agent-id> loopx-flow todo claim <todo_id> --goal-id ${goal_id}${NC}" >&2
            return 1
            ;;
        UNREGISTERED)
            echo -e "${RED}[-] [FAIL-CLOSED] 当前 Agent 身份 ${env_id} 尚未在 Goal ${goal_id} 注册，已阻断租约申领。${NC}" >&2
            if [[ -n "$known" ]]; then
                echo -e "${YELLOW}    该 Goal 已注册: ${known}${NC}" >&2
                echo -e "${YELLOW}    若应使用已有身份: LOOPX_AGENT_ID=<registered-agent-id> loopx-flow todo claim <todo_id> --goal-id ${goal_id}${NC}" >&2
            fi
            print_register_agent_repair "$goal_id" "$env_id"
            return 1
            ;;
        *)
            echo -e "${RED}[-] [FAIL-CLOSED] 无法读取 Goal ${goal_id} 的已注册 Agent 身份，已阻断租约申领。${NC}" >&2
            if [[ "$verdict" == "LOOKUP_FAILED" ]]; then
                echo -e "${YELLOW}    agent-directory 在翻页结束后仍少于 registered_agent_count，编排器不会把残页判成缺失或歧义。${NC}" >&2
            fi
            local goal_q
            printf -v goal_q '%q' "$goal_id"
            echo -e "${YELLOW}    修复: loopx ${REGISTRY_FLAG} --format json agent-directory --goal-id ${goal_q}${NC}" >&2
            return 1
            ;;
    esac
}

# 从显式参数或当前 feature 分支推导 LoopX Goal ID
resolve_goal_id() {
    local explicit_goal="${1:-}"
    if [[ -n "$explicit_goal" ]]; then
        echo "$explicit_goal"
        return 0
    fi
    local branch
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
    if [[ "$branch" =~ ^feature/(.+) ]]; then
        echo "${BASH_REMATCH[1]}-goal"
        return 0
    fi
    return 1
}

cmd_todo() {
    local subaction="${1:-list}"
    shift || true

    if ! command -v loopx >/dev/null 2>&1; then
        echo -e "${RED}[-] [FAIL-CLOSED] 未检测到 loopx CLI，无法调度 LoopX 原生控制面命令。${NC}" >&2
        exit 1
    fi

    case "$subaction" in
        list)
            run_loopx todo list "$@"
            ;;
        claim|done)
            cmd_todo_lease "$subaction" "$@"
            ;;
        *)
            run_loopx todo "$subaction" "$@"
            ;;
    esac
}

# 受管 Todo 认领/完成：只调用 LoopX 高层 `todo claim` / `todo complete`，
# 底层 task-lease acquire/release/renew 一律不碰（ADR-0015 delete-first）。
todo_claim_cache_path() {
    local goal_id="$1" todo_id="$2"
    if [[ -z "$goal_id" || -z "$todo_id" ]]; then
        return 1
    fi
    case "$goal_id" in
        .|..|*/*|*$'\n'*|*$'\r'*) return 1 ;;
    esac
    case "$todo_id" in
        .|..|*/*|*$'\n'*|*$'\r'*) return 1 ;;
    esac
    printf '%s/claims/%s--%s.json' "$LOOPX_TMP_DIR" "$goal_id" "$todo_id"
}

canonical_registry_path() {
    node -e '
const fs = require("fs");
const path = require("path");
const raw = process.argv[1];
const absolute = path.resolve(raw);
try { process.stdout.write(fs.realpathSync(absolute)); }
catch (_) { process.stdout.write(absolute); }
' "$LOOPX_REGISTRY_PATH"
}

write_todo_claim_cache() {
    local cache_path="$1" op="$2" goal_id="$3" todo_id="$4" owner="$5" registry_path="$6" mode="$7"
    mkdir -p "$(dirname "$cache_path")"
    CLAIM_CACHE_PATH="$cache_path" node - "$op" "$goal_id" "$todo_id" "$owner" "$registry_path" "$mode" <<'NODE'
const fs = require("fs");
const [op, goalId, todoId, agentId, registryPath, handoffMode] = process.argv.slice(2);
const target = process.env.CLAIM_CACHE_PATH;
const payload = {
  schema_version: "loopx_flow_claim_cache_v0",
  claim_operation_id: op,
  goal_id: goalId,
  todo_id: todoId,
  agent_id: agentId,
  registry_path: registryPath,
  handoff_mode: handoffMode,
  created_at: new Date().toISOString()
};
const tmp = `${target}.tmp.${process.pid}`;
try {
  fs.writeFileSync(tmp, `${JSON.stringify(payload, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(tmp, target);
} catch (error) {
  try { fs.unlinkSync(tmp); } catch (_) {}
  process.stderr.write(`无法写入 claim 凭证缓存: ${error.message}\n`);
  process.exit(1);
}
NODE
}

read_todo_claim_cache() {
    local cache_path="$1" goal_id="$2" todo_id="$3" owner="$4" registry_path="$5" expected_mode="$6"
    CLAIM_CACHE_PATH="$cache_path" CACHE_GOAL_ID="$goal_id" CACHE_TODO_ID="$todo_id" \
        CACHE_AGENT_ID="$owner" CACHE_REGISTRY_PATH="$registry_path" CACHE_HANDOFF_MODE="$expected_mode" \
        node <<'NODE'
const fs = require("fs");
const target = process.env.CLAIM_CACHE_PATH;
const expected = {
  goal_id: process.env.CACHE_GOAL_ID || "",
  todo_id: process.env.CACHE_TODO_ID || "",
  agent_id: process.env.CACHE_AGENT_ID || "",
  registry_path: process.env.CACHE_REGISTRY_PATH || "",
  handoff_mode: process.env.CACHE_HANDOFF_MODE || ""
};
if (!fs.existsSync(target)) {
  process.stdout.write("missing\t凭证缓存不存在\n");
  process.exit(0);
}
let payload;
try {
  payload = JSON.parse(fs.readFileSync(target, "utf8"));
} catch (error) {
  process.stdout.write(`invalid\t凭证缓存 JSON 损坏: ${error.message}\n`);
  process.exit(0);
}
if (!payload || typeof payload !== "object" || Array.isArray(payload)) {
  process.stdout.write("invalid\t凭证缓存不是 JSON 对象\n");
  process.exit(0);
}
if (payload.schema_version !== "loopx_flow_claim_cache_v0") {
  process.stdout.write("invalid\t凭证缓存 schema_version 不兼容\n");
  process.exit(0);
}
if (typeof payload.claim_operation_id !== "string" || !payload.claim_operation_id) {
  process.stdout.write("invalid\t凭证缓存缺少 claim_operation_id\n");
  process.exit(0);
}
for (const field of ["goal_id", "todo_id", "agent_id", "registry_path", "handoff_mode"]) {
  if (payload[field] !== expected[field]) {
    process.stdout.write(`invalid\t五元组字段 ${field} 不匹配: cache=${JSON.stringify(payload[field])} current=${JSON.stringify(expected[field])}\n`);
    process.exit(0);
  }
}
process.stdout.write(`ok\t${payload.claim_operation_id}\n`);
NODE
}

parse_todo_claim_result() {
    CLAIM_RAW="$1" node <<'NODE'
const raw = process.env.CLAIM_RAW || "";
function firstJson(text) {
  const start = text.indexOf("{");
  if (start < 0) return null;
  let depth = 0, inStr = false, esc = false;
  for (let i = start; i < text.length; i++) {
    const c = text[i];
    if (inStr) {
      if (esc) esc = false;
      else if (c === "\\") esc = true;
      else if (c === "\"") inStr = false;
      continue;
    }
    if (c === "\"") { inStr = true; continue; }
    if (c === "{") depth++;
    else if (c === "}") {
      depth--;
      if (depth === 0) return text.slice(start, i + 1);
    }
  }
  return null;
}
let payload;
try { payload = JSON.parse(firstJson(raw) || ""); }
catch (_) { process.stdout.write("bad\tclaim 返回不是可解析 JSON\n"); process.exit(0); }
if (!payload || typeof payload !== "object" || Array.isArray(payload)) {
  process.stdout.write("bad\tclaim 返回不是 JSON 对象\n"); process.exit(0);
}
if (payload.ok !== true) {
  process.stdout.write(`bad\tLoopX claim 拒绝: ${payload.error_code || "unknown"}\n`); process.exit(0);
}
if (payload.schema_version !== "loopx_coordination_todo_claim_result_v0") {
  process.stdout.write(`bad\tclaim schema_version 不在白名单: ${payload.schema_version || "missing"}\n`); process.exit(0);
}
if (typeof payload.claim_operation_id !== "string" || !payload.claim_operation_id) {
  process.stdout.write("bad\tclaim 返回缺少 claim_operation_id\n"); process.exit(0);
}
if (payload.handoff_mode !== "hard_lease" && payload.handoff_mode !== "soft_claim") {
  process.stdout.write(`bad\tclaim handoff_mode 未知: ${payload.handoff_mode || "missing"}\n`); process.exit(0);
}
process.stdout.write(`ok\t${payload.claim_operation_id}\t${payload.handoff_mode}\n`);
NODE
}

parse_todo_complete_result() {
    COMPLETE_RAW="$1" node <<'NODE'
const raw = process.env.COMPLETE_RAW || "";
function firstJson(text) {
  const start = text.indexOf("{");
  if (start < 0) return null;
  let depth = 0, inStr = false, esc = false;
  for (let i = start; i < text.length; i++) {
    const c = text[i];
    if (inStr) {
      if (esc) esc = false;
      else if (c === "\\") esc = true;
      else if (c === "\"") inStr = false;
      continue;
    }
    if (c === "\"") { inStr = true; continue; }
    if (c === "{") depth++;
    else if (c === "}") {
      depth--;
      if (depth === 0) return text.slice(start, i + 1);
    }
  }
  return null;
}
let payload;
try { payload = JSON.parse(firstJson(raw) || ""); }
catch (_) { process.stdout.write("bad\tcomplete 返回不是可解析 JSON\n"); process.exit(0); }
if (!payload || typeof payload !== "object" || Array.isArray(payload)) {
  process.stdout.write("bad\tcomplete 返回不是 JSON 对象\n"); process.exit(0);
}
if (payload.ok !== true) {
  process.stdout.write(`bad\tLoopX complete 拒绝: ${payload.error_code || payload.reason_code || "unknown"}\n`); process.exit(0);
}
if (payload.schema_version !== "loopx_coordination_todo_terminal_lifecycle_result_v0") {
  process.stdout.write(`bad\tcomplete schema_version 不在白名单: ${payload.schema_version || "missing"}\n`); process.exit(0);
}
if (payload.completed !== true || payload.status !== "done") {
  process.stdout.write(`bad\tcomplete 未确认原子完成: status=${payload.status || "missing"} completed=${payload.completed}\n`); process.exit(0);
}
process.stdout.write("ok\n");
NODE
}

parse_todo_observation() {
    INSPECT_RAW="$1" TODO_RAW="$2" node <<'NODE'
const inspectRaw = process.env.INSPECT_RAW || "";
const todoRaw = process.env.TODO_RAW || "";
function firstJson(text) {
  const start = text.indexOf("{");
  if (start < 0) return null;
  let depth = 0, inStr = false, esc = false;
  for (let i = start; i < text.length; i++) {
    const c = text[i];
    if (inStr) {
      if (esc) esc = false;
      else if (c === "\\") esc = true;
      else if (c === "\"") inStr = false;
      continue;
    }
    if (c === "\"") { inStr = true; continue; }
    if (c === "{") depth++;
    else if (c === "}") {
      depth--;
      if (depth === 0) return text.slice(start, i + 1);
    }
  }
  return null;
}
function parse(raw) {
  try { return JSON.parse(firstJson(raw) || ""); } catch (_) { return null; }
}
const inspect = parse(inspectRaw);
const todoPayload = parse(todoRaw);
if (!inspect || typeof inspect !== "object" || Array.isArray(inspect)) {
  process.stdout.write("bad\t无法解析 task-lease inspect\n"); process.exit(0);
}
if (inspect.ok !== true) {
  process.stdout.write(`bad\ttask-lease inspect 拒绝: ${inspect.error_code || "unknown"}\n`); process.exit(0);
}
if (!todoPayload || typeof todoPayload !== "object" || Array.isArray(todoPayload)) {
  process.stdout.write("bad\t无法解析 todo list\n"); process.exit(0);
}
if (todoPayload.ok !== true) {
  process.stdout.write(`bad\ttodo list 拒绝: ${todoPayload.error_code || "unknown"}\n`); process.exit(0);
}
const todo = todoPayload.todo && typeof todoPayload.todo === "object" ? todoPayload.todo : null;
if (!todo) {
  process.stdout.write("bad\ttodo list 未返回目标 Todo\n"); process.exit(0);
}
const lease = inspect.lease && typeof inspect.lease === "object" ? inspect.lease : null;
const mode = typeof inspect.handoff_mode === "string" ? inspect.handoff_mode : "";
const active = inspect.active === true ? "true" : "false";
const leaseStatus = lease && typeof lease.status === "string" ? lease.status : "";
const leaseOwner = lease && typeof lease.owner === "string" ? lease.owner : "";
const expiresAt = lease && typeof lease.expires_at === "string" ? lease.expires_at : "";
const todoStatus = typeof todo.status === "string" ? todo.status : "";
const todoClaimed = typeof todo.claimed_by === "string" ? todo.claimed_by : "";
const todoDone = todo.done === true ? "true" : "false";
process.stdout.write(["ok", mode, active, leaseStatus, leaseOwner, expiresAt, todoStatus, todoClaimed, todoDone].join("|") + "\n");
NODE
}

emit_todo_q1_failure() {
    local code="$1" action="$2" reason="$3" next_step="$4" inspect_raw="$5" todo_raw="$6" goal_id="$7" todo_id="$8" owner="$9"
    Q1_CODE="$code" Q1_ACTION="$action" Q1_REASON="$reason" Q1_NEXT="$next_step" \
        Q1_GOAL_ID="$goal_id" Q1_TODO_ID="$todo_id" Q1_OWNER="$owner" \
        INSPECT_RAW="$inspect_raw" TODO_RAW="$todo_raw" node <<'NODE'
const inspectRaw = process.env.INSPECT_RAW || "";
const todoRaw = process.env.TODO_RAW || "";
function firstJson(text) {
  const start = text.indexOf("{");
  if (start < 0) return null;
  let depth = 0, inStr = false, esc = false;
  for (let i = start; i < text.length; i++) {
    const c = text[i];
    if (inStr) {
      if (esc) esc = false;
      else if (c === "\\") esc = true;
      else if (c === "\"") inStr = false;
      continue;
    }
    if (c === "\"") { inStr = true; continue; }
    if (c === "{") depth++;
    else if (c === "}") {
      depth--;
      if (depth === 0) return text.slice(start, i + 1);
    }
  }
  return null;
}
function parse(raw) {
  try { return JSON.parse(firstJson(raw) || ""); } catch (_) { return null; }
}
const goalId = process.env.Q1_GOAL_ID || "";
const todoId = process.env.Q1_TODO_ID || "";
const owner = process.env.Q1_OWNER || "";
const action = process.env.Q1_ACTION || "claim_task";
const payload = {
  ok: false,
  schema_version: "loopx_flow_todo_q1_result_v0",
  error_code: process.env.Q1_CODE || "claim_receipt_unavailable",
  recovery: {
    action,
    execution_authority_granted: false,
    reason: process.env.Q1_REASON || "",
    next: process.env.Q1_NEXT || "",
    claim: {
      command: "loopx todo claim",
      cli_args: ["--goal-id", goalId, "--todo-id", todoId, "--agent-id", owner, "--claimed-by", owner]
    }
  },
  loopx_task_lease_inspect: parse(inspectRaw),
  loopx_todo: parse(todoRaw)
};
process.stdout.write(`${JSON.stringify(payload)}\n`);
NODE
}

cmd_todo_lease() {
    local mode="$1"
    shift

    # 能力前置门：todo.lease / todo.user_gate（BLOCK）缺失或探测 UNKNOWN → 直接非 0。
    require_loopx_capabilities todo || {
        echo -e "${RED}[-] [FAIL-CLOSED] LoopX 能力探针未通过（受管 todo 签名），todo $mode 已阻断。${NC}" >&2
        exit 1
    }

    local todo_id="" goal_id="" agent_id="" claim_operation_id="" evidence=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --goal-id)
                if [[ $# -lt 2 ]]; then
                    echo -e "${RED}[-] 错误: --goal-id 需要一个值。${NC}" >&2
                    exit 1
                fi
                goal_id="$2"; shift 2 ;;
            --owner|--agent-id)
                if [[ $# -lt 2 ]]; then
                    echo -e "${RED}[-] 错误: $1 需要一个值。${NC}" >&2
                    exit 1
                fi
                agent_id="$2"; shift 2 ;;
            --claim-operation-id)
                if [[ $# -lt 2 || -z "${2:-}" ]]; then
                    echo -e "${RED}[-] 错误: --claim-operation-id 需要一个非空值。${NC}" >&2
                    exit 1
                fi
                claim_operation_id="$2"; shift 2 ;;
            --evidence)
                if [[ $# -lt 2 ]]; then
                    echo -e "${RED}[-] 错误: --evidence 需要一个值。${NC}" >&2
                    exit 1
                fi
                evidence="$2"; shift 2 ;;
            --idempotency-key|--idempotency-key=*)
                echo -e "${RED}[-] [FAIL-CLOSED] --idempotency-key 已随 ADR-0015 退役；请使用受管 todo claim/complete。${NC}" >&2
                exit 1 ;;
            *)
                if [[ -z "$todo_id" ]]; then todo_id="$1"; fi; shift ;;
        esac
    done

    if [[ -z "$todo_id" ]]; then
        echo -e "${RED}[-] 错误: 请指定 Todo ID，例如: loopx-flow todo claim todo_ab12cd34ef56${NC}" >&2
        exit 1
    fi

    if [[ -z "$goal_id" ]]; then
        goal_id="$(resolve_goal_id)" || {
            echo -e "${RED}[-] [FAIL-CLOSED] 无法推导 Goal ID: 当前分支非 feature/* 且未显式传入 --goal-id。${NC}" >&2
            exit 1
        }
    fi

    if [[ "$mode" == "claim" ]]; then
        echo -e "${BLUE}==> [受管 Todo] 正在认领: $todo_id @ $goal_id ...${NC}"
        local owner="" claim_out="" claim_rc=0 claim_meta
        if [[ -n "$agent_id" ]]; then
            owner="$(LOOPX_AGENT_ID="$agent_id" resolve_claim_owner "$goal_id")" || exit 1
        else
            owner="$(resolve_claim_owner "$goal_id")" || exit 1
        fi
        # 统一 JSON wrapper：第 2 层 schema_version 白名单在这里唯一执行（未知版本输出升级差异诊断卡）。
        claim_out="$(read_loopx_json todo.claim --format json todo claim --goal-id "$goal_id" --todo-id "$todo_id" --agent-id "$owner" --claimed-by "$owner")" || claim_rc=$?
        if [[ "$claim_rc" -ne 0 ]]; then
            printf '%s\n' "$claim_out" >&2
            echo -e "${RED}[-] [FAIL-CLOSED] 受管 Todo 认领失败: LoopX 拒绝了 todo claim（或载荷 schema_version 不在白名单），操作已阻断。${NC}" >&2
            exit 1
        fi
        claim_meta="$(parse_todo_claim_result "$claim_out")"
        if [[ "$claim_meta" != ok$'\t'* ]]; then
            printf '%s\n' "$claim_out" >&2
            echo -e "${RED}[-] [FAIL-CLOSED] ${claim_meta#bad$'\t'}${NC}" >&2
            exit 1
        fi
        local claim_op claim_mode cache_path registry_path
        IFS=$'\t' read -r _ claim_op claim_mode <<< "$claim_meta"
        if ! cache_path="$(todo_claim_cache_path "$goal_id" "$todo_id")"; then
            echo -e "${RED}[-] [FAIL-CLOSED] Goal/Todo ID 含路径分隔符，拒绝写入 claim 凭证缓存。${NC}" >&2
            exit 1
        fi
        registry_path="$(canonical_registry_path)"
        if ! write_todo_claim_cache "$cache_path" "$claim_op" "$goal_id" "$todo_id" "$owner" "$registry_path" "$claim_mode"; then
            echo -e "${RED}[-] [FAIL-CLOSED] claim_operation_id 凭证缓存写入失败，拒绝放行。${NC}" >&2
            exit 1
        fi
        printf '%s\n' "$claim_out"
        echo -e "${GREEN}[✓] 受管 Todo 已认领 (CLAIMED): $todo_id (handoff_mode=$claim_mode)${NC}"
        return 0
    fi

    # mode == done
    if [[ -z "$agent_id" ]]; then
        agent_id="$(resolve_claim_owner "$goal_id")" || exit 1
    fi

    local registry_path="" cache_path="" cache_meta="" cache_status="" cache_op="" cache_reason=""
    registry_path="$(canonical_registry_path)"
    if ! cache_path="$(todo_claim_cache_path "$goal_id" "$todo_id")"; then
        echo -e "${RED}[-] [FAIL-CLOSED] Goal/Todo ID 含路径分隔符，无法定位 claim 凭证缓存。${NC}" >&2
        exit 1
    fi

    local inspect_out="" inspect_rc=0 todo_out="" todo_rc=0 observation=""
    inspect_out="$(read_loopx_json task-lease.inspect --format json task-lease inspect --goal-id "$goal_id" --todo-id "$todo_id" 2>&1)" || inspect_rc=$?
    if [[ "$inspect_rc" -ne 0 ]]; then
        printf '%s\n' "$inspect_out" >&2
        echo -e "${RED}[-] [FAIL-CLOSED] 无法读取 Todo ${todo_id} 的租约状态，拒绝变更 Todo 状态。${NC}" >&2
        exit 1
    fi
    todo_out="$(read_loopx_json todo.list --format json todo list --goal-id "$goal_id" --todo-id "$todo_id" 2>&1)" || todo_rc=$?
    if [[ "$todo_rc" -ne 0 ]]; then
        printf '%s\n' "$todo_out" >&2
        echo -e "${RED}[-] [FAIL-CLOSED] 无法读取 Todo ${todo_id} 的当前状态，拒绝变更。${NC}" >&2
        exit 1
    fi
    observation="$(parse_todo_observation "$inspect_out" "$todo_out")"
    if [[ "$observation" != "ok|"* ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] ${observation#bad$'\t'}${NC}" >&2
        exit 1
    fi
    local current_mode inspect_active lease_status lease_owner lease_expires todo_status todo_claimed todo_done
    IFS="|" read -r _ current_mode inspect_active lease_status lease_owner lease_expires todo_status todo_claimed todo_done <<< "$observation"

    local claim_op="" claim_source=""
    if [[ -n "$claim_operation_id" ]]; then
        claim_op="$claim_operation_id"
        claim_source="explicit"
    else
        cache_meta="$(read_todo_claim_cache "$cache_path" "$goal_id" "$todo_id" "$agent_id" "$registry_path" "$current_mode")"
        cache_status="${cache_meta%%$'\t'*}"
        if [[ "$cache_status" == "ok" ]]; then
            claim_op="${cache_meta#ok$'\t'}"
            claim_source="cache"
        else
            cache_reason="${cache_meta#*$'\t'}"
        fi
    fi

    if [[ -z "$claim_op" ]]; then
        local same_owner="false" q1_code="claim_receipt_unavailable" q1_action="claim_task"
        local q1_reason="无法确认有效且同 Owner 的 claim receipt；不得静默重新 claim。" q1_next=""
        local expired="0"
        if [[ -n "$lease_expires" ]]; then
            expired="$(EXPIRES_AT="$lease_expires" node -e 'const t = Date.parse(process.env.EXPIRES_AT || ""); process.stdout.write(Number.isFinite(t) && t <= Date.now() ? "1" : "0");')"
        fi
        if [[ "$current_mode" == "soft_claim" ]]; then
            if [[ "$todo_status" == "deferred" ]]; then
                q1_code="todo_not_open"
                q1_action="reopen_todo"
                q1_reason="Todo 处于 deferred 挂起态；LoopX 拒绝直接认领或完成。"
                q1_next="先由 Owner 执行: loopx todo update --status open --clear-resume-when --goal-id ${goal_id} --todo-id ${todo_id}，再显式重跑: loopx-flow todo claim ${todo_id} --goal-id ${goal_id}"
            elif [[ "$todo_status" == "open" && "$todo_claimed" == "$agent_id" ]]; then
                same_owner="true"
            elif [[ -n "$todo_claimed" && "$todo_claimed" != "$agent_id" ]]; then
                q1_code="owner_conflicts_with_claim"
                q1_action="reconcile_lease_owner"
                q1_reason="Todo 当前由 ${todo_claimed} 持有，与本次操作身份 ${agent_id} 不一致。"
                q1_next="核对所有权后显式重跑: loopx-flow todo claim $todo_id --goal-id $goal_id"
            else
                q1_reason="Todo 当前未处于 ${agent_id} 的活跃认领态 (status=${todo_status:-unknown}, claimed_by=${todo_claimed:-none})。"
                q1_next="核对现状后显式重跑: loopx-flow todo claim $todo_id --goal-id $goal_id"
            fi
        elif [[ "$current_mode" == "hard_lease" ]]; then
            if [[ "$lease_status" == "released" ]]; then
                q1_code="lease_released"
                q1_reason="Todo 租约已释放 (released)；不得静默重新 claim。"
                q1_next="核对现状后显式重跑: loopx-flow todo claim $todo_id --goal-id $goal_id"
            elif [[ "$expired" == "1" ]]; then
                q1_code="lease_expired"
                q1_reason="Todo 租约已过期 (lease_state=expired)；不得静默重新 claim。"
                q1_next="核对现状后显式重跑: loopx-flow todo claim $todo_id --goal-id $goal_id"
            elif [[ -n "$lease_owner" && "$lease_owner" != "$agent_id" ]]; then
                q1_code="owner_conflicts_with_claim"
                q1_action="reconcile_lease_owner"
                q1_reason="Todo 租约由 ${lease_owner} 持有，与本次操作身份 ${agent_id} 不一致。"
                q1_next="先核对并 reconcile 所有权，再显式重跑: loopx-flow todo claim $todo_id --goal-id $goal_id"
            elif [[ "$inspect_active" == "true" && "$lease_status" == "active" && "$lease_owner" == "$agent_id" ]]; then
                same_owner="true"
            elif [[ "$todo_status" == "deferred" ]]; then
                q1_code="todo_not_open"
                q1_action="reopen_todo"
                q1_reason="Todo 处于 deferred 挂起态；LoopX 拒绝直接认领或完成。"
                q1_next="先由 Owner 执行: loopx todo update --status open --clear-resume-when --goal-id ${goal_id} --todo-id ${todo_id}，再显式重跑: loopx-flow todo claim ${todo_id} --goal-id ${goal_id}"
            else
                q1_reason="无法确认有效且同 Owner 的活动租约 (active=${inspect_active}, lease_status=${lease_status:-none}, owner=${lease_owner:-none})。"
                q1_next="核对现状后显式重跑: loopx-flow todo claim $todo_id --goal-id $goal_id"
            fi
        else
            q1_reason="当前 handoff_mode 不是 hard_lease/soft_claim (${current_mode:-unknown})，无法复用 claim receipt。"
            q1_next="核对 Goal handoff_mode 后显式重跑: loopx-flow todo claim $todo_id --goal-id $goal_id"
        fi

        if [[ "$same_owner" != "true" ]]; then
            echo -e "${YELLOW}[i] ${cache_reason:-凭证缓存不可用}；已按 Q1 分流 B 停机，不静默重新 claim。${NC}" >&2
            emit_todo_q1_failure "$q1_code" "$q1_action" "$q1_reason" "$q1_next" "$inspect_out" "$todo_out" "$goal_id" "$todo_id" "$agent_id"
            echo -e "${RED}[-] [FAIL-CLOSED] ${q1_reason}${NC}" >&2
            echo -e "${YELLOW}    LoopX recovery: action=${q1_action}${NC}" >&2
            echo -e "${YELLOW}    恢复指引: ${q1_next}${NC}" >&2
            exit 1
        fi

        echo -e "${YELLOW}[i] ${cache_reason:-凭证缓存不可用}；租约有效且同 Owner，按 Q1 分流 A 自动补领 receipt。${NC}" >&2
        local reclaim_out="" reclaim_rc=0 reclaim_meta reclaim_op reclaim_mode
        reclaim_out="$(read_loopx_json todo.claim --format json todo claim --goal-id "$goal_id" --todo-id "$todo_id" --agent-id "$agent_id" --claimed-by "$agent_id")" || reclaim_rc=$?
        if [[ "$reclaim_rc" -ne 0 ]]; then
            printf '%s\n' "$reclaim_out" >&2
            echo -e "${RED}[-] [FAIL-CLOSED] Q1 分流 A 自动补领失败: LoopX 拒绝了 todo claim（或载荷 schema_version 不在白名单）。${NC}" >&2
            exit 1
        fi
        reclaim_meta="$(parse_todo_claim_result "$reclaim_out")"
        if [[ "$reclaim_meta" != ok$'\t'* ]]; then
            printf '%s\n' "$reclaim_out" >&2
            echo -e "${RED}[-] [FAIL-CLOSED] ${reclaim_meta#bad$'\t'}${NC}" >&2
            exit 1
        fi
        IFS=$'\t' read -r _ reclaim_op reclaim_mode <<< "$reclaim_meta"
        if ! write_todo_claim_cache "$cache_path" "$reclaim_op" "$goal_id" "$todo_id" "$agent_id" "$registry_path" "$reclaim_mode"; then
            echo -e "${RED}[-] [FAIL-CLOSED] 自动补领后的凭证缓存写入失败，拒绝放行。${NC}" >&2
            exit 1
        fi
        claim_op="$reclaim_op"
        claim_source="reclaimed"
    fi

    echo -e "${BLUE}==> [受管 Todo] 正在完成: $todo_id @ $goal_id (owner=$agent_id, claim=$claim_source)...${NC}"
    local complete_out="" complete_rc=0 complete_meta
    local -a complete_args=(--format json todo complete --goal-id "$goal_id" --todo-id "$todo_id" --agent-id "$agent_id" --claim-operation-id "$claim_op")
    [[ -n "$evidence" ]] && complete_args+=(--evidence "$evidence")
    complete_out="$(read_loopx_json todo.complete "${complete_args[@]}")" || complete_rc=$?
    if [[ "$complete_rc" -ne 0 ]]; then
        printf '%s\n' "$complete_out" >&2
        echo -e "${RED}[-] [FAIL-CLOSED] Todo 完成回写失败: ${todo_id}；LoopX 拒绝语义为唯一权威，未自动重新 claim。${NC}" >&2
        exit 1
    fi
    complete_meta="$(parse_todo_complete_result "$complete_out")"
    if [[ "$complete_meta" != "ok" ]]; then
        printf '%s\n' "$complete_out" >&2
        echo -e "${RED}[-] [FAIL-CLOSED] ${complete_meta#bad$'\t'}${NC}" >&2
        exit 1
    fi
    rm -f -- "$cache_path" 2>/dev/null || true
    printf '%s\n' "$complete_out"
    echo -e "${GREEN}[✓] Todo 已完成且受管租约已原子释放 (DONE): $todo_id${NC}"
}

# 命令路由
ACTION="${1:-help}"
shift || true

# 本地可判定非法输入先于外部能力探针（review #73 P0）：
# 命令位置参数缺失、review 的 --model/--reasoning-effort/--agent-bin 空值与控制字符、
# 非法 reasoning-effort 枚举，都不依赖 loopx / gh 是否可用。把它们放在 dispatch 能力门
# 之前，避免 CI 无 loopx 时能力探针 UNKNOWN 掩盖真正的参数诊断（ADR-0015 决策 4）。
# 命令实现内的同名校验保留为纵深防御，判据与文案以 review_parse_local_args 为唯一实现。
if [[ "${1:-}" != "--help" && "${1:-}" != "-h" ]]; then
    case "$ACTION" in
        feature|start)
            if [[ -z "${1:-}" ]]; then
                echo -e "${RED}[-] 错误: 请指定特性名称，例如: loopx-flow feature user-auth${NC}" >&2
                exit 1
            fi
            ;;
        review) review_parse_local_args "$@" || exit 1 ;;
        merge)
            if [[ -z "${1:-}" ]]; then
                echo -e "${RED}[-] 错误: 请指定 PR 编号，例如: loopx-flow merge 12${NC}" >&2
                exit 1
            fi
            ;;
        release-approve)
            if [[ -z "${1:-}" ]]; then
                echo -e "${RED}[-] 错误: 请指定 PR 编号，例如: loopx-flow release-approve 12${NC}" >&2
                exit 1
            fi
            ;;
        pr)
            if [[ -z "${1:-}" ]]; then
                echo -e "${RED}[-] 错误: 请指定 PR 创建参数，例如: loopx-flow pr <feature>${NC}" >&2
                exit 1
            fi
            ;;
    esac
fi

# 能力门（单一入口，review #73 P0）：feature / check / pr / review / merge / release-approve
# 六条 L0 命令在 dispatch 边界统一执行一次 BLOCK 能力探针，BLOCK/UNKNOWN 时在**任何**
# 不可逆动作（gh pr merge、git 写、loopx 写）之前非 0 退出并输出升级差异诊断卡。
# 命令实现内不再各自重复这道门；--help/-h 与无参调用放行（只打印用法，无副作用）。
if cap_scope="$(dispatch_capability_scope "$ACTION")"; then
    if [[ "${1:-}" != "--help" && "${1:-}" != "-h" ]]; then
        require_loopx_capabilities "$cap_scope" || {
            echo -e "${RED}[-] [FAIL-CLOSED] LoopX 能力探针未通过（scope=${cap_scope}），$ACTION 命令在第一个不可逆动作之前已阻断。${NC}" >&2
            exit 1
        }
    fi
fi

# D1 全量命令分类矩阵：仅需要 LoopX 权威状态的命令入口 fail-closed 校验 registry（含附属 worktree）。
case "$ACTION" in
    approve|check|merge|issue|integrate|todo)
        if [[ "${1:-}" != "--help" && "${1:-}" != "-h" ]]; then
            wf_require_registry
        fi
        ;;
esac

case "$ACTION" in
    feature|start) cmd_feature "$@" ;;
    approve) cmd_approve "$@" ;;
    check) cmd_check "$@" ;;
    pr) cmd_pr "$@" ;;
    review) cmd_review "$@" ;;
    respond) cmd_respond "$@" ;;
    merge) cmd_merge "$@" ;;
    release-approve) cmd_release_approve "$@" ;;
    gate) cmd_gate "$@" ;;
    context) cmd_context "$@" ;;
    archive) cmd_archive "$@" ;;
    issue) cmd_issue "$@" ;;
    integrate) cmd_integrate "$@" ;;
    doctor) cmd_doctor "$@" ;;
    capabilities) probe_loopx_capabilities "$@" ;;
    gc) cmd_gc "$@" ;;
    init) cmd_init "$@" ;;
    status)
        if [[ "${1:-}" == "--next" ]]; then shift; cmd_status_next "${1:-}"; else cmd_status "$@"; fi ;;
    todo) cmd_todo "$@" ;;
    help|--help|-h) usage ;;
    *)
        echo -e "${RED}[-] 未知命令: $ACTION${NC}\n" >&2
        usage
        exit 1
        ;;
esac
