#!/usr/bin/env bash
# ==============================================================================
# pre-commit: Git 提交守卫钩子
# 严禁直接向 main / master 分支提交代码，强制要求在特性分支开发并通过 PR 审查合入
# ==============================================================================
set -euo pipefail

CURRENT_BRANCH="${TEST_GIT_BRANCH:-$(git branch --show-current 2>/dev/null || echo "")}"

if [[ "$CURRENT_BRANCH" == "main" || "$CURRENT_BRANCH" == "master" ]]; then
    echo -e "\033[0;31m======================================================================\033[0m" >&2
    echo -e "\033[0;31m[!] 阻断拦截: 严禁直接向 $CURRENT_BRANCH 分支提交代码！\033[0m" >&2
    echo -e "\033[0;31m======================================================================\033[0m" >&2
    echo -e "依据 LoopX AI-Native 研发质量协议，所有变更必须走 PR 交付通道:" >&2
    echo -e "  1. 检出特性分支:  git checkout -b feature/<feature-name>" >&2
    echo -e "  2. 本地验证并通过四大硬门禁: bin/loopx-flow check" >&2
    echo -e "  3. 创建 GitHub PR 并通过人类 8 项事实核验审核" >&2
    echo -e "  4. 最终由 loopx-flow merge 原子合入并归档 Goal" >&2
    echo -e "\033[0;33m[!] 提交已被拒绝 (Exit Code 1)。\033[0m\n" >&2
    exit 1
fi

# ------------------------------------------------------------------------------
# 防复发守卫 (ADR-0007 / R3 / R20)：物理拦截暂存区中的私有运行态、凭据与本机绝对路径
# ------------------------------------------------------------------------------
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
if [[ -n "$STAGED_FILES" ]]; then
    FORBIDDEN_PATHS="$(printf '%s\n' "$STAGED_FILES" | grep -E '^(\.loopx/|\.codex/|qa-acceptance/)' || true)"
    if [[ -n "$FORBIDDEN_PATHS" ]]; then
        echo -e "\033[0;31m[!] [FAIL-CLOSED] 禁止提交私有运行态/验收残留目录 (.loopx/ .codex/ qa-acceptance/):\033[0m" >&2
        printf '%s\n' "$FORBIDDEN_PATHS" | sed 's/^/    - /' >&2
        echo -e "    修复: git reset HEAD -- <path>" >&2
        exit 1
    fi

    # 扫描暂存区新增行中的飞书凭据形态与本机绝对路径（排除守卫脚本与测试自身正则定义）
    STAGED_DIFF="$(git diff --cached -U0 -- . ':!scripts/check-invariants.js' ':!scripts/git-hooks/pre-commit' ':!tests/' 2>/dev/null || true)"
    LEAKED_LINES="$(printf '%s\n' "$STAGED_DIFF" | grep -E '^\+[^+]' | grep -E '(oc_[0-9a-f]{32}|ou_[0-9a-f]{32}|cli_[0-9a-f]{16}|"app_secret"[[:space:]]*:[[:space:]]*"[^"*<]{8,}|/Users/[A-Za-z0-9_.-]+/|/home/[A-Za-z0-9_.-]+/)' | head -5 || true)"
    if [[ -n "$LEAKED_LINES" ]]; then
        echo -e "\033[0;31m[!] [FAIL-CLOSED] 暂存区检测到疑似飞书凭据/ID 或本机绝对路径，提交已被拦截:\033[0m" >&2
        printf '%s\n' "$LEAKED_LINES" | sed 's/^/    /' >&2
        echo -e "    修复: 替换为 ** 或 <repo-root>/<loopx-runtime-root> 占位符后重试。" >&2
        exit 1
    fi
fi

exit 0
